#!/usr/bin/env bash
# Pair Polymath CLI — v0.2: status, version, doctor, enable/disable, logs,
# cost, update, self-test.

set -u
# v0.4.2 privacy fix: every cache + user.env write inherits 0600.
umask 077

PP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PP_ROOT/lib/config.sh"
# shellcheck disable=SC1091
. "$PP_ROOT/lib/budget.sh"

# Detect GNU vs BSD stat ONCE, upfront (review fix F7' + R4-4).
# Round-1 F7 used a fallback chain `stat -f %m FILE || stat -c %Y FILE`. The
# problem: on GNU/Linux `stat -f %m FILE` does NOT fail — `-f` means
# "filesystem mode" and `%m` is the mount point string (e.g. `/`). That
# string then went to `date -r STRING` which GNU's `date -r FILE` happily
# accepts as a filename, yielding the MOUNT POINT'S mtime as every log
# entry's timestamp. Format-valid but value-wrong; tests that asserted only
# format passed. Explicit detection avoids the trap.
#
# Round-4 R4-4: previous version probed with `stat --version | grep -qE
# 'GNU|coreutils'`. That returns FALSE on BusyBox / Alpine even though
# BusyBox's `stat` supports `-c %Y` (GNU-style flag for compat). Then we
# fell through to the BSD branch `stat -f %m`, which BusyBox doesn't
# implement → every timestamp resolved to '?'. Probe by trying the flag
# itself: this works correctly on GNU stat AND BusyBox AND OpenBSD AND
# macOS BSD.
if stat -c %Y /dev/null >/dev/null 2>&1; then
  _PP_STAT_FLAVOR=gnu
elif stat -f %m /dev/null >/dev/null 2>&1; then
  _PP_STAT_FLAVOR=bsd
else
  _PP_STAT_FLAVOR=unknown
fi

# _pp_set_user_env_var KEY VALUE
# Atomically set KEY=VALUE in $CLAUDE_DIR/pair-polymath/config/user.env,
# preserving every other line. Symlink-aware (writes through to the link
# target so dotfile-managed configs aren't replaced with regular files).
# Fails loudly on real grep / mkdir errors (review fixes H1+H2+M1+M2).
# Returns 0 on success, 1 on any error (with stderr message).
_pp_set_user_env_var() {
  local key="$1" value="$2"
  local user_env="${CLAUDE_DIR:-$HOME/.claude}/pair-polymath/config/user.env"
  local cfg_dir
  cfg_dir="$(dirname "$user_env")"

  # Fail loudly if we cannot create the config dir (review fix M2)
  if ! mkdir -p "$cfg_dir" 2>/dev/null; then
    printf 'polymath: cannot create config dir %s\n' "$cfg_dir" >&2
    return 1
  fi

  [ -f "$user_env" ] || : > "$user_env"

  # Create tmp in the SAME directory so the eventual mv stays atomic within
  # the same filesystem (review fix H2). Cross-FS mv is a copy + delete with
  # a race window.
  local tmp
  tmp=$(mktemp "${user_env}.XXXXXX") || {
    printf 'polymath: mktemp failed\n' >&2
    return 1
  }

  # Strip any existing KEY=... line. grep exit semantics with `-v`:
  #   0 = at least one line did NOT match (kept) → normal
  #   1 = no lines did NOT match (file empty after filter) → also normal
  #   2+ = real read error → must not proceed (review fix H1: previously we
  #        would silently truncate user.env to just our new line)
  local grep_rc=0
  grep -v "^${key}=" "$user_env" > "$tmp" || grep_rc=$?
  case "$grep_rc" in
    0|1) ;;
    *)
      rm -f "$tmp"
      printf 'polymath: failed to read %s (grep exit %s); user.env left intact\n' "$user_env" "$grep_rc" >&2
      return 1
      ;;
  esac

  printf '%s=%s\n' "$key" "$value" >> "$tmp"

  # Symlink-preserving write: if user_env is a symlink (e.g. dotfile manager
  # mapped it elsewhere), write THROUGH the link to the real target.
  # Otherwise atomic rename within the same filesystem (review fix M1).
  if [ -L "$user_env" ]; then
    if ! cat "$tmp" > "$user_env"; then
      rm -f "$tmp"
      printf 'polymath: could not write through symlink %s\n' "$user_env" >&2
      return 1
    fi
    rm -f "$tmp"
  else
    if ! mv "$tmp" "$user_env"; then
      rm -f "$tmp"
      printf 'polymath: could not move tmp into place at %s\n' "$user_env" >&2
      return 1
    fi
  fi
  return 0
}

cmd="${1:-status}"

case "$cmd" in
  version|-v|--version)
    cat "$PP_ROOT/VERSION"
    ;;

  status)
    today_calls=$(budget_get)
    # v0.4.3: was `:-3500` here while lib/budget.sh pressure used :-10000
    # and config/default.env shipped 10000 — three sources, one truth.
    # Now sourced from lib/budget.sh's `: "${PP_MAX_DAILY_CALLS:=10000}"`
    # which fires on `lib/budget.sh` source at bin/polymath:13.
    cap="$PP_MAX_DAILY_CALLS"
    used_pct=0
    if [ "$cap" -gt 0 ]; then
      used_pct=$((today_calls * 100 / cap))
    fi

    # v0.4.1 review-fix (I5): surface budget pressure with the same
    # thresholds + glyph language as the statusline pip so a user
    # invoking `polymath status` sees the same warn/red signal that
    # appears in their chrome. Reuses the canonical helper.
    pressure_pct=$(pp_budget_remaining_pct 2>/dev/null)
    case "$pressure_pct" in ''|*[!0-9]*) pressure_pct=100 ;; esac
    pressure_warn="${PP_BUDGET_WARN_PCT:-80}"
    pressure_red="${PP_BUDGET_RED_PCT:-95}"
    case "$pressure_warn" in ''|*[!0-9]*) pressure_warn=80 ;; esac
    case "$pressure_red"  in ''|*[!0-9]*) pressure_red=95  ;; esac
    # v0.4.3 cumulative-review fix: backport the 4-step clamp ladder
    # from bin/statusline.sh:273-289 + lib/doctor.sh:363-374 so all
    # three budget-pressure surfaces speak the same numbers under
    # misconfig. Missing here previously: lower-bound (WARN=0 would
    # render permanent yellow) + inversion-reset (WARN >= RED would
    # silently skip yellow and go straight to red).
    [ "$pressure_warn" -gt 100 ] && pressure_warn=80
    [ "$pressure_red"  -gt 100 ] && pressure_red=95
    [ "$pressure_warn" -lt 1 ] && pressure_warn=80
    [ "$pressure_red"  -lt 1 ] && pressure_red=95
    if [ "$pressure_warn" -ge "$pressure_red" ]; then
      pressure_warn=80
      pressure_red=95
    fi
    pressure_used=$((100 - pressure_pct))
    if [ "$pressure_used" -ge "$pressure_red" ]; then
      pressure_glyph=$(printf '\033[31m⚠ RED\033[0m')
    elif [ "$pressure_used" -ge "$pressure_warn" ]; then
      pressure_glyph=$(printf '\033[33m⚡ YELLOW\033[0m')
    else
      pressure_glyph=$(printf '\033[32m✓ GREEN\033[0m')
    fi

    printf '\n\033[1mPair Polymath status\033[0m\n'
    printf '  Plugin root:     %s\n' "$PP_ROOT"
    printf '  Version:         %s\n' "$(cat "$PP_ROOT/VERSION")"
    printf '  Today (%s)\n' "$(date +%Y-%m-%d)"
    printf '    Calls:         %s / %s (%s%%)\n' "$today_calls" "$cap" "$used_pct"
    printf '    Budget:        %s (%s%% remaining)\n' "$pressure_glyph" "$pressure_pct"

    # Lens registry summary
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/lens-loader.sh"
    if pp_load_lenses 2>/dev/null; then
      printf '  Lenses loaded:   %s\n' "$PP_LENS_COUNT"
      for i in $(seq 0 $((PP_LENS_COUNT - 1))); do
        printf '    [%s] %s\n' "$((i + 1))" "${PP_LENS_IDS[$i]}"
      done
    fi

    # Prompts present?
    prompt_count=$(find "$PP_ROOT/prompts" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    printf '  Prompts:         %s built-in\n' "$prompt_count"

    # Honor $CLAUDE_DIR like install/uninstall do (review fix L1)
    user_prompts=$(find "${CLAUDE_DIR:-$HOME/.claude}/pair-polymath/prompts" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    [ "$user_prompts" -gt 0 ] && printf '    +%s user overrides\n' "$user_prompts"

    # Feature flags
    printf '  External LLM:    %s\n' "${PP_EXTERNAL_LLM:-1}"
    printf '  Escalation:      %s\n' "${PP_ENABLE_ESCALATION:-1}"

    # Privacy log (P3.3) — surface its existence + recency so users can find it.
    # Uses the same stat-flavor detection as the rest of the script so the
    # mtime read is portable across GNU/BSD/BusyBox.
    _pp_privacy_log="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/last-cycle-payload.json"
    if [ -f "$_pp_privacy_log" ]; then
      _pp_pl_mtime=0
      case "$_PP_STAT_FLAVOR" in
        gnu) _pp_pl_mtime=$(stat -c %Y "$_pp_privacy_log" 2>/dev/null || echo 0) ;;
        bsd) _pp_pl_mtime=$(stat -f %m "$_pp_privacy_log" 2>/dev/null || echo 0) ;;
      esac
      _pp_pl_age_s=$(( $(date +%s) - _pp_pl_mtime ))
      if [ "$_pp_pl_age_s" -lt 0 ]; then _pp_pl_age_s=0; fi
      if [ "$_pp_pl_age_s" -lt 3600 ]; then
        _pp_pl_age="${_pp_pl_age_s}s ago"
      else
        _pp_pl_age="$((_pp_pl_age_s/60))min ago"
      fi
      printf '  Privacy log:     %s (%s)\n' "$_pp_privacy_log" "$_pp_pl_age"
    fi

    printf '\n'
    ;;

  doctor)
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/doctor.sh"
    pp_doctor_run "$@"
    ;;

  cache)
    # v0.4.2: cache hygiene subcommands.
    #   cache clear         — wipe ALL lens caches + tip caches + injection idempotency files
    #   cache clear --tips  — wipe only the tip caches (per-project)
    #   cache clear --orphans — wipe only orphaned-session lens caches (not the current one)
    #   cache list          — show what's there with mode + size + age
    shift
    _pp_cache_sub="${1:-list}"
    _pp_cache_dir="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}"
    case "$_pp_cache_sub" in
      list)
        # shellcheck disable=SC1091
        . "$PP_ROOT/lib/grounding.sh"
        printf '\n\033[1mPair Polymath cache (%s)\033[0m\n' "$_pp_cache_dir"
        if [ ! -d "$_pp_cache_dir" ]; then
          printf '  (empty / never run)\n\n'
          exit 0
        fi
        _pp_cache_dir_mode=$(pp_file_mode "$_pp_cache_dir")
        [ -z "$_pp_cache_dir_mode" ] && _pp_cache_dir_mode="?"
        printf '  Dir mode: %s (target: 700)\n' "$_pp_cache_dir_mode"
        _pp_cache_total=$(find "$_pp_cache_dir" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')
        _pp_cache_tips=$(find "$_pp_cache_dir" -maxdepth 1 -name 'cc-tips*' -type f 2>/dev/null | wc -l | tr -d ' ')
        # Review G9: exclude budget files from the lens count; they're
        # date-stamped daily-cap accounting, not lens observations.
        _pp_cache_lens=$(find "$_pp_cache_dir" -maxdepth 1 -name 'cc-monitor-*' ! -name 'cc-monitor-budget-*' -type f 2>/dev/null | wc -l | tr -d ' ')
        _pp_cache_budget=$(find "$_pp_cache_dir" -maxdepth 1 -name 'cc-monitor-budget-*' -type f 2>/dev/null | wc -l | tr -d ' ')
        _pp_cache_loose=$(find "$_pp_cache_dir" -maxdepth 1 -type f ! -perm 600 2>/dev/null | wc -l | tr -d ' ')
        printf '  Files:    %s total (%s tips, %s lens/hook, %s budget)\n' "$_pp_cache_total" "$_pp_cache_tips" "$_pp_cache_lens" "$_pp_cache_budget"
        if [ "$_pp_cache_loose" -gt 0 ]; then
          printf '  \033[33m! %s files with mode != 600 (run `polymath cache clear` to remediate)\033[0m\n' "$_pp_cache_loose"
        fi
        printf '\n'
        ;;
      clear)
        shift
        _pp_clear_what="${1:-all}"
        case "$_pp_clear_what" in
          --tips)
            find "$_pp_cache_dir" -maxdepth 1 -name 'cc-tips*' -type f -exec rm -f {} \; 2>/dev/null
            printf 'polymath: cleared tip caches in %s\n' "$_pp_cache_dir"
            ;;
          --orphans)
            # Tricky: there's no "current session" notion outside Claude Code,
            # so wipe stale files. v0.4.3 cumulative-review fix (P1-3): the
            # prior `-mtime +1` was claimed "older than 24h" but POSIX
            # truncation makes it match files at least ~48h old. Use a
            # marker file as the cutoff: portably means "older than exactly
            # 24 hours" on both BSD (date -v) and GNU (date -d).
            _pp_orphan_marker=$(mktemp -t pp-orphan-cutoff-XXXXXX) || _pp_orphan_marker=""
            if [ -n "$_pp_orphan_marker" ]; then
              # Try BSD-style first then GNU; if both fail, fall back to
              # the original -mtime +1 (>48h) semantics with a tighter
              # message so we don't lie.
              if touch -t "$(date -v -1d +%Y%m%d%H%M.%S 2>/dev/null)" "$_pp_orphan_marker" 2>/dev/null \
                || touch -d '1 day ago' "$_pp_orphan_marker" 2>/dev/null; then
                # Include legacy cc-tips.txt (no project key) in the sweep.
                find "$_pp_cache_dir" -maxdepth 1 \
                  \( -name 'cc-monitor-*.txt' -o -name 'cc-tips-*.txt' -o -name 'cc-tips.txt' \
                     -o -name 'cc-monitor-injected-hash-*' -o -name 'cc-monitor-injected-time-*' \) \
                  -type f ! -name 'cc-monitor-budget-*' \
                  ! -newer "$_pp_orphan_marker" -exec rm -f {} \; 2>/dev/null
                rm -f "$_pp_orphan_marker"
                printf 'polymath: cleared orphan caches (mtime >24h) in %s\n' "$_pp_cache_dir"
              else
                rm -f "$_pp_orphan_marker"
                find "$_pp_cache_dir" -maxdepth 1 \
                  \( -name 'cc-monitor-*.txt' -o -name 'cc-tips-*.txt' -o -name 'cc-tips.txt' \
                     -o -name 'cc-monitor-injected-hash-*' -o -name 'cc-monitor-injected-time-*' \) \
                  -type f ! -name 'cc-monitor-budget-*' \
                  -mtime +1 -exec rm -f {} \; 2>/dev/null
                printf 'polymath: cleared orphan caches (no portable 24h date support; using ~48h fallback) in %s\n' "$_pp_cache_dir"
              fi
            fi
            ;;
          all|"")
            # Preserve budget files (date-stamped, inert, needed for daily cap).
            # v0.4.3 cumulative-review fixes:
            #   - GPT-3: chmod 600 the preserved budget files so doctor #17
            #     doesn't stay yellow forever after `cache clear` (legacy
            #     pre-v0.4.2 budget files were created at 644).
            #   - GPT-4: also sweep the per-lens idempotency hash/time files
            #     so injection suppression state doesn't outlive the lens
            #     observations that produced it.
            find "$_pp_cache_dir" -maxdepth 1 \
              \( -name 'cc-monitor-*.txt' -o -name 'cc-tips*' \) \
              -type f ! -name 'cc-monitor-budget-*' -exec rm -f {} \; 2>/dev/null
            find "$_pp_cache_dir" -maxdepth 1 \
              \( -name 'cc-monitor-injected-hash-*' -o -name 'cc-monitor-injected-time-*' \) \
              -type f -exec rm -f {} \; 2>/dev/null
            # Chmod surviving budget files to the privacy invariant.
            find "$_pp_cache_dir" -maxdepth 1 -name 'cc-monitor-budget-*' -type f -exec chmod 600 {} \; 2>/dev/null
            chmod 700 "$_pp_cache_dir" 2>/dev/null || true
            printf 'polymath: cleared lens + tip + idempotency caches in %s (budget files preserved and locked to 600)\n' "$_pp_cache_dir"
            ;;
          *)
            printf 'polymath cache clear: unknown flag %s (use --tips | --orphans | all)\n' "$_pp_clear_what" >&2
            exit 2
            ;;
        esac
        ;;
      *)
        printf 'polymath cache: unknown subcommand %s (use list | clear)\n' "$_pp_cache_sub" >&2
        exit 2
        ;;
    esac
    ;;

  dismiss)
    # v0.5 Phase 3: suppression rules + memory-as-constraint.
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/dismiss.sh"
    shift
    _pp_dismiss_sub="${1:-help}"
    case "$_pp_dismiss_sub" in
      help|-h|--help|"")
        cat <<'USAGE'
Usage: polymath dismiss <command> [args]

Commands:
  polymath dismiss "<reason>" [scope=project|global]   add a rule
  polymath dismiss list                                 show active rules
  polymath dismiss show <id>                            print JSON for id
  polymath dismiss disable <id>                         soft-delete
  polymath dismiss enable <id>                          un-delete
  polymath dismiss ack <hash-prefix>                    affirm observation is useful
USAGE
        [ -z "${1:-}" ] && exit 2 || exit 0
        ;;
      list)
        pp_dismiss_list
        ;;
      show)
        [ -n "${2:-}" ] || { printf 'polymath dismiss show: id required\n' >&2; exit 2; }
        pp_dismiss_show "$2"
        ;;
      disable)
        [ -n "${2:-}" ] || { printf 'polymath dismiss disable: id required\n' >&2; exit 2; }
        pp_dismiss_disable "$2" "user_disabled"
        ;;
      enable)
        [ -n "${2:-}" ] || { printf 'polymath dismiss enable: id required\n' >&2; exit 2; }
        pp_dismiss_enable "$2"
        ;;
      ack)
        [ -n "${2:-}" ] || { printf 'polymath dismiss ack: hash-prefix required\n' >&2; exit 2; }
        pp_dismiss_ack "$2"
        ;;
      *)
        # Treat as a reason text (the most common case).
        _id=$(pp_dismiss_add "$_pp_dismiss_sub" "${2:-project}")
        printf '%s\n' "$_id"
        ;;
    esac
    ;;

  disable)
    _pp_set_user_env_var PP_EXTERNAL_LLM 0 || exit 1
    printf 'LLM cycle disabled. Status-only mode active; new cycles take effect within 5 min.\n'
    ;;

  enable)
    _pp_set_user_env_var PP_EXTERNAL_LLM 1 || exit 1
    printf 'LLM cycle enabled. New cycles take effect within 5 min.\n'
    ;;

  logs)
    shift
    _pp_logs_n=10
    _pp_logs_lens=""
    _pp_logs_follow=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -n)
          # Review fix F3: validate value EXISTS before shift, otherwise
          # `shift 2` on a 1-arg list returns non-zero, the loop re-matches
          # $1=-n on the next iteration, and we spin forever.
          [ -n "${2:-}" ] || { printf 'polymath logs: -n requires a value\n' >&2; exit 2; }
          _pp_logs_n="$2"
          shift 2
          ;;
        --lens)
          [ -n "${2:-}" ] || { printf 'polymath logs: --lens requires a value\n' >&2; exit 2; }
          _pp_logs_lens="$2"
          shift 2
          ;;
        --follow|-f) _pp_logs_follow=1; shift ;;
        -h|--help)
          cat <<HELP
polymath logs — tail recent lens observations

Usage:
  polymath logs                Last 10 observations across all lenses
  polymath logs -n 50          Last 50 observations
  polymath logs --lens ENGINEERING
                               Filter to one lens by id
  polymath logs --follow       Stream new observations as cycles complete

Observations live in \$CLAUDE_DIR/cache/cc-monitor-\$SESSION-\$LENS.txt
HELP
          exit 0
          ;;
        *) printf 'polymath logs: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # Validate + cap -n. Round-4 R4-8: previous validator allowed 0 even
    # though the error message claimed "positive integer". Explicit `< 1`
    # check after the digit validator.
    case "$_pp_logs_n" in
      ''|*[!0-9]*) printf 'polymath logs: -n requires a positive integer\n' >&2; exit 2 ;;
    esac
    [ "$_pp_logs_n" -lt 1 ] && { printf 'polymath logs: -n must be >= 1\n' >&2; exit 2; }
    [ "$_pp_logs_n" -gt 200 ] && _pp_logs_n=200

    _pp_cache_dir="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}"
    [ -d "$_pp_cache_dir" ] || { printf 'polymath logs: cache dir does not exist (%s); no observations yet\n' "$_pp_cache_dir"; exit 0; }

    # Determine session_id
    _pp_logs_session="${PP_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
    if [ -z "$_pp_logs_session" ]; then
      # Review fix F1: previous `([^-]+)` truncated multi-dash session IDs
      # (e.g. `abc-def-ghi` extracted to just `abc`). Use a greedy `(.+)` with
      # the trailing lens-id anchor `[A-Za-z0-9_]+\.txt$` as the boundary so
      # the longest possible session-id matches up to the final dash.
      # Review fix F5: also skip -verdict/-streak sidecars when sniffing the
      # session — they share the same glob but have different content.
      # SC2010: ls + grep is the cleanest expression here; mtime ordering is
      # provided by `ls -t` and filenames are constrained (no embedded
      # newlines/spaces — we author them in this same script).
      # shellcheck disable=SC2010
      _pp_logs_session=$(ls -t "$_pp_cache_dir"/cc-monitor-*-*.txt 2>/dev/null \
        | grep -v -- '-verdict\.txt$' \
        | grep -v -- '-streak\.txt$' \
        | head -1 \
        | sed -nE 's@.*/cc-monitor-(.+)-[A-Za-z0-9_]+\.txt$@\1@p')
    fi
    if [ -z "$_pp_logs_session" ]; then
      printf 'polymath logs: no observations yet (run a session to produce them)\n'
      exit 0
    fi

    # Review fix F7' (round 3): explicit flavor-driven mtime resolution. The
    # round-1 fallback chain `stat -f %m FILE || stat -c %Y FILE` silently
    # produced WRONG values on GNU/Linux because `stat -f %m FILE` doesn't
    # fail there — `-f` means "filesystem mode" and `%m` returns the mount
    # point string, which GNU `date -r FILE` then happily treats as a
    # filename. _PP_STAT_FLAVOR is detected once upfront (top of file).
    _pp_logs_get_mtime() {
      local f="$1"
      local secs
      case "$_PP_STAT_FLAVOR" in
        gnu)
          secs=$(stat -c %Y "$f" 2>/dev/null) || { printf '?'; return; }
          date -d "@$secs" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '?'
          ;;
        bsd)
          secs=$(stat -f %m "$f" 2>/dev/null) || { printf '?'; return; }
          date -r "$secs" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '?'
          ;;
        *)
          printf '?'
          ;;
      esac
    }

    _pp_logs_print_one() {
      local file="$1"
      [ -s "$file" ] || return 0
      local lens_id
      # Review fix F2: previous `([A-Z_]+)` rejected lens IDs with digits or
      # lowercase (LENS1, engineering_v2). Broaden to [A-Za-z0-9_]+.
      # Round-3 G4: --lens filtering moved OUT of this function and into the
      # file-list build step, so head -n no longer drops lens-matching files.
      lens_id=$(printf '%s' "$file" | sed -nE 's@.*-([A-Za-z0-9_]+)\.txt$@\1@p')
      local raw
      raw=$(head -1 "$file" 2>/dev/null)
      [ -z "$raw" ] && return 0
      # Parse "HAT: hook|||body" — hook is before |||, body after
      local hook body
      hook="${raw%%|||*}"
      body="${raw#*|||}"
      # Timestamp from file mtime (portable BSD/GNU; review fix F7)
      local ts
      ts=$(_pp_logs_get_mtime "$file")
      printf '%s  %s\n  %s\n  %s\n' "$ts" "$lens_id" "$hook" "$body"
      # Verdict sidecar — print only if present and contains DROP
      local verdict_file="${file%.txt}-verdict.txt"
      if [ -f "$verdict_file" ]; then
        local v
        v=$(head -1 "$verdict_file")
        case "$v" in
          *DROP*) printf '  [DROP: %s]\n' "$v" ;;
        esac
      fi
      printf '\n'
    }

    if [ "$_pp_logs_follow" = "1" ]; then
      # Review fix G3 (round 3): --follow was previously tailing the newest
      # single cache file regardless of --lens, diverging from non-follow
      # mode's filter behavior. When --lens is set, tail ONLY that lens's
      # specific cache file. Refuse gracefully if no file yet exists.
      if [ -n "$_pp_logs_lens" ]; then
        target="$_pp_cache_dir/cc-monitor-$_pp_logs_session-$_pp_logs_lens.txt"
        if [ ! -f "$target" ]; then
          printf 'polymath logs --follow: no cache file yet for lens %s (session %s)\n' \
            "$_pp_logs_lens" "$_pp_logs_session"
          exit 0
        fi
        # Round-4 R4-7: printf format strings starting with '-' parse as flags
        # on some shells. Prefix '--' so '--follow on lens ...' is treated as
        # format, not option.
        printf -- '--follow on lens %s (Ctrl-C to exit)\n\n' "$_pp_logs_lens"
        tail -F "$target" 2>/dev/null
        exit 0
      fi
      # Round-4 R4-5: --follow without --lens used to tail only the NEWEST
      # single cache file for the session — if a different lens wrote mid-
      # session, the user silently saw nothing. Now tail ALL existing lens
      # files for this session. tail -F accepts multiple files. Caveat: a
      # lens whose cache file is CREATED after the --follow starts won't be
      # auto-watched; v0.3 may use inotify/fswatch for fully-dynamic follow.
      printf 'polymath logs --follow: waiting for new observations (Ctrl-C to exit)\n\n'
      # Review fix F5: filter -verdict/-streak sidecars so tail -F doesn't
      # latch onto a verdict file (different format, not observations).
      # shellcheck disable=SC2010
      _pp_follow_files=$(ls -t "$_pp_cache_dir"/cc-monitor-"$_pp_logs_session"-*.txt 2>/dev/null \
        | grep -v -- '-verdict\.txt$' \
        | grep -v -- '-streak\.txt$')
      if [ -z "$_pp_follow_files" ]; then
        printf 'polymath logs --follow: no observations yet for session %s\n' "$_pp_logs_session"
        exit 0
      fi
      printf -- '--follow on session %s (Ctrl-C to exit)\n\n' "$_pp_logs_session"
      # shellcheck disable=SC2086  # intentional word-splitting of file list
      tail -F $_pp_follow_files 2>/dev/null
      exit 0
    fi

    # Default mode: collect candidate files, filter --lens FIRST, then head -n.
    # Review fix G4 (round 3): previously `head -n` ran BEFORE the --lens
    # filter, so `polymath logs --lens X -n N` could yield zero results if
    # X's cache files weren't among the newest N. Now filter then head.
    # Review fix F5: also strip -verdict.txt / -streak.txt sidecars — the
    # glob matches them but they have different content shape and would
    # render as garbled "observations".
    _pp_logs_tmp=$(mktemp)
    # shellcheck disable=SC2010
    ls -t "$_pp_cache_dir"/cc-monitor-"$_pp_logs_session"-*.txt 2>/dev/null \
      | grep -v -- '-verdict\.txt$' \
      | grep -v -- '-streak\.txt$' \
      > "$_pp_logs_tmp"

    # Pre-filter by --lens before applying head -n (G4).
    if [ -n "$_pp_logs_lens" ]; then
      _pp_logs_tmp2=$(mktemp)
      grep -F -- "-$_pp_logs_lens.txt" < "$_pp_logs_tmp" > "$_pp_logs_tmp2" || true
      mv "$_pp_logs_tmp2" "$_pp_logs_tmp"
    fi

    # Now cap to -n.
    _pp_logs_tmp3=$(mktemp)
    head -n "$_pp_logs_n" < "$_pp_logs_tmp" > "$_pp_logs_tmp3"
    mv "$_pp_logs_tmp3" "$_pp_logs_tmp"

    if [ ! -s "$_pp_logs_tmp" ]; then
      if [ -n "$_pp_logs_lens" ]; then
        printf 'polymath logs: no observations for lens %s in session %s\n' \
          "$_pp_logs_lens" "$_pp_logs_session"
      else
        printf 'polymath logs: no observations for session %s yet\n' "$_pp_logs_session"
      fi
      rm -f "$_pp_logs_tmp"
      exit 0
    fi
    while IFS= read -r f; do
      _pp_logs_print_one "$f"
    done < "$_pp_logs_tmp"
    rm -f "$_pp_logs_tmp"
    ;;

  update)
    shift
    _pp_update_yes=0
    _pp_update_dry=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --yes|-y) _pp_update_yes=1; shift ;;
        --dry-run) _pp_update_dry=1; shift ;;
        -h|--help)
          cat <<HELP
polymath update — Pull latest + re-run installer (idempotent)

Usage:
  polymath update              Interactive: shows diff, asks confirm, pulls,
                               re-runs bin/install.sh.
  polymath update --yes        Non-interactive: fetch + ff-only pull. Skips
                               install.sh; prints loud warning if pull touched
                               installer or hooks (re-run bin/install.sh
                               manually in that case).
  polymath update --dry-run    Show what would happen; make no changes.

Honors the current branch's configured upstream (\`@{upstream}\`); falls back
to origin/<default-branch> only when no upstream is set. Refuses to proceed
when the working tree has uncommitted changes (real path).
HELP
          exit 0
          ;;
        *) printf 'polymath update: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # `.git` may be a directory (normal checkout) OR a file (linked worktree).
    # Both are valid git checkouts. Test the rev-parse path instead.
    if ! git -C "$PP_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      printf 'polymath update: PP_ROOT (%s) is not a git checkout — manual update needed\n' "$PP_ROOT" >&2
      exit 1
    fi

    # Review fix F6: detect the upstream default branch instead of hardcoding
    # `main`. Forks / branch-tracking installs were silently broken.
    _pp_default_branch=$(git -C "$PP_ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
    _pp_default_branch="${_pp_default_branch:-main}"

    # Round-4 R4-2: respect @{upstream} when configured. Previously we always
    # pulled origin/<default-branch>, which is wrong on forks / release
    # branches / feature branches where the user's branch tracks something
    # other than origin/main. Falling back to origin/<default-branch> only
    # when no upstream is set keeps the legacy contract for plain installs.
    # Detached HEAD: no current branch, no upstream — only safe move is to
    # query origin/<default-branch> for dry-run (read-only). A real pull
    # against detached HEAD would be a separate problem we surface later.
    _pp_current_branch=$(git -C "$PP_ROOT" symbolic-ref --short HEAD 2>/dev/null) || _pp_current_branch=""
    _pp_upstream=""
    if [ -n "$_pp_current_branch" ]; then
      _pp_upstream=$(git -C "$PP_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || _pp_upstream=""
    fi
    if [ -n "$_pp_upstream" ]; then
      _pp_compare_ref="$_pp_upstream"
    else
      # No upstream (either detached HEAD, or branch with no tracking config).
      # Fall back to origin/<default-branch>.
      _pp_compare_ref="origin/$_pp_default_branch"
    fi
    # `git pull` takes a refspec without the `origin/` prefix.
    _pp_pull_branch="${_pp_compare_ref#origin/}"

    # Review fix F8: dry-run must NOT mutate `.git/` state. `git fetch` writes
    # FETCH_HEAD and updates remote-tracking refs, which breaks the "no
    # changes" contract. Use `git ls-remote` (read-only) instead.
    if [ "$_pp_update_dry" = "1" ]; then
      # Round-4 R4-3 (dry-run variant): if the working tree is dirty, mention
      # that the real path would refuse — but don't exit nonzero (dry-run
      # promises no filesystem change, including exit-code surprises).
      if [ -n "$(git -C "$PP_ROOT" status --porcelain 2>/dev/null)" ]; then
        printf '[dry-run] Working tree has uncommitted changes; a real update would refuse.\n'
        printf '[dry-run] Stash or commit before running without --dry-run.\n'
        # Continue to also print the would-pull plan so the user sees both
        # blockers in one shot.
      fi
      _pp_update_remote_head=$(git -C "$PP_ROOT" ls-remote --heads origin "$_pp_pull_branch" 2>/dev/null | awk '{print $1}')
      if [ -z "$_pp_update_remote_head" ]; then
        printf '[dry-run] Could not query %s (network? auth?). No changes made.\n' "$_pp_compare_ref"
        exit 0
      fi
      _pp_update_local_head=$(git -C "$PP_ROOT" rev-parse HEAD 2>/dev/null)
      if [ "$_pp_update_remote_head" = "$_pp_update_local_head" ]; then
        printf '[dry-run] Already up to date.\n'
        exit 0
      fi
      # Round-4 R4-6: distinguish fast-forward from diverged history. The
      # previous version printed "Would pull" regardless, so a user with
      # local commits ahead of upstream would see a false-positive plan.
      # `merge-base --is-ancestor A B` returns 0 iff A is an ancestor of B
      # (i.e. linear ff path); nonzero on divergence.
      #
      # Subtlety: ls-remote returns the remote SHA which may not yet exist
      # in the local object store (we haven't fetched). If it isn't local,
      # we can't run ancestry — fall back to the inverse check: is the
      # current local HEAD an ancestor of the local-tracking ref? If neither
      # is determinable, we honestly say "ff/divergence undetermined".
      if git -C "$PP_ROOT" cat-file -e "$_pp_update_remote_head" 2>/dev/null; then
        # Remote SHA is in our local object DB (post-fetch state or coincident
        # history). We can do a definitive ancestry check.
        if git -C "$PP_ROOT" merge-base --is-ancestor "$_pp_update_local_head" "$_pp_update_remote_head" 2>/dev/null; then
          printf '[dry-run] Would fast-forward to %s\n' "$_pp_update_remote_head"
          printf '[dry-run] %s: %s\n[dry-run] local HEAD: %s\n' \
            "$_pp_compare_ref" "$_pp_update_remote_head" "$_pp_update_local_head"
        else
          printf '[dry-run] Local branch has diverged from %s. A real update would FAIL --ff-only.\n' "$_pp_compare_ref"
          printf '[dry-run] %s: %s\n[dry-run] local:  %s\n' \
            "$_pp_compare_ref" "$_pp_update_remote_head" "$_pp_update_local_head"
          printf '[dry-run] Resolve with: cd %s && git status; consider git pull --rebase if appropriate\n' "$PP_ROOT"
        fi
      else
        # Remote SHA not yet in local object DB — use the local remote-
        # tracking ref as a proxy. If local HEAD is ancestor of the local
        # tracking ref, ff is plausible (though staler than ls-remote shows).
        if git -C "$PP_ROOT" merge-base --is-ancestor "$_pp_update_local_head" "$_pp_compare_ref" 2>/dev/null; then
          printf '[dry-run] Would fast-forward to %s\n' "$_pp_update_remote_head"
          printf '[dry-run] %s: %s\n[dry-run] local HEAD: %s\n' \
            "$_pp_compare_ref" "$_pp_update_remote_head" "$_pp_update_local_head"
          printf '[dry-run] (Ancestry verified against last-known %s; run without --dry-run to fetch + pull.)\n' "$_pp_compare_ref"
        else
          printf '[dry-run] Local branch has diverged from %s. A real update would FAIL --ff-only.\n' "$_pp_compare_ref"
          printf '[dry-run] %s: %s\n[dry-run] local:  %s\n' \
            "$_pp_compare_ref" "$_pp_update_remote_head" "$_pp_update_local_head"
          printf '[dry-run] Resolve with: cd %s && git status; consider git pull --rebase if appropriate\n' "$PP_ROOT"
        fi
      fi
      exit 0
    fi

    # Real path: detached HEAD is a degenerate case. Dry-run can still report
    # against origin/<default-branch> (read-only), but a real pull would
    # leave the user in a worse spot. Refuse cleanly.
    if [ -z "$_pp_current_branch" ]; then
      printf 'polymath update: HEAD is detached. Check out a branch first:\n' >&2
      printf '  cd %s && git checkout %s\n' "$PP_ROOT" "$_pp_default_branch" >&2
      exit 1
    fi

    # Round-4 R4-3: refuse on dirty working tree BEFORE the fetch. Avoids
    # spending a network round-trip just to fail at the pull, and avoids
    # the failure mode where ff-only succeeds but leaves the user's edits
    # stranded next to surprise upstream changes.
    if [ -n "$(git -C "$PP_ROOT" status --porcelain 2>/dev/null)" ]; then
      printf 'polymath update: local working tree has uncommitted changes.\n' >&2
      printf 'Refusing to pull. Stash or commit your changes first:\n' >&2
      printf '  cd %s && git status\n' "$PP_ROOT" >&2
      exit 1
    fi

    # Real path — fetch + diff + (maybe) prompt + pull + install
    printf 'Fetching from origin...\n'
    if ! git -C "$PP_ROOT" fetch origin --tags --quiet 2>&1; then
      printf 'polymath update: git fetch failed (network? auth?)\n' >&2
      exit 1
    fi

    # Capture local HEAD before pull so we can diff after the pull (R4-1).
    _pp_update_pre_pull_head=$(git -C "$PP_ROOT" rev-parse HEAD 2>/dev/null)

    _pp_update_new=$(git -C "$PP_ROOT" log --oneline "HEAD..$_pp_compare_ref" 2>/dev/null)
    if [ -z "$_pp_update_new" ]; then
      printf 'Already up to date.\n'
      exit 0
    fi

    printf '\nNew commits on %s:\n' "$_pp_compare_ref"
    printf '%s\n' "$_pp_update_new" | sed 's/^/  /'
    printf '\n'

    # Review fix F9: failed `read` (non-interactive stdin EOF) used to default
    # to "Y" via `${_pp_update_ans:-Y}`, silently proceeding with pull +
    # install. Detect non-TTY explicitly and refuse to proceed without --yes,
    # and treat a failed `read` as abort, not consent.
    if [ "$_pp_update_yes" != "1" ]; then
      if ! [ -t 0 ]; then
        printf 'polymath update: non-interactive stdin without --yes — refusing to proceed.\n' >&2
        printf 'Re-run with --yes (skips installer) or in an interactive shell.\n' >&2
        exit 1
      fi
      printf 'Pull and re-run installer? [Y/n] '
      if ! read -r _pp_update_ans; then
        printf '\npolymath update: read failed (EOF?); aborting.\n' >&2
        exit 1
      fi
      case "${_pp_update_ans:-Y}" in
        [Yy]*|"") ;;
        *) printf 'Aborted.\n'; exit 0 ;;
      esac
    fi

    if ! git -C "$PP_ROOT" pull --ff-only origin "$_pp_pull_branch" 2>&1; then
      printf '\npolymath update: pull failed.\n' >&2
      printf 'Local branch may have diverged. Inspect with: cd %s && git status\n' "$PP_ROOT" >&2
      exit 1
    fi

    # Review fix F4 + Round-4 R4-1: install.sh has multiple interactive `read`
    # calls, so --yes must NOT invoke it. But the previous --yes path just
    # said "re-run manually if needed", which was unhelpful — the user has no
    # way to know whether the pull actually changed anything installer-
    # affecting. Now we diff the actual changeset and either confirm the
    # install is still idempotent, or warn loudly with the file list and
    # the exact command to re-run.
    if [ "$_pp_update_yes" = "1" ]; then
      installer_changed=$(git -C "$PP_ROOT" diff --name-only "$_pp_update_pre_pull_head" HEAD 2>/dev/null \
        | grep -E '^(bin/install\.sh|hooks/|config/default\.env)' || true)
      if [ -z "$installer_changed" ]; then
        printf '\n[--yes] Pull complete. No installer-affecting files changed; install was idempotent.\n'
      else
        printf '\n[--yes] Pull complete. WARNING: installer-affecting files changed:\n' >&2
        printf '%s\n' "$installer_changed" | sed 's/^/  /' >&2
        printf '\n[--yes] Re-run interactively to update hooks/config/dependencies:\n' >&2
        printf '          bash %s/bin/install.sh\n' "$PP_ROOT" >&2
        # Don't exit nonzero — the pull itself succeeded. Just warn loudly.
      fi
    else
      printf '\nRe-running installer (idempotent — preserves your settings.json + user.env)...\n'
      bash "$PP_ROOT/bin/install.sh"
    fi
    ;;

  cost)
    shift
    _pp_cost_since="7d"
    _pp_cost_by_lens=0
    _pp_cost_json=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --since)
          [ -n "${2:-}" ] || { printf 'polymath cost: --since requires a value (e.g. 7d, 30d, 1d)\n' >&2; exit 2; }
          _pp_cost_since="$2"
          shift 2
          ;;
        --by-lens) _pp_cost_by_lens=1; shift ;;
        --json) _pp_cost_json=1; shift ;;
        -h|--help)
          cat <<HELP
polymath cost — show estimated USD spend from metrics.jsonl

Usage:
  polymath cost                       Last 7d, table by day
  polymath cost --since 30d           Last 30 days
  polymath cost --by-lens             Breakdown by call type
  polymath cost --json                Raw JSONL for piping to jq

Note: figures are ESTIMATES based on static avg-token assumptions and per-million
pricing in lib/metrics.sh. Real spend may vary 20-50%. v0.3 plans real --usage
parsing.
HELP
          exit 0
          ;;
        *) printf 'polymath cost: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # Validate --since (Nd format)
    case "$_pp_cost_since" in
      *d) : ;;
      *) printf 'polymath cost: --since must be like 7d, 30d (got %s)\n' "$_pp_cost_since" >&2; exit 2 ;;
    esac
    _pp_cost_days="${_pp_cost_since%d}"
    case "$_pp_cost_days" in
      ''|*[!0-9]*) printf 'polymath cost: --since days must be numeric (got %s)\n' "$_pp_cost_since" >&2; exit 2 ;;
    esac
    [ "$_pp_cost_days" -lt 1 ] && { printf 'polymath cost: --since must be >= 1d (got %s)\n' "$_pp_cost_since" >&2; exit 2; }

    _pp_metrics_file="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/metrics.jsonl"
    if [ ! -s "$_pp_metrics_file" ]; then
      printf 'polymath cost: no metrics yet (run a session to produce them).\n'
      exit 0
    fi

    # Compute cutoff timestamp (UTC) for "since N days". BSD date uses -v -Nd;
    # GNU date uses -d "-N days". Probe by trying BSD form first (macOS).
    if date -u -v "-${_pp_cost_days}d" '+%Y-%m-%dT%H:%M:%SZ' >/dev/null 2>&1; then
      _pp_cost_cutoff=$(date -u -v "-${_pp_cost_days}d" '+%Y-%m-%dT%H:%M:%SZ')
    else
      _pp_cost_cutoff=$(date -u -d "-${_pp_cost_days} days" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)
    fi
    if [ -z "$_pp_cost_cutoff" ]; then
      printf 'polymath cost: could not compute cutoff date for --since %s\n' "$_pp_cost_since" >&2
      exit 1
    fi

    if [ "$_pp_cost_json" = "1" ]; then
      # Raw JSONL filtered by cutoff
      jq -c --arg cutoff "$_pp_cost_cutoff" 'select(.ts >= $cutoff)' "$_pp_metrics_file"
      exit 0
    fi

    if [ "$_pp_cost_by_lens" = "1" ]; then
      printf '\nCost by call type (last %s):\n' "$_pp_cost_since"
      # Review fix R2-H2: previous code did `map(.by_type) | add` which in jq
      # performs key-collision merge (last-write-wins) on objects, NOT numeric
      # summation. Across multiple sessions with overlapping call-type keys
      # (always the case) only the LAST session's counts survived, silently
      # undercounting in proportion to history length. Replace with
      # flatten-group-sum and also surface the per-type USD totals from the
      # new `by_type_usd` field (added in lib/metrics.sh round-2).
      _pp_cost_bytype=$(jq -s --arg cutoff "$_pp_cost_cutoff" '
        def sum_by_key:
          [.[] // {} | to_entries[]]
          | group_by(.key)
          | map({key: .[0].key, value: (map(.value) | add)})
          | from_entries;
        map(select(.ts >= $cutoff)) as $rows
        | ($rows | map(.by_type // {}) | sum_by_key) as $counts
        | ($rows | map(.by_type_usd // {}) | sum_by_key) as $usds
        | [ $counts | to_entries[] | {key: .key, calls: .value, usd: ($usds[.key] // 0)} ]
        | sort_by(-.calls)
      ' "$_pp_metrics_file" 2>/dev/null)
      if [ -z "$_pp_cost_bytype" ] || [ "$_pp_cost_bytype" = "[]" ]; then
        printf '  (no data in window)\n\n'
        exit 0
      fi
      # 4-decimal USD display (review fix R2-M2): sub-cent sessions otherwise
      # render as $0.00 and look like the feature is broken.
      printf '%s' "$_pp_cost_bytype" \
        | jq -r '.[] | "  " + .key + ": " + (.calls | tostring) + " calls / $" + ((.usd * 10000 | round) / 10000 | tostring)'
      printf '\n'
      # Round-3 fix R3-PR10-6: surface unknown-model warnings.
      _pp_warn_file="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/metrics-warnings.log"
      if [ -s "$_pp_warn_file" ]; then
        printf '\033[33m⚠\033[0m  Unknown models seen — figures may underestimate spend:\n'
        awk -F'\t' 'NR<=5 {print "  " $0}' "$_pp_warn_file"
        printf '  See: %s\n\n' "$_pp_warn_file"
      fi
      exit 0
    fi

    # Default: table by day with date / cycles / calls / USD columns.
    # Review fix R2-M2: USD now formatted to 4 decimals (round/10000) so
    # single-call sub-cent test sessions don't display as $0.00 and look
    # like the metric is broken.
    _pp_cost_rows=$(jq -rs --arg cutoff "$_pp_cost_cutoff" '
      map(select(.ts >= $cutoff))
      | group_by(.ts[0:10])
      | map({
          date: .[0].ts[0:10],
          cycles: length,
          calls: (map(.calls) | add // 0),
          usd: (map(.usd_est) | add // 0)
        })
      | sort_by(.date)
      | .[]
      | [.date, (.cycles|tostring), (.calls|tostring), (.usd*10000|round/10000|tostring)]
      | @tsv
    ' "$_pp_metrics_file" 2>/dev/null)

    if [ -z "$_pp_cost_rows" ]; then
      printf '\nNo cycles in last %s.\n\n' "$_pp_cost_since"
      exit 0
    fi

    _pp_cost_totals=$(jq -rs --arg cutoff "$_pp_cost_cutoff" '
      map(select(.ts >= $cutoff))
      | {cycles: length, calls: (map(.calls) | add // 0), usd: (map(.usd_est) | add // 0)}
      | [(.cycles|tostring), (.calls|tostring), (.usd*10000|round/10000|tostring)]
      | @tsv
    ' "$_pp_metrics_file" 2>/dev/null)

    printf '\n'
    printf '%-12s  %7s  %7s  %10s\n' 'Date' 'Cycles' 'Calls' 'USD (est)'
    printf -- '─────────────────────────────────────────\n'
    printf '%s\n' "$_pp_cost_rows" | awk -F'\t' '{printf "%-12s  %7s  %7s  $%8s\n", $1, $2, $3, $4}'
    printf -- '─────────────────────────────────────────\n'
    printf '%s\n' "$_pp_cost_totals" | awk -F'\t' '{printf "%-12s  %7s  %7s  $%8s\n", "Total", $1, $2, $3}'
    printf '\n'
    # Round-3 fix R3-PR10-6: surface unknown-model warnings.
    _pp_warn_file="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/metrics-warnings.log"
    if [ -s "$_pp_warn_file" ]; then
      printf '\033[33m⚠\033[0m  Unknown models seen — figures may underestimate spend:\n'
      awk -F'\t' 'NR<=5 {print "  " $0}' "$_pp_warn_file"
      printf '  See: %s\n\n' "$_pp_warn_file"
    fi
    ;;

  self-test)
    shift
    _pp_st_yes=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --yes|-y) _pp_st_yes=1; shift ;;
        -h|--help)
          cat <<HELP
polymath self-test — end-to-end LLM probe (~\$0.0001)

Makes one real LLM call through the run_llm wrapper, verifies:
  - openai key is set and accepted
  - network reaches the API
  - run_llm wrapper invokes correctly (timeout + portable)
  - budget counter increments by 1
  - response is parseable + matches expected sentinel

Usage:
  polymath self-test                Interactive: confirm before spending
  polymath self-test --yes          Non-interactive: skip confirm
  polymath self-test --help         This message

Cost: ~\$0.0001 per run (single gpt-5-mini call, ~50 input tokens / ~10 output tokens).
HELP
          exit 0
          ;;
        *) printf 'polymath self-test: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # Confirm before spending (unless --yes)
    if [ "$_pp_st_yes" != "1" ]; then
      printf 'polymath self-test will make one real LLM call (~$0.0001). Proceed? [Y/n] '
      if ! [ -t 0 ]; then
        printf '\npolymath self-test: non-interactive stdin without --yes. Refusing.\n' >&2
        exit 1
      fi
      if ! read -r _pp_st_ans; then
        printf '\npolymath self-test: read failed (EOF?); aborting.\n' >&2
        exit 1
      fi
      case "${_pp_st_ans:-Y}" in
        [Yy]*|"") ;;
        *) printf 'Aborted.\n'; exit 0 ;;
      esac
    fi

    # === Dispatch the actual probe ===
    if ! command -v llm >/dev/null 2>&1; then
      printf '\033[31m✗\033[0m self-test: llm CLI not on PATH\n' >&2
      exit 1
    fi
    # R2 MED-3: env-var-configured users (OPENAI_API_KEY exported) are valid
    # too. Only WARN if the key list doesn't show openai — let the real call
    # validate. Previously this was a hard exit that rejected valid configs.
    if ! llm keys list 2>/dev/null | grep -q '^openai$'; then
      printf '\033[33m⚠\033[0m self-test: openai not in `llm keys list`; trusting env-var or plugin to provide credentials. The real call will validate.\n' >&2
    fi

    # Track whether any verification step failed. We complete the entire
    # probe (so users see all signals) and then exit non-zero at the end.
    # R2 HIGH-1: sentinel mismatch must NOT be silently swallowed.
    _pp_st_failed=0

    # Record budget before
    _pp_st_budget_before=$(budget_get)

    # Use the SAME run_llm wrapper that bin/statusline.sh uses, by extracting it.
    # For test isolation, we redeclare it here (it's portable + idempotent).
    _pp_st_run_llm() {
      local timeout_s="${1:-15}"
      shift
      if command -v timeout >/dev/null 2>&1; then
        timeout "$timeout_s" llm "$@"
      elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$timeout_s" llm "$@"
      else
        llm "$@"
      fi
    }

    printf '\033[1mself-test\033[0m: probing OpenAI via run_llm...\n'

    # Single cheap call: ask for a known sentinel. System prompt via -s flag
    # (R2 MED-4) — clearer + matches statusline.sh's wrapper conventions
    # than relying on llm's positional-after-stdin merge heuristic.
    _pp_st_out=$(printf 'Respond with EXACTLY the word: PAIRPOLYMATH_OK' | _pp_st_run_llm 15 -m gpt-5-mini -s "You are a probe responder. Output exactly the requested word, no more." 2>/dev/null)
    _pp_st_rc=$?

    if [ "$_pp_st_rc" -ne 0 ]; then
      printf '\033[31m✗\033[0m self-test: llm call failed (rc=%s). Check network + key.\n' "$_pp_st_rc" >&2
      # R2 HIGH-2: increment budget ONLY if the call succeeded. Failed calls
      # (network/auth/timeout) must not corrupt the daily counter.
      exit 1
    fi

    # Increment budget AFTER successful call (matches statusline.sh)
    budget_inc || true

    # Verify the response
    _pp_st_trimmed=$(printf '%s' "$_pp_st_out" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    case "$_pp_st_trimmed" in
      *pairpolymath_ok*)
        printf '\033[32m✓\033[0m self-test: response matched sentinel\n'
        ;;
      *)
        # R2 HIGH-1: previously this only warned and the script continued
        # to print "All passed" + exit 0. A self-test that doesn't actually
        # verify is worse than no test. Track the failure and exit non-zero.
        printf '\033[31m✗\033[0m self-test: response did NOT match sentinel "PAIRPOLYMATH_OK"\n'
        printf '          got: %s\n' "${_pp_st_out:0:200}"
        printf '          (key + network reachable, but model output unexpected)\n'
        _pp_st_failed=1
        ;;
    esac

    # Verify budget incremented
    _pp_st_budget_after=$(budget_get)
    _pp_st_delta=$((_pp_st_budget_after - _pp_st_budget_before))
    if [ "$_pp_st_delta" -ge 1 ]; then
      printf '\033[32m✓\033[0m self-test: budget incremented by %s\n' "$_pp_st_delta"
    else
      printf '\033[31m✗\033[0m self-test: budget did NOT increment (before=%s, after=%s)\n' "$_pp_st_budget_before" "$_pp_st_budget_after"
      _pp_st_failed=1
    fi

    if [ "$_pp_st_failed" = "1" ]; then
      printf '\n\033[31mself-test: one or more checks failed.\033[0m\n' >&2
      exit 1
    fi
    printf '\n\033[32mAll self-test checks passed.\033[0m\n'
    ;;

  memory)
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/schema.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/redact.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/store.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/activation.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/lock.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/patterns.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/evict.sh"
    _pp_mem_cwd="${PP_MEMORY_CLI_CWD:-$PWD}"
    _pp_mem_sub="${1:-status}"
    case "$_pp_mem_sub" in
      status)
        _pp_mem_proj=$(pp_memory_project_dir "$_pp_mem_cwd")
        _pp_mem_db="$_pp_mem_proj/observations.sqlite"
        printf '\n\033[1mPair Polymath memory\033[0m\n'
        printf '  Enabled:          %s\n' "${PP_MEMORY_ENABLE:-0}"
        printf '  Memory dir:       %s\n' "$PP_MEMORY_DIR"
        printf '  Project dir:      %s\n' "$_pp_mem_proj"
        if [ -f "$_pp_mem_db" ]; then
          _pp_mem_size=$(stat -f %z "$_pp_mem_db" 2>/dev/null || stat -c %s "$_pp_mem_db" 2>/dev/null || echo 0)
          printf '  DB path:          %s\n' "$_pp_mem_db"
          printf '  Size (bytes):     %s\n' "$_pp_mem_size"
          # F13: detect schema before querying. A DB file that exists but
          # has no observations table (corrupt, half-initialized, or from a
          # future schema version) used to crash with "no such table" once
          # the SELECT ran. PRAGMA table_info returns nothing for a missing
          # table and is a free read — no schema mutation.
          _pp_mem_has_obs=$(pp_memory_sqlite "$_pp_mem_db" "PRAGMA table_info(observations);" 2>/dev/null | head -1)
          if [ -z "$_pp_mem_has_obs" ]; then
            printf '  Schema:           DB uninitialized (no observations table)\n'
          else
            _pp_mem_rows=$(pp_memory_sqlite "$_pp_mem_db" "SELECT COUNT(*) FROM observations;" 2>/dev/null)
            printf '  Observations:     %s\n' "$_pp_mem_rows"
            if [ "${_pp_mem_rows:-0}" -gt 0 ]; then
              printf '  Top-5 by activation:\n'
              pp_memory_sqlite -separator ' | ' "$_pp_mem_db" "
                SELECT printf('    [%s] %s (act=%.3f)', lens_id, hook, activation_score)
                  FROM observations
                 ORDER BY (activation_score IS NULL), activation_score DESC, obs_id ASC
                 LIMIT 5;" 2>/dev/null
            fi
          fi
        else
          printf '  DB:               (not yet initialized)\n'
        fi
        if [ -f "$_pp_mem_proj/patterns.jsonl" ]; then
          _pp_mem_plines=$(wc -l < "$_pp_mem_proj/patterns.jsonl" 2>/dev/null | tr -d ' ')
          printf '  Patterns:         %s\n' "$_pp_mem_plines"
        fi
        printf '\n'
        ;;
      recompute)
        _pp_mem_pd=$(pp_memory_project_dir "$_pp_mem_cwd")
        pp_memory_db_init "$_pp_mem_pd"
        if pp_memory_with_lock "$_pp_mem_pd" pp_memory_recompute_scores "$_pp_mem_cwd"; then
          printf 'memory: activation_score recomputed.\n'
        else
          printf 'memory: recompute failed (see stderr).\n' >&2
          exit 1
        fi
        ;;
      evict)
        if pp_memory_evict "$_pp_mem_cwd"; then
          printf 'memory: eviction sweep complete.\n'
        else
          printf 'memory: eviction did NOT complete (LLM summary required); see stderr.\n' >&2
          exit 1
        fi
        ;;
      patterns)
        out=$(pp_memory_top_patterns "$_pp_mem_cwd" 10)
        if [ -z "$out" ] || [ "$out" = "[]" ]; then
          printf '(no patterns extracted yet)\n'
        else
          printf '%s\n' "$out" | jq -r '.[] | "  • [" + (.confidence|tostring) + "] " + .title'
        fi
        ;;
      clear)
        _pp_mem_yes=0
        [ "${2:-}" = "--yes" ] && _pp_mem_yes=1
        if [ "$_pp_mem_yes" != "1" ]; then
          printf 'memory clear: refusing without --yes (this deletes ALL memory for the current project)\n' >&2
          exit 2
        fi
        _pp_mem_proj=$(pp_memory_project_dir "$_pp_mem_cwd")
        rm -rf "$_pp_mem_proj"
        printf 'memory: cleared %s\n' "$_pp_mem_proj"
        ;;
      enable)
        _pp_set_user_env_var PP_MEMORY_ENABLE 1 || exit 1
        printf 'memory: enabled (takes effect next cycle within 5min)\n'
        ;;
      disable)
        _pp_set_user_env_var PP_MEMORY_ENABLE 0 || exit 1
        printf 'memory: disabled (takes effect next cycle within 5min)\n'
        ;;
      help|-h|--help|"")
        cat <<HELP
polymath memory — Pair Polymath memory subsystem

Usage:
  polymath memory status          Show DB path, row count, size, top-5 by activation
  polymath memory recompute       Trigger activation_score recompute (under lock)
  polymath memory evict           Trigger eviction sweep (LLM summary required)
  polymath memory patterns        Show last 10 extracted patterns
  polymath memory clear --yes     Wipe all memory for the current project
  polymath memory enable          Set PP_MEMORY_ENABLE=1 in user.env
  polymath memory disable         Set PP_MEMORY_ENABLE=0 in user.env

Override the active project by exporting PP_MEMORY_CLI_CWD before the call.
HELP
        ;;
      *)
        printf 'polymath memory: unknown subcommand "%s". Try: polymath memory help\n' "$_pp_mem_sub" >&2
        exit 2
        ;;
    esac
    ;;

  help|-h|--help|"")
    cat <<EOF
polymath — Pair Polymath CLI

Usage:
  polymath status      Show today's calls, lens registry, config flags
  polymath doctor      Run health checks (--network for live OpenAI probe)
  polymath enable      Enable the LLM lens cycle (set PP_EXTERNAL_LLM=1)
  polymath disable     Disable the LLM cycle / status-only mode (PP_EXTERNAL_LLM=0)
  polymath logs        Tail recent lens observations (-n, --lens, --follow)
  polymath cost        Show estimated USD spend (--since, --by-lens, --json)
  polymath memory      Memory subsystem (status / recompute / evict / patterns / clear / enable / disable)
  polymath update      Pull latest + re-run installer (--yes, --dry-run)
  polymath self-test   End-to-end LLM probe (~\$0.0001 per run)
  polymath version     Print version
  polymath help        This message
EOF
    ;;

  *)
    printf 'polymath: unknown command "%s". Try: polymath help\n' "$cmd" >&2
    exit 2
    ;;
esac
