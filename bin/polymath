#!/usr/bin/env bash
# Pair Polymath CLI — v0.2: status, version, doctor, enable/disable, logs,
# cost, update, self-test.

set -u
# v0.4.2 privacy fix: every cache + user.env write inherits 0600.
umask 077

PP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PP_ROOT/lib/config.sh"
# shellcheck disable=SC1091
. "$PP_ROOT/lib/budget.sh"
# shellcheck disable=SC1091
. "$PP_ROOT/lib/project-identity.sh" 2>/dev/null || true

# Detect GNU vs BSD stat ONCE, upfront (review fix F7' + R4-4).
# Round-1 F7 used a fallback chain `stat -f %m FILE || stat -c %Y FILE`. The
# problem: on GNU/Linux `stat -f %m FILE` does NOT fail — `-f` means
# "filesystem mode" and `%m` is the mount point string (e.g. `/`). That
# string then went to `date -r STRING` which GNU's `date -r FILE` happily
# accepts as a filename, yielding the MOUNT POINT'S mtime as every log
# entry's timestamp. Format-valid but value-wrong; tests that asserted only
# format passed. Explicit detection avoids the trap.
#
# Round-4 R4-4: previous version probed with `stat --version | grep -qE
# 'GNU|coreutils'`. That returns FALSE on BusyBox / Alpine even though
# BusyBox's `stat` supports `-c %Y` (GNU-style flag for compat). Then we
# fell through to the BSD branch `stat -f %m`, which BusyBox doesn't
# implement → every timestamp resolved to '?'. Probe by trying the flag
# itself: this works correctly on GNU stat AND BusyBox AND OpenBSD AND
# macOS BSD.
if stat -c %Y /dev/null >/dev/null 2>&1; then
  _PP_STAT_FLAVOR=gnu
elif stat -f %m /dev/null >/dev/null 2>&1; then
  _PP_STAT_FLAVOR=bsd
else
  _PP_STAT_FLAVOR=unknown
fi

# _pp_set_user_env_var KEY VALUE
# Atomically set KEY=VALUE in $PP_USER_CONFIG,
# preserving every other line. Symlink-aware (writes through to the link
# target so dotfile-managed configs aren't replaced with regular files).
# Fails loudly on real grep / mkdir errors (review fixes H1+H2+M1+M2).
# Returns 0 on success, 1 on any error (with stderr message).
_pp_set_user_env_var() {
  local key="$1" value="$2"
  local user_env="${PP_USER_CONFIG:-${PP_STATE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/pair-polymath}/config/user.env}"
  local cfg_dir
  cfg_dir="$(dirname "$user_env")"

  # Fail loudly if we cannot create the config dir (review fix M2)
  if ! mkdir -p "$cfg_dir" 2>/dev/null; then
    printf 'polymath: cannot create config dir %s\n' "$cfg_dir" >&2
    return 1
  fi

  [ -f "$user_env" ] || : > "$user_env"

  # Create tmp in the SAME directory so the eventual mv stays atomic within
  # the same filesystem (review fix H2). Cross-FS mv is a copy + delete with
  # a race window.
  local tmp
  tmp=$(mktemp "${user_env}.XXXXXX") || {
    printf 'polymath: mktemp failed\n' >&2
    return 1
  }

  # Strip any existing KEY=... line. grep exit semantics with `-v`:
  #   0 = at least one line did NOT match (kept) → normal
  #   1 = no lines did NOT match (file empty after filter) → also normal
  #   2+ = real read error → must not proceed (review fix H1: previously we
  #        would silently truncate user.env to just our new line)
  local grep_rc=0
  grep -v "^${key}=" "$user_env" > "$tmp" || grep_rc=$?
  case "$grep_rc" in
    0|1) ;;
    *)
      rm -f "$tmp"
      printf 'polymath: failed to read %s (grep exit %s); user.env left intact\n' "$user_env" "$grep_rc" >&2
      return 1
      ;;
  esac

  printf '%s=%s\n' "$key" "$value" >> "$tmp"

  # Symlink-preserving write: if user_env is a symlink (e.g. dotfile manager
  # mapped it elsewhere), write THROUGH the link to the real target.
  # Otherwise atomic rename within the same filesystem (review fix M1).
  if [ -L "$user_env" ]; then
    if ! cat "$tmp" > "$user_env"; then
      rm -f "$tmp"
      printf 'polymath: could not write through symlink %s\n' "$user_env" >&2
      return 1
    fi
    rm -f "$tmp"
  else
    if ! mv "$tmp" "$user_env"; then
      rm -f "$tmp"
      printf 'polymath: could not move tmp into place at %s\n' "$user_env" >&2
      return 1
    fi
  fi
  return 0
}

# _pp_cache_clear_all <cache_dir>
# Truncates lens + tip + injection-idempotency caches in cache_dir.
# Preserves budget files and re-chmods them + the directory to mode 600/700.
# Canonical truncation path — called by `cache clear all` subcommand AND by
# `polymath disable` (v0.5.4) so visible pause state is immediate.
_pp_cache_clear_all() {
  local _pp_cache_dir="${1:-}"
  [ -z "$_pp_cache_dir" ] && return 1
  [ -d "$_pp_cache_dir" ] || return 0
  # v0.5.4 post-review (GPT-5): defensive guard against accidental
  # misconfiguration of PP_CACHE_DIR. The path MUST contain '/cache'
  # as a component, otherwise the find -exec rm pattern below could
  # delete files outside the intended cache scope.
  case "$_pp_cache_dir" in
    */cache|*/cache/*) : ;;
    *)
      printf 'polymath: refusing to clear %s — path must contain /cache\n' \
        "$_pp_cache_dir" >&2
      return 1
      ;;
  esac
  find "$_pp_cache_dir" -maxdepth 1 \
    \( -name 'cc-monitor-*.txt' -o -name 'cc-tips*' \) \
    -type f ! -name 'cc-monitor-budget-*' -exec rm -f {} \; 2>/dev/null
  find "$_pp_cache_dir" -maxdepth 1 \
    \( -name 'cc-monitor-injected-hash-*' -o -name 'cc-monitor-injected-time-*' \) \
    -type f -exec rm -f {} \; 2>/dev/null
  find "$_pp_cache_dir" -maxdepth 1 \
    \( -name 'pp-budget-*' -o -name 'cc-monitor-budget-*' \) \
    -type f -exec chmod 600 {} \; 2>/dev/null
  chmod 700 "$_pp_cache_dir" 2>/dev/null || true
}

cmd="${1:-status}"

case "$cmd" in
  version|-v|--version)
    cat "$PP_ROOT/VERSION"
    ;;

  status)
    today_calls=$(budget_get)
    # v0.4.3: was `:-3500` here while lib/budget.sh pressure used :-10000
    # and config/default.env shipped 10000 — three sources, one truth.
    # Now sourced from lib/budget.sh's `: "${PP_MAX_DAILY_CALLS:=10000}"`
    # which fires on `lib/budget.sh` source at bin/polymath:13.
    cap="$PP_MAX_DAILY_CALLS"
    used_pct=0
    if [ "$cap" -gt 0 ]; then
      used_pct=$((today_calls * 100 / cap))
    fi

    # v0.4.1 review-fix (I5): surface budget pressure with the same
    # thresholds + glyph language as the statusline pip so a user
    # invoking `polymath status` sees the same warn/red signal that
    # appears in their chrome. Reuses the canonical helper.
    pressure_pct=$(pp_budget_remaining_pct 2>/dev/null)
    case "$pressure_pct" in ''|*[!0-9]*) pressure_pct=100 ;; esac
    pressure_warn="${PP_BUDGET_WARN_PCT:-80}"
    pressure_red="${PP_BUDGET_RED_PCT:-95}"
    case "$pressure_warn" in ''|*[!0-9]*) pressure_warn=80 ;; esac
    case "$pressure_red"  in ''|*[!0-9]*) pressure_red=95  ;; esac
    # v0.4.3 cumulative-review fix: backport the 4-step clamp ladder
    # from bin/statusline.sh:273-289 + lib/doctor.sh:363-374 so all
    # three budget-pressure surfaces speak the same numbers under
    # misconfig. Missing here previously: lower-bound (WARN=0 would
    # render permanent yellow) + inversion-reset (WARN >= RED would
    # silently skip yellow and go straight to red).
    [ "$pressure_warn" -gt 100 ] && pressure_warn=80
    [ "$pressure_red"  -gt 100 ] && pressure_red=95
    [ "$pressure_warn" -lt 1 ] && pressure_warn=80
    [ "$pressure_red"  -lt 1 ] && pressure_red=95
    if [ "$pressure_warn" -ge "$pressure_red" ]; then
      pressure_warn=80
      pressure_red=95
    fi
    pressure_used=$((100 - pressure_pct))
    if [ "$pressure_used" -ge "$pressure_red" ]; then
      pressure_glyph=$(printf '\033[31m⚠ RED\033[0m')
    elif [ "$pressure_used" -ge "$pressure_warn" ]; then
      pressure_glyph=$(printf '\033[33m⚡ YELLOW\033[0m')
    else
      pressure_glyph=$(printf '\033[32m✓ GREEN\033[0m')
    fi

    # v0.5.5 brand: ⚛ sigil header (color-cycled per wall-clock).
    # Lazy-source brand.sh; fall back to plain header when unavailable.
    if [ -z "${_PP_BRAND_SOURCED:-}" ]; then
      # shellcheck disable=SC1091
      . "$PP_ROOT/lib/brand.sh" 2>/dev/null || true
    fi
    if type pp_brand_sigil_cycled >/dev/null 2>&1; then
      printf '\n%s \033[1mPair Polymath status\033[0m\n' "$(pp_brand_sigil_cycled)"
    else
      printf '\n\033[1mPair Polymath status\033[0m\n'
    fi
    printf '  Plugin root:     %s\n' "$PP_ROOT"
    printf '  Version:         %s\n' "$(cat "$PP_ROOT/VERSION")"
    printf '  Today (%s)\n' "$(date +%Y-%m-%d)"
    printf '    Calls:         %s / %s (%s%%)\n' "$today_calls" "$cap" "$used_pct"
    printf '    Budget:        %s (%s%% remaining)\n' "$pressure_glyph" "$pressure_pct"

    # Lens registry summary
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/lens-loader.sh"
    if pp_load_lenses 2>/dev/null; then
      printf '  Lenses loaded:   %s\n' "$PP_LENS_COUNT"
      for i in $(seq 0 $((PP_LENS_COUNT - 1))); do
        printf '    [%s] %s\n' "$((i + 1))" "${PP_LENS_IDS[$i]}"
      done
    fi

    # Prompts present?
    prompt_count=$(find "$PP_ROOT/prompts" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    printf '  Prompts:         %s built-in\n' "$prompt_count"

    # Honor $CLAUDE_DIR like install/uninstall do (review fix L1)
    user_prompts=$(find "${PP_STATE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/pair-polymath}/prompts" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    [ "$user_prompts" -gt 0 ] && printf '    +%s user overrides\n' "$user_prompts"

    # Feature flags
    printf '  External LLM:    %s\n' "${PP_EXTERNAL_LLM:-1}"
    printf '  Escalation:      %s\n' "${PP_ENABLE_ESCALATION:-1}"

    # Privacy log (P3.3) — surface its existence + recency so users can find it.
    # Uses the same stat-flavor detection as the rest of the script so the
    # mtime read is portable across GNU/BSD/BusyBox.
    _pp_privacy_log="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/last-cycle-payload.json"
    if [ -f "$_pp_privacy_log" ]; then
      _pp_pl_mtime=0
      case "$_PP_STAT_FLAVOR" in
        gnu) _pp_pl_mtime=$(stat -c %Y "$_pp_privacy_log" 2>/dev/null || echo 0) ;;
        bsd) _pp_pl_mtime=$(stat -f %m "$_pp_privacy_log" 2>/dev/null || echo 0) ;;
      esac
      _pp_pl_age_s=$(( $(date +%s) - _pp_pl_mtime ))
      if [ "$_pp_pl_age_s" -lt 0 ]; then _pp_pl_age_s=0; fi
      if [ "$_pp_pl_age_s" -lt 3600 ]; then
        _pp_pl_age="${_pp_pl_age_s}s ago"
      else
        _pp_pl_age="$((_pp_pl_age_s/60))min ago"
      fi
      printf '  Privacy log:     %s (%s)\n' "$_pp_privacy_log" "$_pp_pl_age"
    fi

    printf '\n'
    ;;

  doctor)
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/doctor.sh"
    pp_doctor_run "$@"
    ;;

  cache)
    # v0.4.2: cache hygiene subcommands.
    #   cache clear         — wipe ALL lens caches + tip caches + injection idempotency files
    #   cache clear --tips  — wipe only the tip caches (per-project)
    #   cache clear --orphans — wipe only orphaned-session lens caches (not the current one)
    #   cache list          — show what's there with mode + size + age
    shift
    _pp_cache_sub="${1:-list}"
    _pp_cache_dir="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}"
    case "$_pp_cache_sub" in
      list)
        # shellcheck disable=SC1091
        . "$PP_ROOT/lib/grounding.sh"
        printf '\n\033[1mPair Polymath cache (%s)\033[0m\n' "$_pp_cache_dir"
        if [ ! -d "$_pp_cache_dir" ]; then
          printf '  (empty / never run)\n\n'
          exit 0
        fi
        _pp_cache_dir_mode=$(pp_file_mode "$_pp_cache_dir")
        [ -z "$_pp_cache_dir_mode" ] && _pp_cache_dir_mode="?"
        printf '  Dir mode: %s (target: 700)\n' "$_pp_cache_dir_mode"
        _pp_cache_total=$(find "$_pp_cache_dir" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')
        _pp_cache_tips=$(find "$_pp_cache_dir" -maxdepth 1 -name 'cc-tips*' -type f 2>/dev/null | wc -l | tr -d ' ')
        # Review G9: exclude budget files from the lens count; they're
        # date-stamped daily-cap accounting, not lens observations.
        _pp_cache_lens=$(find "$_pp_cache_dir" -maxdepth 1 -name 'cc-monitor-*' ! -name 'cc-monitor-budget-*' -type f 2>/dev/null | wc -l | tr -d ' ')
        _pp_cache_budget=$(find "$_pp_cache_dir" -maxdepth 1 \
          \( -name 'pp-budget-*' -o -name 'cc-monitor-budget-*' \) \
          -type f 2>/dev/null | wc -l | tr -d ' ')
        _pp_cache_loose=$(find "$_pp_cache_dir" -maxdepth 1 -type f ! -perm 600 2>/dev/null | wc -l | tr -d ' ')
        printf '  Files:    %s total (%s tips, %s lens/hook, %s budget)\n' "$_pp_cache_total" "$_pp_cache_tips" "$_pp_cache_lens" "$_pp_cache_budget"
        if [ "$_pp_cache_loose" -gt 0 ]; then
          printf '  \033[33m! %s files with mode != 600 (run `polymath cache clear` to remediate)\033[0m\n' "$_pp_cache_loose"
        fi
        printf '\n'
        ;;
      clear)
        shift
        _pp_clear_what="${1:-all}"
        case "$_pp_clear_what" in
          --tips)
            find "$_pp_cache_dir" -maxdepth 1 -name 'cc-tips*' -type f -exec rm -f {} \; 2>/dev/null
            printf 'polymath: cleared tip caches in %s\n' "$_pp_cache_dir"
            ;;
          --orphans)
            # Tricky: there's no "current session" notion outside Claude Code,
            # so wipe stale files. v0.4.3 cumulative-review fix (P1-3): the
            # prior `-mtime +1` was claimed "older than 24h" but POSIX
            # truncation makes it match files at least ~48h old. Use a
            # marker file as the cutoff: portably means "older than exactly
            # 24 hours" on both BSD (date -v) and GNU (date -d).
            _pp_orphan_marker=$(mktemp -t pp-orphan-cutoff-XXXXXX) || _pp_orphan_marker=""
            if [ -n "$_pp_orphan_marker" ]; then
              # Try BSD-style first then GNU; if both fail, fall back to
              # the original -mtime +1 (>48h) semantics with a tighter
              # message so we don't lie.
              if touch -t "$(date -v -1d +%Y%m%d%H%M.%S 2>/dev/null)" "$_pp_orphan_marker" 2>/dev/null \
                || touch -d '1 day ago' "$_pp_orphan_marker" 2>/dev/null; then
                # Include legacy cc-tips.txt (no project key) in the sweep.
                find "$_pp_cache_dir" -maxdepth 1 \
                  \( -name 'cc-monitor-*.txt' -o -name 'cc-tips-*.txt' -o -name 'cc-tips.txt' \
                     -o -name 'cc-monitor-injected-hash-*' -o -name 'cc-monitor-injected-time-*' \) \
                  -type f ! -name 'cc-monitor-budget-*' \
                  ! -newer "$_pp_orphan_marker" -exec rm -f {} \; 2>/dev/null
                rm -f "$_pp_orphan_marker"
                printf 'polymath: cleared orphan caches (mtime >24h) in %s\n' "$_pp_cache_dir"
              else
                rm -f "$_pp_orphan_marker"
                find "$_pp_cache_dir" -maxdepth 1 \
                  \( -name 'cc-monitor-*.txt' -o -name 'cc-tips-*.txt' -o -name 'cc-tips.txt' \
                     -o -name 'cc-monitor-injected-hash-*' -o -name 'cc-monitor-injected-time-*' \) \
                  -type f ! -name 'cc-monitor-budget-*' \
                  -mtime +1 -exec rm -f {} \; 2>/dev/null
                printf 'polymath: cleared orphan caches (no portable 24h date support; using ~48h fallback) in %s\n' "$_pp_cache_dir"
              fi
            fi
            ;;
          all|"")
            # Preserve budget files (date-stamped, inert, needed for daily cap).
            # v0.5.4: body extracted into _pp_cache_clear_all (defined ~line 105)
            # so `polymath disable` reuses the canonical truncation path. The
            # helper handles: rm lens+tip+idempotency files, chmod 600 budget
            # files (v0.4.3 GPT-3 fix), chmod 700 the dir.
            _pp_cache_clear_all "$_pp_cache_dir"
            printf 'polymath: cleared lens + tip + idempotency caches in %s (budget files preserved and locked to 600)\n' "$_pp_cache_dir"
            ;;
          *)
            printf 'polymath cache clear: unknown flag %s (use --tips | --orphans | all)\n' "$_pp_clear_what" >&2
            exit 2
            ;;
        esac
        ;;
      *)
        printf 'polymath cache: unknown subcommand %s (use list | clear)\n' "$_pp_cache_sub" >&2
        exit 2
        ;;
    esac
    ;;

  dismiss)
    # v0.5 Phase 3: suppression rules + memory-as-constraint.
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/dismiss.sh"
    shift
    _pp_dismiss_sub="${1:-help}"
    case "$_pp_dismiss_sub" in
      help|-h|--help|"")
        cat <<'USAGE'
Usage: polymath dismiss <command> [args]

Commands:
  polymath dismiss "<reason>" [project|global]          add a rule (default: project)
  polymath dismiss list                                 show active rules
  polymath dismiss show <id>                            print JSON for id
  polymath dismiss disable <id>                         soft-delete
  polymath dismiss enable <id>                          un-delete
  polymath dismiss ack <hash-prefix>                    affirm observation is useful
USAGE
        [ -z "${1:-}" ] && exit 2 || exit 0
        ;;
      list)
        pp_dismiss_list
        ;;
      show)
        [ -n "${2:-}" ] || { printf 'polymath dismiss show: id required\n' >&2; exit 2; }
        pp_dismiss_show "$2"
        ;;
      disable)
        [ -n "${2:-}" ] || { printf 'polymath dismiss disable: id required\n' >&2; exit 2; }
        pp_dismiss_disable "$2" "user_disabled"
        ;;
      enable)
        [ -n "${2:-}" ] || { printf 'polymath dismiss enable: id required\n' >&2; exit 2; }
        pp_dismiss_enable "$2"
        ;;
      ack)
        [ -n "${2:-}" ] || { printf 'polymath dismiss ack: hash-prefix required\n' >&2; exit 2; }
        pp_dismiss_ack "$2"
        ;;
      *)
        # Treat as a reason text (the most common case).
        # Round-2 fix I9: validate scope value at the CLI boundary. Users
        # following the help text might type "scope=global" expecting keyword
        # syntax; silently storing scope="scope=global" never matches a
        # render filter — better to reject loudly.
        _pp_dismiss_scope="${2:-project}"
        case "$_pp_dismiss_scope" in
          project|global) ;;
          *)
            printf 'polymath dismiss: scope must be "project" or "global" (got "%s")\n' "$_pp_dismiss_scope" >&2
            exit 2
            ;;
        esac
        _id=$(pp_dismiss_add "$_pp_dismiss_sub" "$_pp_dismiss_scope")
        printf '%s\n' "$_id"
        ;;
    esac
    ;;

  prompts)
    # v0.5.4 — prompt contract inventory, manifest display, and lint.
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/prompt-contract.sh"
    _pp_prompts_sub="${1:-help}"
    case "$_pp_prompts_sub" in
      list)
        pp_prompt_contract_list
        ;;
      show)
        [ -n "${2:-}" ] || { printf 'polymath prompts show: prompt id required\n' >&2; exit 2; }
        pp_prompt_contract_show "$2"
        ;;
      lint)
        if [ -n "${2:-}" ]; then
          pp_prompt_contract_lint "$2"
        else
          pp_prompt_contract_lint
        fi
        ;;
      help|-h|--help|"")
        cat <<'USAGE'
Usage: polymath prompts <command> [args]

Commands:
  polymath prompts list          list prompt ids, versions, and owners
  polymath prompts show <id>     print one prompt manifest as JSON
  polymath prompts lint [id]     validate all prompt contracts or one prompt
USAGE
        [ -z "${1:-}" ] && exit 2 || exit 0
        ;;
      *)
        printf 'polymath prompts: unknown subcommand "%s". Try: polymath prompts help\n' "$_pp_prompts_sub" >&2
        exit 2
        ;;
    esac
    ;;

  retry-router)
    # v0.5.1 — operator surface for the cost-aware retry router.
    # Subcommands: status (default) | clear-flag | shadow-summary
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/retry-router.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/auto-rollback.sh"
    case "${1:-status}" in
      status)
        printf '\nRetry router\n'
        printf '  Enabled:        %s\n' "${PP_RETRY_ROUTER_ENABLE:-0}"
        printf '  Shadow:         %s\n' "${PP_RETRY_ROUTER_SHADOW:-0}"
        printf '  Canary %%:       %s\n' "${PP_RETRY_ROUTER_CANARY_PCT:-0}"
        if pp_rollback_is_active; then
          # R12 (v0.5.1 Round-2): when rollback is active, surface the
          # information an operator needs to decide what to do — the
          # engage timestamp, current escalation tier, when the backoff
          # expires, and a concrete next-action hint. Read directly from
          # the state files; fail-quiet if a field is missing.
          # Use the lib's path helpers (already sourced via lib/auto-rollback.sh)
          # so we don't drift from the canonical PP_STATE_DIR default
          # ($HOME/.claude/pair-polymath) or the filenames.
          _rb_state=$(_pp_rollback_state_file)
          _rb_flag=$(_pp_rollback_flag_file)
          _rb_engage_ts=""
          _rb_tier="?"
          if [ -f "$_rb_state" ]; then
            _rb_engage_ts=$(jq -r '.last_engage_ts // ""' "$_rb_state" 2>/dev/null)
            _rb_tier=$(jq -r '.disable_count // "?"' "$_rb_state" 2>/dev/null)
          fi
          _rb_expires=""
          if [ -f "$_rb_flag" ]; then
            _rb_expires_epoch=$(head -1 "$_rb_flag" 2>/dev/null | tr -d ' ')
            case "$_rb_expires_epoch" in
              ''|*[!0-9]*) ;;
              *) _rb_expires=$(date -u -r "$_rb_expires_epoch" \
                   +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
                   || date -u -d "@$_rb_expires_epoch" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) ;;
            esac
          fi
          printf '  Rollback:       ACTIVE\n'
          [ -n "$_rb_engage_ts" ] && printf '    Engaged at:   %s\n' "$_rb_engage_ts"
          [ -n "$_rb_expires" ]   && printf '    Backoff until: %s\n' "$_rb_expires"
          printf '    Tier:         %s (disable_count)\n' "$_rb_tier"
          printf '    Next action:  polymath kpi  (investigate)\n'
          printf '                  polymath retry-router clear-flag  (when safe)\n'
        else
          printf '  Rollback:       not active\n'
        fi
        printf '\n'
        ;;
      clear-flag)
        pp_rollback_clear
        printf 'Rollback flag cleared.\n'
        ;;
      shadow-summary)
        # R14 (v0.5.1 Round-2): give the operator a go/no-go signal, not
        # just drop-reason counts. The shadow log row now carries
        # est_cost_baseline + est_cost_shadow; sum them into a projected
        # savings number and recommend whether to advance to canary.
        # Threshold default 20% (PP_RETRY_CANARY_GO_PCT).
        shift  # drop "shadow-summary"
        _ss_json=0
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --json) _ss_json=1; shift ;;
            *) shift ;;
          esac
        done
        _shadow="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/retry-router-shadow.jsonl"
        if [ ! -f "$_shadow" ]; then
          printf 'No shadow data yet. Enable with PP_RETRY_ROUTER_SHADOW=1.\n'
          exit 0
        fi
        # By-class counts (legacy view, preserved for compatibility).
        _ss_classes=$(jq -R 'fromjson?' "$_shadow" 2>/dev/null \
          | jq -s '
              sort_by(.drop_reason_class)
              | group_by(.drop_reason_class)
              | map({class: .[0].drop_reason_class, count: length})
            ' 2>/dev/null)
        # Projected savings rollup. Rows lacking the new cost fields
        # (legacy / pre-R14) contribute 0 to both sums — they show up in
        # counts but don't poison the projection.
        _ss_proj=$(jq -R 'fromjson?' "$_shadow" 2>/dev/null \
          | jq -s '
              (map(.est_cost_baseline // 0) | add // 0) as $b
              | (map(.est_cost_shadow   // 0) | add // 0) as $s
              | (length) as $n
              | ((map(select(.est_cost_baseline != null)) | length)) as $with_cost
              | { rows: $n,
                  rows_with_cost: $with_cost,
                  est_baseline_usd: $b,
                  est_shadow_usd:   $s,
                  projected_savings_usd: ($b - $s),
                  projected_savings_pct:
                    (if $b > 0 then ((($b - $s) / $b) * 100) else 0 end) }
            ' 2>/dev/null)
        _ss_go_pct="${PP_RETRY_CANARY_GO_PCT:-20}"
        case "$_ss_go_pct" in ''|*[!0-9]*) _ss_go_pct=20 ;; esac
        _ss_pct=$(printf '%s' "$_ss_proj" | jq -r '.projected_savings_pct // 0' 2>/dev/null)
        _ss_rows_with_cost=$(printf '%s' "$_ss_proj" | jq -r '.rows_with_cost // 0' 2>/dev/null)
        # Recommendation: need at least 20 cost-bearing rows AND pct >= threshold.
        _ss_rec="keep collecting shadow data"
        if [ "${_ss_rows_with_cost:-0}" -ge 20 ] \
           && LC_ALL=C awk -v p="$_ss_pct" -v t="$_ss_go_pct" \
              'BEGIN { exit !(p+0 >= t+0) }' 2>/dev/null; then
          _ss_rec="enable canary"
        fi
        if [ "$_ss_json" = "1" ]; then
          printf '%s' "$_ss_proj" | jq --argjson classes "${_ss_classes:-[]}" \
            --arg rec "$_ss_rec" --argjson go_pct "$_ss_go_pct" \
            '. + {by_class: $classes, recommendation: $rec, go_threshold_pct: $go_pct}'
        else
          printf '\nShadow-mode rollup\n'
          printf '  Rows total:          %s\n' \
            "$(printf '%s' "$_ss_proj" | jq -r '.rows // 0')"
          printf '  Rows with cost data: %s\n' "${_ss_rows_with_cost:-0}"
          printf '  Est baseline spend:  $%s\n' \
            "$(printf '%s' "$_ss_proj" | jq -r '.est_baseline_usd // 0 | tostring' \
                | awk '{ printf "%.6f", $1 }')"
          printf '  Est shadow spend:    $%s\n' \
            "$(printf '%s' "$_ss_proj" | jq -r '.est_shadow_usd // 0 | tostring' \
                | awk '{ printf "%.6f", $1 }')"
          printf '  Projected savings:   $%s (%.2f%%)\n' \
            "$(printf '%s' "$_ss_proj" | jq -r '.projected_savings_usd // 0 | tostring' \
                | awk '{ printf "%.6f", $1 }')" "${_ss_pct:-0}"
          printf '  By-class counts:\n'
          printf '%s' "$_ss_classes" | jq -r '.[] | "    \(.class): \(.count)"' 2>/dev/null
          printf '\n  → recommendation: %s\n' "$_ss_rec"
          printf '    (threshold: ≥%s%% projected savings AND ≥20 cost-bearing rows)\n\n' \
            "$_ss_go_pct"
        fi
        ;;
      *)
        printf 'polymath retry-router: unknown subcommand %s\n' "$1" >&2
        exit 2
        ;;
    esac
    ;;

  lens-gates)
    # v0.5.1.1 Stage D (Task 14b) — operator surface for the four
    # planner-grounding kill-switches. Mirrors `polymath retry-router`
    # ergonomics: status (default) reads current values from user.env;
    # enable/disable mutate via _pp_set_user_env_var (the existing
    # symlink-aware atomic helper at bin/polymath:45).
    #
    # SECURITY BOUNDARY: closed allowlist of writable flags. Without it,
    # a caller could pivot this CLI into arbitrary env-var writes —
    # e.g. set PP_EXTERNAL_LLM=1 to bypass `polymath disable`, or unset
    # safety limits. Unknown flag names are rejected with exit 2.
    shift
    _pp_lg_subcmd="${1:-status}"
    _pp_lg_known="PP_LENS_GATES_TELEMETRY PP_INVENTORY_UNIFY_ACTIVE PP_SILENT_V2_ACTIVE PP_LENS_GATES_ACTIVE"
    case "$_pp_lg_subcmd" in
      status)
        # Source user.env if present so current values reflect overlay,
        # not just baked-in defaults. config/default.env has already been
        # sourced by lib/config.sh on shell entry; user.env is the
        # operator-mutated overlay we're inspecting.
        _pp_lg_user_env="${PP_USER_CONFIG:-${PP_STATE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/pair-polymath}/config/user.env}"
        if [ -f "$_pp_lg_user_env" ]; then
          # shellcheck disable=SC1090
          . "$_pp_lg_user_env" 2>/dev/null || true
        fi
        printf '\nPair Polymath — lens gates (v0.5.1.1)\n\n'
        printf '  PP_LENS_GATES_TELEMETRY:   %s   (shadow signal — all 7 KPI fields + would_be_ineligible)\n' \
          "${PP_LENS_GATES_TELEMETRY:-0}"
        printf '  PP_INVENTORY_UNIFY_ACTIVE: %s   (prompt block switches to FILE-READ-only + NEARBY MENTIONS)\n' \
          "${PP_INVENTORY_UNIFY_ACTIVE:-0}"
        printf '  PP_SILENT_V2_ACTIVE:       %s   (SILENT recognised pre-critique; closed-enum silent_reason)\n' \
          "${PP_SILENT_V2_ACTIVE:-0}"
        printf '  PP_LENS_GATES_ACTIVE:      %s   (router filters ineligible lenses + draws replacements)\n' \
          "${PP_LENS_GATES_ACTIVE:-0}"
        printf '\n'
        printf 'Operator surface:\n'
        printf '  polymath lens-gates enable <flag>     Set <flag>=1 in user.env\n'
        printf '  polymath lens-gates disable <flag>    Set <flag>=0 in user.env\n'
        printf '\nSee docs/v0.5.1.1-planner-grounding-fix-spec.md for the full rollout playbook.\n\n'
        ;;
      enable|disable)
        _pp_lg_flag="${2:-}"
        if [ -z "$_pp_lg_flag" ]; then
          printf 'polymath lens-gates %s: missing <flag>\n' "$_pp_lg_subcmd" >&2
          printf 'Known flags: %s\n' "$_pp_lg_known" >&2
          exit 2
        fi
        # Validate flag is in the closed allowlist (security boundary).
        _pp_lg_ok=0
        for _pp_lg_k in $_pp_lg_known; do
          if [ "$_pp_lg_k" = "$_pp_lg_flag" ]; then
            _pp_lg_ok=1
            break
          fi
        done
        if [ "$_pp_lg_ok" -ne 1 ]; then
          printf 'polymath lens-gates: unknown flag %s\n' "$_pp_lg_flag" >&2
          printf 'Known flags: %s\n' "$_pp_lg_known" >&2
          exit 2
        fi
        if [ "$_pp_lg_subcmd" = "enable" ]; then
          _pp_set_user_env_var "$_pp_lg_flag" 1 || exit 1
          printf '%s enabled (user.env updated).\n' "$_pp_lg_flag"
        else
          _pp_set_user_env_var "$_pp_lg_flag" 0 || exit 1
          printf '%s disabled (user.env updated).\n' "$_pp_lg_flag"
        fi
        ;;
      *)
        printf 'polymath lens-gates: unknown subcommand %s\n' "$_pp_lg_subcmd" >&2
        printf 'Try: status | enable <flag> | disable <flag>\n' >&2
        exit 2
        ;;
    esac
    ;;

  history)
    # v0.5.2 (Task 14) — OAR observation outcomes (spec §D).
    #
    # Reads oar-labeled.jsonl (+ rotated .1) AND oar-pending.jsonl (latter
    # for "still in scan window" count). Computes per-lens acted% with
    # Wilson 95% CI (TWO-SIDED z=1.96 via pp_kpi_wilson_lower_95 — addresses
    # the spec §D example floor of 6.4% which used one-sided z=1.645; the
    # implementation displays 8.2% for 2/7 because two-sided is the right
    # interpretation for downstream gating, per Task 10).
    #
    # Addendum M3: per-lens JSON is built via jq -n --arg/--argjson rather
    # than printf string-concat, so lens names with unusual characters
    # cannot break the JSON output.
    shift
    _h_window=7
    _h_lens=""
    _h_outcome=""
    _h_json=0
    _h_all_projects=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --window)
          [ -n "${2:-}" ] || { printf 'polymath history: --window requires a value (e.g. 7d)\n' >&2; exit 2; }
          _h_window="${2%d}"
          case "$_h_window" in
            ''|*[!0-9]*|0)
              printf 'polymath history: --window must be a positive integer number of days (e.g. 7 or 7d)\n' >&2
              exit 2
              ;;
          esac
          shift 2
          ;;
        --lens)
          [ -n "${2:-}" ] || { printf 'polymath history: --lens requires a value\n' >&2; exit 2; }
          _h_lens="$2"; shift 2 ;;
        --outcome)
          [ -n "${2:-}" ] || { printf 'polymath history: --outcome requires a value\n' >&2; exit 2; }
          case "$2" in
            acted|referenced|pushed-back|ignored|silent|all) _h_outcome="$2"; shift 2 ;;
            *) printf 'polymath history: invalid --outcome %s (acted|referenced|pushed-back|ignored|silent|all)\n' "$2" >&2; exit 2 ;;
          esac
          ;;
        --json) _h_json=1; shift ;;
        --all-projects) _h_all_projects=1; shift ;;
        -h|--help)
          cat <<HELP
polymath history — Observation outcomes (OAR labeler results)

Usage:
  polymath history                       7-day rollup, all lenses, all outcomes
  polymath history --window 30d          Custom rolling window (positive int days)
  polymath history --lens SECURITY       Filter to one lens
  polymath history --outcome acted       Filter to one outcome class
                                          (acted|referenced|pushed-back|ignored|silent|all)
  polymath history --json                Machine-readable JSON
  polymath history --all-projects        Explicit cross-project reporting

Filters compose: --lens narrows the rows BEFORE per-lens grouping;
--outcome narrows AFTER --lens. Wilson 95% CI lower bound (two-sided z)
shown per lens via pp_kpi_wilson_lower_95.

By default, history reports only the current project. Use --all-projects
when auditing old mixed global telemetry.

Empty-state hint: enable with PP_OAR_ENABLE=1 in user.env and run
sessions for at least one scan-window (24h ENG/SEC/PERF, 48h UX, 7d
Product/Founder). Manual catchup: polymath oar-label --all-due
HELP
          exit 0
          ;;
        *) printf 'polymath history: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    _h_cache_dir="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}"
    _h_labeled="${_h_cache_dir}/oar-labeled.jsonl"
    _h_pending="${_h_cache_dir}/oar-pending.jsonl"
    _h_stuck="${_h_cache_dir}/oar-stuck.jsonl"
    _h_project_id=""
    if command -v pp_project_id >/dev/null 2>&1; then
      _h_project_id=$(pp_project_id "${CLAUDE_PROJECT_DIR:-$PWD}" 2>/dev/null || printf '')
    fi
    if [ ! -f "$_h_labeled" ] && [ ! -f "${_h_labeled}.1" ]; then
      printf 'No labeled observations yet. Enable with: PP_OAR_ENABLE=1 in user.env,\n'
      printf 'then run sessions for >= scan-window hours (24h-7d depending on lens).\n'
      printf 'Manual catchup: polymath oar-label --all-due\n'
      exit 0
    fi

    # Portable BSD/GNU date for the cutoff epoch.
    _h_cutoff=$(date -u -v "-${_h_window}d" +%s 2>/dev/null \
              || date -u -d "${_h_window} days ago" +%s 2>/dev/null \
              || printf '0')

    # shellcheck source=lib/metrics.sh disable=SC1091
    . "$PP_ROOT/lib/metrics.sh"

    # Read labeled rows (current + rotated). Filter by window + optional
    # --lens + --outcome. The cat-of-missing-file emits stderr — silence
    # only stderr so a real jq error still surfaces.
    #
    # GPT-review #5: build TWO row sets — one with --outcome filter for
    # totals/per-outcome stats, one WITHOUT --outcome for per-lens stats
    # (top lenses by acted%). Without this split, --outcome=acted makes
    # every lens display 100% acted (because the filter pre-removed
    # every non-acted row). --lens filter applies to both (the report's
    # scope IS that lens regardless of outcome breakdown).
    _h_rows_unfiltered=$( { cat "${_h_labeled}.1" "$_h_labeled" 2>/dev/null; } \
              | jq -R 'fromjson?' 2>/dev/null \
              | jq -s --argjson cut "$_h_cutoff" --arg lens "$_h_lens" --arg project_id "$_h_project_id" --argjson all_projects "$_h_all_projects" '
                  map(select((.labeled_at | fromdateiso8601? // 0) >= $cut))
                  | (if ($all_projects == 1 or $project_id == "") then . else map(select(.project_id == $project_id)) end)
                  | (if $lens != "" then map(select(.lens == $lens)) else . end)
                ' 2>/dev/null)
    [ -n "$_h_rows_unfiltered" ] || _h_rows_unfiltered='[]'
    # _h_rows applies the additional --outcome filter on top.
    _h_rows=$(printf '%s' "$_h_rows_unfiltered" \
              | jq --arg out "$_h_outcome" '
                  if $out != "" and $out != "all" then map(select(.outcome == $out)) else . end
                ' 2>/dev/null)
    [ -n "$_h_rows" ] || _h_rows='[]'

    _h_pending_count=0
    _h_pending_in_window=0
    _h_pending_due=0
    if [ -f "$_h_pending" ]; then
      _h_now=$(date +%s 2>/dev/null || printf '0')
      case "$_h_now" in ''|*[!0-9]*) _h_now=0 ;; esac
      _h_pending_stats=$(jq -R 'fromjson?' "$_h_pending" 2>/dev/null \
                        | jq -s --arg lens "$_h_lens" --arg project_id "$_h_project_id" --argjson all_projects "$_h_all_projects" --argjson now "$_h_now" '
                            map(select(.scan_at_epoch != null))
                            | (if ($all_projects == 1 or $project_id == "") then . else map(select(.project_id == $project_id)) end)
                            | (if $lens != "" then map(select(.lens == $lens)) else . end)
                            | {total:length,
                               in_window:(map(select((.scan_at_epoch // 0) > $now)) | length),
                               due:(map(select((.scan_at_epoch // 0) <= $now)) | length)}
                          ' 2>/dev/null)
      [ -n "$_h_pending_stats" ] || _h_pending_stats='{"total":0,"in_window":0,"due":0}'
      _h_pending_count=$(printf '%s' "$_h_pending_stats" | jq -r '.total // 0' 2>/dev/null)
      _h_pending_in_window=$(printf '%s' "$_h_pending_stats" | jq -r '.in_window // 0' 2>/dev/null)
      _h_pending_due=$(printf '%s' "$_h_pending_stats" | jq -r '.due // 0' 2>/dev/null)
      case "$_h_pending_count" in ''|*[!0-9]*) _h_pending_count=0 ;; esac
      case "$_h_pending_in_window" in ''|*[!0-9]*) _h_pending_in_window=0 ;; esac
      case "$_h_pending_due" in ''|*[!0-9]*) _h_pending_due=0 ;; esac
    fi
    _h_stuck_count=0
    if [ -f "$_h_stuck" ]; then
      _h_stuck_count=$(jq -R 'fromjson?' "$_h_stuck" 2>/dev/null \
                      | jq -s --arg lens "$_h_lens" --arg project_id "$_h_project_id" --argjson all_projects "$_h_all_projects" '
                          if ($all_projects == 1 or $project_id == "") then . else map(select(.project_id == $project_id)) end
                          |
                          if $lens != "" then map(select(.lens == $lens)) else . end
                          | length' 2>/dev/null)
      case "$_h_stuck_count" in ''|*[!0-9]*) _h_stuck_count=0 ;; esac
    fi

    # Per-lens grouping: emit "lens\tn_non_silent\tacted\tsilent" rows.
    # Build per-lens JSON via jq -n --arg/--argjson (addendum M3) so a
    # lens name like ' "quote" ' or ' \backslash ' cannot break the JSON.
    #
    # GPT-review #1: sort_by(.lens) BEFORE group_by. Without the sort,
    # non-contiguous rows for the same lens get split into separate
    # groups → wrong n/acted counts. Project-canonical fix (matches
    # lib/dismiss.sh:108 and the shadow-summary fix from v0.5.1).
    #
    # GPT-review #5: --outcome filter applied upstream to _h_rows would
    # make "Top lenses by acted%" meaningless (e.g., --outcome acted
    # makes every lens show 100% acted). Per-lens stats must be
    # computed from the UNFILTERED window — use _h_rows_for_lens which
    # is built without the outcome filter when outcome != all.
    _h_lens_src="$_h_rows"
    if [ -n "${_h_rows_unfiltered:-}" ]; then
      _h_lens_src="$_h_rows_unfiltered"
    fi
    _h_per_lens_tsv=$(printf '%s' "$_h_lens_src" | jq -r '
      sort_by(.lens) | group_by(.lens)
      | .[]
      | "\(.[0].lens)\t\(map(select(.outcome != "silent")) | length)\t\(map(select(.outcome == "acted")) | length)\t\(map(select(.outcome == "silent")) | length)"
    ' 2>/dev/null)
    _h_per_lens_json='[]'
    if [ -n "$_h_per_lens_tsv" ]; then
      _h_tab=$(printf '\t')
      _h_per_lens_json=$(
        printf '%s\n' "$_h_per_lens_tsv" | while IFS="$_h_tab" read -r _h_lname _h_n _h_acted _h_silent; do
          [ -n "$_h_lname" ] || continue
          # Defensive int-coerce: an empty / non-numeric field becomes 0.
          # Avoid `expr "$x" + 0 || printf 0`: expr exits 1 for a numeric
          # zero result, which concatenates two zeroes into invalid JSON.
          _h_n=$(printf '%s' "$_h_n" | LC_ALL=C tr -cd '0-9')
          _h_acted=$(printf '%s' "$_h_acted" | LC_ALL=C tr -cd '0-9')
          _h_silent=$(printf '%s' "${_h_silent:-}" | LC_ALL=C tr -cd '0-9')
          [ -n "$_h_n" ] || _h_n=0
          [ -n "$_h_acted" ] || _h_acted=0
          [ -n "$_h_silent" ] || _h_silent=0
          _h_lo=$(pp_kpi_wilson_lower_95 "$_h_acted" "$_h_n")
          _h_pct=$(LC_ALL=C awk -v a="$_h_acted" -v n="$_h_n" \
                     'BEGIN { if (n+0==0) print 0; else printf "%.4f", a/n }')
          jq -nc \
            --arg lens "$_h_lname" \
            --argjson n "$_h_n" \
            --argjson acted "$_h_acted" \
            --argjson silent "$_h_silent" \
            --argjson acted_pct "$_h_pct" \
            --argjson wilson "$_h_lo" \
            '{lens:$lens, n:$n, acted:$acted, silent:$silent, acted_pct:$acted_pct, wilson_lower_95:$wilson}'
        done | jq -s '.'
      )
      [ -n "$_h_per_lens_json" ] || _h_per_lens_json='[]'
    fi

    _h_summary=$(printf '%s' "$_h_rows" | jq \
                  --argjson per_lens "$_h_per_lens_json" \
                  --argjson pending "$_h_pending_count" \
                  --argjson pending_in_window "$_h_pending_in_window" \
                  --argjson pending_due "$_h_pending_due" \
                  --argjson stuck "$_h_stuck_count" \
                  --arg project_id "$_h_project_id" \
                  --argjson all_projects "$_h_all_projects" \
                  --argjson window "$_h_window" '
        (map(select(.outcome != "silent"))) as $eligible |
        {
          total: length,
          eligible: ($eligible | length),
          pending: $pending,
          pending_in_window: $pending_in_window,
          pending_due: $pending_due,
          stuck: $stuck,
          project_id: (if $project_id == "" then null else $project_id end),
          all_projects: ($all_projects == 1),
          window_days: $window,
          by_outcome: {
            acted:       (map(select(.outcome == "acted"))       | length),
            referenced:  (map(select(.outcome == "referenced"))  | length),
            "pushed-back": (map(select(.outcome == "pushed-back")) | length),
            ignored:     (map(select(.outcome == "ignored"))     | length),
            silent:      (map(select(.outcome == "silent"))      | length)
          },
          acted_pct:      (if ($eligible | length) == 0 then 0 else ((map(select(.outcome == "acted"))       | length) / ($eligible | length)) end),
          referenced_pct: (if ($eligible | length) == 0 then 0 else ((map(select(.outcome == "referenced"))  | length) / ($eligible | length)) end),
          derived_a_plus_r: (if ($eligible | length) == 0 then 0 else ((map(select(.outcome == "acted" or .outcome == "referenced")) | length) / ($eligible | length)) end),
          prompt_versions_seen: (map(.prompt_versions // {}) | reduce .[] as $pv ({}; . * $pv)),
          missing_prompt_versions_count: (
            map(select(
              ((.schema_version // 1) >= 2)
              and ((.prompt_versions // null) as $pv
                | if ($pv | type) != "object" then true
                  else (($pv["analyst-primary"] | type != "string") or ($pv["critique"] | type != "string"))
                  end
              )
            )) | length
          ),
          by_lens: $per_lens
        }')

    if [ "$_h_json" = "1" ]; then
      printf '%s\n' "$_h_summary"
    else
      printf '\nObservation outcomes (last %s days)\n\n' "$_h_window"
      if [ "$_h_all_projects" = "1" ]; then
        printf '  Project scope:         all projects\n'
      elif [ -n "$_h_project_id" ]; then
        printf '  Project scope:         current (%s)\n' "$_h_project_id"
      fi
      printf '%s' "$_h_summary" | jq -r '
        "  Total observations:    \(.total)",
        "  Eligible (non-silent): \(.eligible)      (\(.pending_in_window) still in scan window, \(.pending_due) due)",
        "  Stuck (quarantined):   \(.stuck)      (see: polymath doctor)",
        "",
        "  By outcome:",
        "    acted:               \(.by_outcome.acted)      (\((.acted_pct * 1000 | floor) / 10)%)  ← code change touched a citation",
        "    referenced:          \(.by_outcome.referenced)      (\((.referenced_pct * 1000 | floor) / 10)%)  ← transcript mention",
        "    pushed-back:         \(.by_outcome."pushed-back")      (operator dismiss ack)",
        "    ignored:             \(.by_outcome.ignored)      (no signal within window)",
        "    silent:              \(.by_outcome.silent)      (no eligible surface)",
        "",
        "  Derived: A+R = \((.derived_a_plus_r * 1000 | floor) / 10)%",
        "  (Note: A and R measure DIFFERENT things — A = behavior change, R = attention.",
        "   Report them separately when making decisions.)"
      '
      if [ -n "$_h_per_lens_tsv" ]; then
        printf '\n  Top lenses by acted%%:\n'
        printf '%s' "$_h_summary" | jq -r '
          .by_lens
          | sort_by(-.acted_pct)
          | .[]
          | "    \(.lens):   \((.acted_pct * 1000 | floor) / 10)%  (\(.acted)/\(.n) acted; Wilson 95% CI lower: \((.wilson_lower_95 * 1000 | floor) / 10)%)"
        '
      fi
      printf '\n  → For dismiss rules:   polymath dismiss list\n'
      printf '  → Catch up labeling:  polymath oar-label --all-due\n\n'
    fi
    ;;

  oar)
    shift
    _oar_sub="${1:-}"
    case "$_oar_sub" in
      bootstrap)
        shift
        _ob_cmd="${1:-report}"
        shift || true
        _ob_dir=""
        _ob_json=0
        _ob_all_projects=0
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --dir)
              [ -n "${2:-}" ] || { printf 'polymath oar bootstrap: --dir requires a path\n' >&2; exit 2; }
              _ob_dir="$2"; shift 2 ;;
            --json) _ob_json=1; shift ;;
            --all-projects) _ob_all_projects=1; shift ;;
            -h|--help)
              cat <<HELP
polymath oar bootstrap — Historical advisory bootstrap dataset

Usage:
  polymath oar bootstrap scan [--dir PATH]
  polymath oar bootstrap report [--json] [--all-projects]

Bootstrap rows are stored separately from live OAR at:
  \$PP_STATE_DIR/oar/bootstrap-labeled.jsonl
HELP
              exit 0
              ;;
            *) printf 'polymath oar bootstrap: unknown flag %s\n' "$1" >&2; exit 2 ;;
          esac
        done
        # shellcheck source=lib/oar-bootstrap.sh disable=SC1091
        . "$PP_ROOT/lib/oar-bootstrap.sh"
        case "$_ob_cmd" in
          scan)
            if [ -n "$_ob_dir" ]; then
              pp_oar_bootstrap_scan "$_ob_dir"
            else
              pp_oar_bootstrap_scan
            fi
            ;;
          report)
            pp_oar_bootstrap_report "$_ob_json" "$_ob_all_projects"
            ;;
          *)
            printf 'polymath oar bootstrap: unknown subcommand %s\n' "$_ob_cmd" >&2
            printf '  Try: polymath oar bootstrap scan | report\n' >&2
            exit 2
            ;;
        esac
        ;;
      -h|--help|"")
        cat <<HELP
polymath oar — Observation/action-rate tools

Usage:
  polymath oar bootstrap scan [--dir PATH]
  polymath oar bootstrap report [--json] [--all-projects]
  polymath oar-label --all-due
HELP
        ;;
      *)
        printf 'polymath oar: unknown subcommand %s\n' "$_oar_sub" >&2
        printf '  Try: polymath oar bootstrap scan | report\n' >&2
        exit 2
        ;;
    esac
    ;;

  insights)
    shift
    _ins_sub="${1:-score}"
    shift || true
    case "$_ins_sub" in
      score)
        _ins_window=7
        _ins_json=0
        _ins_all_projects=0
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --window)
              [ -n "${2:-}" ] || { printf 'polymath insights score: --window requires a value (e.g. 7d)\n' >&2; exit 2; }
              _ins_window="${2%d}"
              case "$_ins_window" in ''|*[!0-9]*|0) printf 'polymath insights score: --window must be a positive integer number of days\n' >&2; exit 2 ;; esac
              shift 2 ;;
            --json) _ins_json=1; shift ;;
            --all-projects) _ins_all_projects=1; shift ;;
            -h|--help)
              cat <<HELP
polymath insights score — Score advisory usefulness and noise

Usage:
  polymath insights score [--window 7d] [--json] [--all-projects]

Scores live OAR rows plus historical bootstrap rows. Stored score rows contain
hashes, redacted snippets, feature flags, and evidence references, not raw
transcript archives.
HELP
              exit 0
              ;;
            *) printf 'polymath insights score: unknown flag %s\n' "$1" >&2; exit 2 ;;
          esac
        done
        # shellcheck source=lib/insights-score.sh disable=SC1091
        . "$PP_ROOT/lib/insights-score.sh"
        pp_insights_score "$_ins_window" "$_ins_json" "$_ins_all_projects"
        ;;
      -h|--help|"")
        cat <<HELP
polymath insights — Insight quality tools

Usage:
  polymath insights score [--window 7d] [--json] [--all-projects]
HELP
        ;;
      *)
        printf 'polymath insights: unknown subcommand %s\n' "$_ins_sub" >&2
        printf '  Try: polymath insights score\n' >&2
        exit 2
        ;;
    esac
    ;;

  oar-label)
    # v0.5.2 (Task 15) — manual catchup labeler (spec §B + §D).
    #
    # Bypasses the inline per-cycle cap (PP_OAR_LABEL_PER_CYCLE_CAP=5) so an
    # operator can drain a backlog without waiting for natural cycles. The
    # per-row 3s timeout (PP_OAR_ROW_TIMEOUT_S) still applies — bounded work
    # per row, no global timeout.
    #
    # --limit N is an additional defensive ceiling (env override OF the
    # per-cycle cap via argument; takes precedence over PP_OAR_LABEL_PER_CYCLE_CAP
    # in the env because we re-export it inside this case).
    shift
    _ol_all_due=0
    _ol_limit=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --all-due) _ol_all_due=1; shift ;;
        --limit)
          [ -n "${2:-}" ] || { printf 'polymath oar-label: --limit requires a value\n' >&2; exit 2; }
          # Strip a leading + (positive sign) but reject 0, non-numeric,
          # and any string with a `-` (so `-5` fails the numeric class).
          case "$2" in
            ''|*[!0-9]*|0)
              printf 'polymath oar-label: --limit must be a positive integer\n' >&2
              exit 2
              ;;
          esac
          _ol_limit="$2"
          shift 2
          ;;
        -h|--help)
          cat <<HELP
polymath oar-label — Manually label pending OAR rows

Usage:
  polymath oar-label --all-due           Process all due rows now
                                         (bypasses PP_OAR_LABEL_PER_CYCLE_CAP=5)
  polymath oar-label --all-due --limit N Cap manual run at N rows
                                         (positive integer)

Per-row 3s timeout still applies (PP_OAR_ROW_TIMEOUT_S).

Use after enabling PP_OAR_ENABLE=1 to drain a backlog from a
long-running session, or before running 'polymath history' to make
sure recent observations are reflected in the rollup.
HELP
          exit 0
          ;;
        *)
          printf 'polymath oar-label: unknown flag %s\n' "$1" >&2
          exit 2
          ;;
      esac
    done
    if [ "$_ol_all_due" != "1" ]; then
      printf 'polymath oar-label: --all-due is required\n' >&2
      printf '  Try: polymath oar-label --all-due [--limit N]\n' >&2
      exit 2
    fi

    _ol_cache_dir="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}"
    _ol_pending="${_ol_cache_dir}/oar-pending.jsonl"
    _ol_labeled="${_ol_cache_dir}/oar-labeled.jsonl"
    _ol_stuck="${_ol_cache_dir}/oar-stuck.jsonl"
    mkdir -p "$_ol_cache_dir" 2>/dev/null || true

    # Empty-state: no pending file OR pending file is zero-byte. Exit 0
    # with a friendly hint rather than calling the driver (which would
    # also return 0 silently).
    if [ ! -s "$_ol_pending" ]; then
      printf 'oar-label: no pending observations to process.\n'
      printf '  Enable with: PP_OAR_ENABLE=1 in user.env, then run sessions.\n'
      printf '  See current state: polymath history\n'
      exit 0
    fi

    # Pre-snapshot counts so the summary line can report deltas accurately.
    _ol_labeled_before=0
    if [ -f "$_ol_labeled" ]; then
      _ol_labeled_before=$(wc -l < "$_ol_labeled" 2>/dev/null | tr -d ' ')
      case "$_ol_labeled_before" in ''|*[!0-9]*) _ol_labeled_before=0 ;; esac
    fi
    _ol_stuck_before=0
    if [ -f "$_ol_stuck" ]; then
      _ol_stuck_before=$(wc -l < "$_ol_stuck" 2>/dev/null | tr -d ' ')
      case "$_ol_stuck_before" in ''|*[!0-9]*) _ol_stuck_before=0 ;; esac
    fi

    # Cap selection: --limit takes precedence over any inherited env value.
    # Without --limit we set a very large ceiling — still bounded in practice
    # by pending file size and the per-row 3s timeout (at 3s/row, draining
    # 999999 rows would take ~35 days, so "unbounded" is hyperbole, but the
    # only realistic stop conditions are pending-empty or operator Ctrl-C).
    if [ -n "$_ol_limit" ]; then
      PP_OAR_LABEL_PER_CYCLE_CAP="$_ol_limit"
    else
      PP_OAR_LABEL_PER_CYCLE_CAP=999999
    fi
    export PP_OAR_LABEL_PER_CYCLE_CAP

    # Export PP_CACHE_DIR so the labeler resolves the same paths we just
    # measured (defends against CLAUDE_DIR vs PP_CACHE_DIR drift).
    PP_CACHE_DIR="$_ol_cache_dir"
    export PP_CACHE_DIR

    # shellcheck source=lib/oar.sh disable=SC1091
    . "$PP_ROOT/lib/oar.sh"

    pp_oar_label_pending || true

    # Post-snapshot counts.
    _ol_labeled_after=0
    if [ -f "$_ol_labeled" ]; then
      _ol_labeled_after=$(wc -l < "$_ol_labeled" 2>/dev/null | tr -d ' ')
      case "$_ol_labeled_after" in ''|*[!0-9]*) _ol_labeled_after=0 ;; esac
    fi
    _ol_stuck_after=0
    if [ -f "$_ol_stuck" ]; then
      _ol_stuck_after=$(wc -l < "$_ol_stuck" 2>/dev/null | tr -d ' ')
      case "$_ol_stuck_after" in ''|*[!0-9]*) _ol_stuck_after=0 ;; esac
    fi
    _ol_pending_after=0
    if [ -f "$_ol_pending" ]; then
      _ol_pending_after=$(wc -l < "$_ol_pending" 2>/dev/null | tr -d ' ')
      case "$_ol_pending_after" in ''|*[!0-9]*) _ol_pending_after=0 ;; esac
    fi

    _ol_labeled_delta=$(( _ol_labeled_after - _ol_labeled_before ))
    _ol_stuck_delta=$(( _ol_stuck_after - _ol_stuck_before ))
    # Defensive clamps: deltas should never be negative (labeled.jsonl is
    # append-only), but a concurrent rotation could in principle reduce
    # the count. Clamp to >=0 so the summary stays sensible.
    [ "$_ol_labeled_delta" -lt 0 ] && _ol_labeled_delta=0
    [ "$_ol_stuck_delta" -lt 0 ] && _ol_stuck_delta=0

    printf 'Labeled %s rows; %s stuck; %s still pending.\n' \
      "$_ol_labeled_delta" "$_ol_stuck_delta" "$_ol_pending_after"
    ;;

  kpi)
    # v0.5.1 — rolling cost / retry / phase summary from kpi-cycle.jsonl.
    # Default window 7 days. --window Nd to override. --json for machine output.
    shift
    _kpi_window=7
    _kpi_json=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --window)
          [ -n "${2:-}" ] || { printf 'polymath kpi: --window requires a value (e.g. 7d)\n' >&2; exit 2; }
          _kpi_window="${2%d}"
          # R7: validate window is a positive integer. Without this, a
          # typo like `--window garbage` strips no `d`, then the later
          # `$(( _kpi_window * 24 ))` raises an unbound-variable bash
          # error and silently exits 0.
          case "$_kpi_window" in
            ''|*[!0-9]*|0)
              printf 'polymath kpi: --window must be a positive integer number of days (e.g. 7 or 7d)\n' >&2
              exit 2
              ;;
          esac
          shift 2
          ;;
        --json) _kpi_json=1; shift ;;
        *) shift ;;
      esac
    done
    _kpi_file="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/kpi-cycle.jsonl"
    # B4 (v0.5.1): also read the rotated .1 file — otherwise the rolling
    # window is silently lost the moment kpi-cycle.jsonl rotates.
    if [ ! -f "$_kpi_file" ] && [ ! -f "${_kpi_file}.1" ]; then
      printf 'No KPI data yet. Enable with: PP_KPI_ENABLE=1 in user.env\n'
      exit 0
    fi
    # Portable BSD/GNU date for the cutoff epoch.
    _cutoff_epoch=$(date -u -v "-${_kpi_window}d" +%s 2>/dev/null \
      || date -u -d "${_kpi_window} days ago" +%s 2>/dev/null \
      || printf '0')
    # B4 (v0.5.1): retry_usd reported as rolling-window p95 (not plain avg).
    # pp_kpi_compute_p95 reads current + rotated file and honors the window.
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/metrics.sh"
    _kpi_window_hours=$(( _kpi_window * 24 ))
    _retry_usd_p95=$(pp_kpi_compute_p95 retry_usd "$_kpi_window_hours" 2>/dev/null)
    case "$_retry_usd_p95" in ''|*[!0-9.]*) _retry_usd_p95=0 ;; esac
    _summary=$(cat "${_kpi_file}.1" "$_kpi_file" 2>/dev/null | jq -s \
      --argjson cutoff "$_cutoff_epoch" --argjson retry_usd_p95 "$_retry_usd_p95" '
      map(select((.ts | fromdateiso8601? // 0) >= $cutoff))
      | {
          cycles: length,
          total_usd: (map(.cost_usd // 0) | add // 0),
          avg_per_cycle: ((map(.cost_usd // 0) | add // 0) / (length | if . == 0 then 1 else . end)),
          retry_avg: ((map(.retry_count // 0) | add // 0) / (length | if . == 0 then 1 else . end)),
          retry_usd_p95: $retry_usd_p95,
          phase_classified_pct: ((map(select(.phase_source == "pattern" or .phase_source == "fallback")) | length) * 100 / (length | if . == 0 then 1 else . end))
        }
    ' 2>/dev/null) || _summary='{"cycles":0,"total_usd":0,"avg_per_cycle":0,"retry_avg":0,"retry_usd_p95":0,"phase_classified_pct":0}'
    if [ "$_kpi_json" = "1" ]; then
      printf '%s\n' "$_summary"
    else
      printf '\nLast %s days\n' "$_kpi_window"
      printf '%s' "$_summary" | jq -r '
        "  Cycles:                 \(.cycles)",
        "  Total spend:            $\(.total_usd | tonumber * 100 | floor / 100)",
        "  Avg per cycle:          $\(.avg_per_cycle | tonumber * 10000 | floor / 10000)",
        "  Retries avg/cycle:      \(.retry_avg | tonumber * 10 | floor / 10)",
        "  Retry $ p95/cycle:      $\(.retry_usd_p95 | tonumber * 10000 | floor / 10000)",
        "  Phase classified:       \(.phase_classified_pct | floor)%"
      '
      printf '\n'
    fi
    ;;

  disable)
    _pp_set_user_env_var PP_EXTERNAL_LLM 0 || exit 1
    # v0.5.4 Change 4: clear lens + tip + idempotency caches so paused
    # state is INERT immediately (no waiting for the next cycle's
    # truncation at bin/statusline.sh:~1375 — which never runs while
    # paused). Budget files preserved by the helper. Spec: docs/v0.5.4-pause-ux-spec.md
    _pp_cache_clear_all "${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}" \
      >/dev/null 2>&1 || true
    # v0.5.5 brand: ⚛ prefix announces "polymath is what just paused."
    if [ -z "${_PP_BRAND_SOURCED:-}" ]; then
      # shellcheck disable=SC1091
      . "$PP_ROOT/lib/brand.sh" 2>/dev/null || true
    fi
    if type pp_brand_sigil_plain >/dev/null 2>&1; then
      printf '%s LLM cycle disabled and observation cache cleared. Status-only mode active.\n' "$(pp_brand_sigil_plain)"
    else
      printf 'LLM cycle disabled and observation cache cleared. Status-only mode active.\n'
    fi
    ;;

  enable)
    _pp_set_user_env_var PP_EXTERNAL_LLM 1 || exit 1
    # v0.5.5 brand: ⚛ prefix confirms enable came from polymath.
    if [ -z "${_PP_BRAND_SOURCED:-}" ]; then
      # shellcheck disable=SC1091
      . "$PP_ROOT/lib/brand.sh" 2>/dev/null || true
    fi
    if type pp_brand_sigil_plain >/dev/null 2>&1; then
      printf '%s LLM cycle enabled. New cycles take effect within 5 min.\n' "$(pp_brand_sigil_plain)"
    else
      printf 'LLM cycle enabled. New cycles take effect within 5 min.\n'
    fi
    ;;

  onboard)
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/onboard.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/doctor.sh" 2>/dev/null || true
    pp_onboard_run "$@"
    ;;

  fun)
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/fun-mode.sh"
    _pp_fun_sub="${1:-status}"
    case "$_pp_fun_sub" in
      status)
        _pp_fun_user_env="${PP_USER_CONFIG:-${PP_STATE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/pair-polymath}/config/user.env}"
        if [ -f "$_pp_fun_user_env" ]; then
          # shellcheck disable=SC1090
          . "$_pp_fun_user_env" 2>/dev/null || true
        fi
        printf '\nPair Polymath fun mode\n'
        printf '  Enabled:   %s\n' "${PP_FUN_MODE:-0}"
        printf '  Style:     %s\n' "$(pp_fun_style_normalize "${PP_FUN_STYLE:-mentor}")"
        printf '  Intensity: %s\n' "$(pp_fun_intensity_normalize "${PP_FUN_INTENSITY:-1}")"
        printf '  Roast:     %s\n' "${PP_FUN_ALLOW_ROAST:-0}"
        if _pp_fun_sample=$(PP_FUN_MODE="${PP_FUN_MODE:-0}" pp_fun_render 2>/dev/null); then
          printf '  Sample:    %s\n' "$_pp_fun_sample"
        fi
        printf '\n'
        ;;
      on)
        _pp_set_user_env_var PP_FUN_MODE 1 || exit 1
        printf 'Fun mode enabled (display-only).\n'
        ;;
      off)
        _pp_set_user_env_var PP_FUN_MODE 0 || exit 1
        printf 'Fun mode disabled.\n'
        ;;
      style)
        [ -n "${2:-}" ] || { printf 'polymath fun style: style required\n' >&2; exit 2; }
        _pp_fun_style=$(pp_fun_style_normalize "$2")
        if [ "$_pp_fun_style" != "$2" ]; then
          printf 'polymath fun style: invalid style %s (gentle|hype|dry|mentor|founder|roast)\n' "$2" >&2
          exit 2
        fi
        _pp_set_user_env_var PP_FUN_STYLE "$_pp_fun_style" || exit 1
        if [ "$_pp_fun_style" = "roast" ]; then
          _pp_set_user_env_var PP_FUN_ALLOW_ROAST 1 || exit 1
          printf 'Fun style set to roast (workflow-only roast enabled).\n'
        else
          _pp_set_user_env_var PP_FUN_ALLOW_ROAST 0 || exit 1
          printf 'Fun style set to %s.\n' "$_pp_fun_style"
        fi
        ;;
      -h|--help|help)
        cat <<'HELP'
polymath fun — display-only session commentary

Usage:
  polymath fun status
  polymath fun on
  polymath fun off
  polymath fun style gentle|hype|dry|mentor|founder|roast
HELP
        ;;
      *)
        printf 'polymath fun: unknown subcommand %s\n' "$_pp_fun_sub" >&2
        exit 2
        ;;
    esac
    ;;

  logs)
    shift
    _pp_logs_n=10
    _pp_logs_lens=""
    _pp_logs_follow=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -n)
          # Review fix F3: validate value EXISTS before shift, otherwise
          # `shift 2` on a 1-arg list returns non-zero, the loop re-matches
          # $1=-n on the next iteration, and we spin forever.
          [ -n "${2:-}" ] || { printf 'polymath logs: -n requires a value\n' >&2; exit 2; }
          _pp_logs_n="$2"
          shift 2
          ;;
        --lens)
          [ -n "${2:-}" ] || { printf 'polymath logs: --lens requires a value\n' >&2; exit 2; }
          _pp_logs_lens="$2"
          shift 2
          ;;
        --follow|-f) _pp_logs_follow=1; shift ;;
        -h|--help)
          cat <<HELP
polymath logs — tail recent lens observations

Usage:
  polymath logs                Last 10 observations across all lenses
  polymath logs -n 50          Last 50 observations
  polymath logs --lens ENGINEERING
                               Filter to one lens by id
  polymath logs --follow       Stream new observations as cycles complete

Observations live in \$CLAUDE_DIR/cache/cc-monitor-\$SESSION-\$LENS.txt
HELP
          exit 0
          ;;
        *) printf 'polymath logs: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # Validate + cap -n. Round-4 R4-8: previous validator allowed 0 even
    # though the error message claimed "positive integer". Explicit `< 1`
    # check after the digit validator.
    case "$_pp_logs_n" in
      ''|*[!0-9]*) printf 'polymath logs: -n requires a positive integer\n' >&2; exit 2 ;;
    esac
    [ "$_pp_logs_n" -lt 1 ] && { printf 'polymath logs: -n must be >= 1\n' >&2; exit 2; }
    [ "$_pp_logs_n" -gt 200 ] && _pp_logs_n=200

    _pp_cache_dir="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}"
    [ -d "$_pp_cache_dir" ] || { printf 'polymath logs: cache dir does not exist (%s); no observations yet\n' "$_pp_cache_dir"; exit 0; }

    # Determine session_id
    _pp_logs_session="${PP_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
    if [ -z "$_pp_logs_session" ]; then
      # Review fix F1: previous `([^-]+)` truncated multi-dash session IDs
      # (e.g. `abc-def-ghi` extracted to just `abc`). Use a greedy `(.+)` with
      # the trailing lens-id anchor `[A-Za-z0-9_]+\.txt$` as the boundary so
      # the longest possible session-id matches up to the final dash.
      # Review fix F5: also skip -verdict/-streak sidecars when sniffing the
      # session — they share the same glob but have different content.
      # SC2010: ls + grep is the cleanest expression here; mtime ordering is
      # provided by `ls -t` and filenames are constrained (no embedded
      # newlines/spaces — we author them in this same script).
      # shellcheck disable=SC2010
      _pp_logs_session=$(ls -t "$_pp_cache_dir"/cc-monitor-*-*.txt 2>/dev/null \
        | grep -v -- '-verdict\.txt$' \
        | grep -v -- '-streak\.txt$' \
        | head -1 \
        | sed -nE 's@.*/cc-monitor-(.+)-[A-Za-z0-9_]+\.txt$@\1@p')
    fi
    if [ -z "$_pp_logs_session" ]; then
      printf 'polymath logs: no observations yet (run a session to produce them)\n'
      exit 0
    fi

    # Review fix F7' (round 3): explicit flavor-driven mtime resolution. The
    # round-1 fallback chain `stat -f %m FILE || stat -c %Y FILE` silently
    # produced WRONG values on GNU/Linux because `stat -f %m FILE` doesn't
    # fail there — `-f` means "filesystem mode" and `%m` returns the mount
    # point string, which GNU `date -r FILE` then happily treats as a
    # filename. _PP_STAT_FLAVOR is detected once upfront (top of file).
    _pp_logs_get_mtime() {
      local f="$1"
      local secs
      case "$_PP_STAT_FLAVOR" in
        gnu)
          secs=$(stat -c %Y "$f" 2>/dev/null) || { printf '?'; return; }
          date -d "@$secs" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '?'
          ;;
        bsd)
          secs=$(stat -f %m "$f" 2>/dev/null) || { printf '?'; return; }
          date -r "$secs" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '?'
          ;;
        *)
          printf '?'
          ;;
      esac
    }

    _pp_logs_print_one() {
      local file="$1"
      [ -s "$file" ] || return 0
      local lens_id
      # Review fix F2: previous `([A-Z_]+)` rejected lens IDs with digits or
      # lowercase (LENS1, engineering_v2). Broaden to [A-Za-z0-9_]+.
      # Round-3 G4: --lens filtering moved OUT of this function and into the
      # file-list build step, so head -n no longer drops lens-matching files.
      lens_id=$(printf '%s' "$file" | sed -nE 's@.*-([A-Za-z0-9_]+)\.txt$@\1@p')
      local raw
      raw=$(head -1 "$file" 2>/dev/null)
      [ -z "$raw" ] && return 0
      # Parse "HAT: hook|||body" — hook is before |||, body after
      local hook body
      hook="${raw%%|||*}"
      body="${raw#*|||}"
      # Timestamp from file mtime (portable BSD/GNU; review fix F7)
      local ts
      ts=$(_pp_logs_get_mtime "$file")
      printf '%s  %s\n  %s\n  %s\n' "$ts" "$lens_id" "$hook" "$body"
      # Verdict sidecar — print only if present and contains DROP
      local verdict_file="${file%.txt}-verdict.txt"
      if [ -f "$verdict_file" ]; then
        local v
        v=$(head -1 "$verdict_file")
        case "$v" in
          *DROP*) printf '  [DROP: %s]\n' "$v" ;;
        esac
      fi
      printf '\n'
    }

    if [ "$_pp_logs_follow" = "1" ]; then
      # Review fix G3 (round 3): --follow was previously tailing the newest
      # single cache file regardless of --lens, diverging from non-follow
      # mode's filter behavior. When --lens is set, tail ONLY that lens's
      # specific cache file. Refuse gracefully if no file yet exists.
      if [ -n "$_pp_logs_lens" ]; then
        target="$_pp_cache_dir/cc-monitor-$_pp_logs_session-$_pp_logs_lens.txt"
        if [ ! -f "$target" ]; then
          printf 'polymath logs --follow: no cache file yet for lens %s (session %s)\n' \
            "$_pp_logs_lens" "$_pp_logs_session"
          exit 0
        fi
        # Round-4 R4-7: printf format strings starting with '-' parse as flags
        # on some shells. Prefix '--' so '--follow on lens ...' is treated as
        # format, not option.
        printf -- '--follow on lens %s (Ctrl-C to exit)\n\n' "$_pp_logs_lens"
        tail -F "$target" 2>/dev/null
        exit 0
      fi
      # Round-4 R4-5: --follow without --lens used to tail only the NEWEST
      # single cache file for the session — if a different lens wrote mid-
      # session, the user silently saw nothing. Now tail ALL existing lens
      # files for this session. tail -F accepts multiple files. Caveat: a
      # lens whose cache file is CREATED after the --follow starts won't be
      # auto-watched; v0.3 may use inotify/fswatch for fully-dynamic follow.
      printf 'polymath logs --follow: waiting for new observations (Ctrl-C to exit)\n\n'
      # Review fix F5: filter -verdict/-streak sidecars so tail -F doesn't
      # latch onto a verdict file (different format, not observations).
      # shellcheck disable=SC2010
      _pp_follow_files=$(ls -t "$_pp_cache_dir"/cc-monitor-"$_pp_logs_session"-*.txt 2>/dev/null \
        | grep -v -- '-verdict\.txt$' \
        | grep -v -- '-streak\.txt$')
      if [ -z "$_pp_follow_files" ]; then
        printf 'polymath logs --follow: no observations yet for session %s\n' "$_pp_logs_session"
        exit 0
      fi
      printf -- '--follow on session %s (Ctrl-C to exit)\n\n' "$_pp_logs_session"
      # shellcheck disable=SC2086  # intentional word-splitting of file list
      tail -F $_pp_follow_files 2>/dev/null
      exit 0
    fi

    # Default mode: collect candidate files, filter --lens FIRST, then head -n.
    # Review fix G4 (round 3): previously `head -n` ran BEFORE the --lens
    # filter, so `polymath logs --lens X -n N` could yield zero results if
    # X's cache files weren't among the newest N. Now filter then head.
    # Review fix F5: also strip -verdict.txt / -streak.txt sidecars — the
    # glob matches them but they have different content shape and would
    # render as garbled "observations".
    _pp_logs_tmp=$(mktemp)
    # shellcheck disable=SC2010
    ls -t "$_pp_cache_dir"/cc-monitor-"$_pp_logs_session"-*.txt 2>/dev/null \
      | grep -v -- '-verdict\.txt$' \
      | grep -v -- '-streak\.txt$' \
      > "$_pp_logs_tmp"

    # Pre-filter by --lens before applying head -n (G4).
    if [ -n "$_pp_logs_lens" ]; then
      _pp_logs_tmp2=$(mktemp)
      grep -F -- "-$_pp_logs_lens.txt" < "$_pp_logs_tmp" > "$_pp_logs_tmp2" || true
      mv "$_pp_logs_tmp2" "$_pp_logs_tmp"
    fi

    # Now cap to -n.
    _pp_logs_tmp3=$(mktemp)
    head -n "$_pp_logs_n" < "$_pp_logs_tmp" > "$_pp_logs_tmp3"
    mv "$_pp_logs_tmp3" "$_pp_logs_tmp"

    if [ ! -s "$_pp_logs_tmp" ]; then
      if [ -n "$_pp_logs_lens" ]; then
        printf 'polymath logs: no observations for lens %s in session %s\n' \
          "$_pp_logs_lens" "$_pp_logs_session"
      else
        printf 'polymath logs: no observations for session %s yet\n' "$_pp_logs_session"
      fi
      rm -f "$_pp_logs_tmp"
      exit 0
    fi
    while IFS= read -r f; do
      _pp_logs_print_one "$f"
    done < "$_pp_logs_tmp"
    rm -f "$_pp_logs_tmp"
    ;;

  update)
    shift
    _pp_update_yes=0
    _pp_update_dry=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --yes|-y) _pp_update_yes=1; shift ;;
        --dry-run) _pp_update_dry=1; shift ;;
        -h|--help)
          cat <<HELP
polymath update — Pull latest + re-run installer (idempotent)

Usage:
  polymath update              Interactive: shows diff, asks confirm, pulls,
                               re-runs bin/install.sh.
  polymath update --yes        Non-interactive: fetch + ff-only pull. Skips
                               install.sh; prints loud warning if pull touched
                               installer or hooks (re-run bin/install.sh
                               manually in that case).
  polymath update --dry-run    Show what would happen; make no changes.

Honors the current branch's configured upstream (\`@{upstream}\`); falls back
to origin/<default-branch> only when no upstream is set. Refuses to proceed
when the working tree has uncommitted changes (real path).
HELP
          exit 0
          ;;
        *) printf 'polymath update: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # `.git` may be a directory (normal checkout) OR a file (linked worktree).
    # Both are valid git checkouts. Test the rev-parse path instead.
    if ! git -C "$PP_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      printf 'polymath update: PP_ROOT (%s) is not a git checkout — manual update needed\n' "$PP_ROOT" >&2
      exit 1
    fi

    # Review fix F6: detect the upstream default branch instead of hardcoding
    # `main`. Forks / branch-tracking installs were silently broken.
    _pp_default_branch=$(git -C "$PP_ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
    _pp_default_branch="${_pp_default_branch:-main}"

    # Round-4 R4-2: respect @{upstream} when configured. Previously we always
    # pulled origin/<default-branch>, which is wrong on forks / release
    # branches / feature branches where the user's branch tracks something
    # other than origin/main. Falling back to origin/<default-branch> only
    # when no upstream is set keeps the legacy contract for plain installs.
    # Detached HEAD: no current branch, no upstream — only safe move is to
    # query origin/<default-branch> for dry-run (read-only). A real pull
    # against detached HEAD would be a separate problem we surface later.
    _pp_current_branch=$(git -C "$PP_ROOT" symbolic-ref --short HEAD 2>/dev/null) || _pp_current_branch=""
    _pp_upstream=""
    if [ -n "$_pp_current_branch" ]; then
      _pp_upstream=$(git -C "$PP_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || _pp_upstream=""
    fi
    if [ -n "$_pp_upstream" ]; then
      _pp_compare_ref="$_pp_upstream"
    else
      # No upstream (either detached HEAD, or branch with no tracking config).
      # Fall back to origin/<default-branch>.
      _pp_compare_ref="origin/$_pp_default_branch"
    fi
    # `git pull` takes a refspec without the `origin/` prefix.
    _pp_pull_branch="${_pp_compare_ref#origin/}"

    # Review fix F8: dry-run must NOT mutate `.git/` state. `git fetch` writes
    # FETCH_HEAD and updates remote-tracking refs, which breaks the "no
    # changes" contract. Use `git ls-remote` (read-only) instead.
    if [ "$_pp_update_dry" = "1" ]; then
      # Round-4 R4-3 (dry-run variant): if the working tree is dirty, mention
      # that the real path would refuse — but don't exit nonzero (dry-run
      # promises no filesystem change, including exit-code surprises).
      if [ -n "$(git -C "$PP_ROOT" status --porcelain 2>/dev/null)" ]; then
        printf '[dry-run] Working tree has uncommitted changes; a real update would refuse.\n'
        printf '[dry-run] Stash or commit before running without --dry-run.\n'
        # Continue to also print the would-pull plan so the user sees both
        # blockers in one shot.
      fi
      _pp_update_remote_head=$(git -C "$PP_ROOT" ls-remote --heads origin "$_pp_pull_branch" 2>/dev/null | awk '{print $1}')
      if [ -z "$_pp_update_remote_head" ]; then
        printf '[dry-run] Could not query %s (network? auth?). No changes made.\n' "$_pp_compare_ref"
        exit 0
      fi
      _pp_update_local_head=$(git -C "$PP_ROOT" rev-parse HEAD 2>/dev/null)
      if [ "$_pp_update_remote_head" = "$_pp_update_local_head" ]; then
        printf '[dry-run] Already up to date.\n'
        exit 0
      fi
      # Round-4 R4-6: distinguish fast-forward from diverged history. The
      # previous version printed "Would pull" regardless, so a user with
      # local commits ahead of upstream would see a false-positive plan.
      # `merge-base --is-ancestor A B` returns 0 iff A is an ancestor of B
      # (i.e. linear ff path); nonzero on divergence.
      #
      # Subtlety: ls-remote returns the remote SHA which may not yet exist
      # in the local object store (we haven't fetched). If it isn't local,
      # we can't run ancestry — fall back to the inverse check: is the
      # current local HEAD an ancestor of the local-tracking ref? If neither
      # is determinable, we honestly say "ff/divergence undetermined".
      if git -C "$PP_ROOT" cat-file -e "$_pp_update_remote_head" 2>/dev/null; then
        # Remote SHA is in our local object DB (post-fetch state or coincident
        # history). We can do a definitive ancestry check.
        if git -C "$PP_ROOT" merge-base --is-ancestor "$_pp_update_local_head" "$_pp_update_remote_head" 2>/dev/null; then
          printf '[dry-run] Would fast-forward to %s\n' "$_pp_update_remote_head"
          printf '[dry-run] %s: %s\n[dry-run] local HEAD: %s\n' \
            "$_pp_compare_ref" "$_pp_update_remote_head" "$_pp_update_local_head"
        else
          printf '[dry-run] Local branch has diverged from %s. A real update would FAIL --ff-only.\n' "$_pp_compare_ref"
          printf '[dry-run] %s: %s\n[dry-run] local:  %s\n' \
            "$_pp_compare_ref" "$_pp_update_remote_head" "$_pp_update_local_head"
          printf '[dry-run] Resolve with: cd %s && git status; consider git pull --rebase if appropriate\n' "$PP_ROOT"
        fi
      else
        # Remote SHA not yet in local object DB — use the local remote-
        # tracking ref as a proxy. If local HEAD is ancestor of the local
        # tracking ref, ff is plausible (though staler than ls-remote shows).
        if git -C "$PP_ROOT" merge-base --is-ancestor "$_pp_update_local_head" "$_pp_compare_ref" 2>/dev/null; then
          printf '[dry-run] Would fast-forward to %s\n' "$_pp_update_remote_head"
          printf '[dry-run] %s: %s\n[dry-run] local HEAD: %s\n' \
            "$_pp_compare_ref" "$_pp_update_remote_head" "$_pp_update_local_head"
          printf '[dry-run] (Ancestry verified against last-known %s; run without --dry-run to fetch + pull.)\n' "$_pp_compare_ref"
        else
          printf '[dry-run] Local branch has diverged from %s. A real update would FAIL --ff-only.\n' "$_pp_compare_ref"
          printf '[dry-run] %s: %s\n[dry-run] local:  %s\n' \
            "$_pp_compare_ref" "$_pp_update_remote_head" "$_pp_update_local_head"
          printf '[dry-run] Resolve with: cd %s && git status; consider git pull --rebase if appropriate\n' "$PP_ROOT"
        fi
      fi
      exit 0
    fi

    # Real path: detached HEAD is a degenerate case. Dry-run can still report
    # against origin/<default-branch> (read-only), but a real pull would
    # leave the user in a worse spot. Refuse cleanly.
    if [ -z "$_pp_current_branch" ]; then
      printf 'polymath update: HEAD is detached. Check out a branch first:\n' >&2
      printf '  cd %s && git checkout %s\n' "$PP_ROOT" "$_pp_default_branch" >&2
      exit 1
    fi

    # Round-4 R4-3: refuse on dirty working tree BEFORE the fetch. Avoids
    # spending a network round-trip just to fail at the pull, and avoids
    # the failure mode where ff-only succeeds but leaves the user's edits
    # stranded next to surprise upstream changes.
    if [ -n "$(git -C "$PP_ROOT" status --porcelain 2>/dev/null)" ]; then
      printf 'polymath update: local working tree has uncommitted changes.\n' >&2
      printf 'Refusing to pull. Stash or commit your changes first:\n' >&2
      printf '  cd %s && git status\n' "$PP_ROOT" >&2
      exit 1
    fi

    # Real path — fetch + diff + (maybe) prompt + pull + install
    # v0.5.5 brand: constellation spinner during the fetch (network wait).
    # Lazy-source brand.sh; falls back to plain text on older installs.
    if [ -z "${_PP_BRAND_SOURCED:-}" ]; then
      # shellcheck disable=SC1091
      . "$PP_ROOT/lib/brand.sh" 2>/dev/null || true
    fi
    if type pp_brand_loading >/dev/null 2>&1 && [ -t 1 ]; then
      # Spin in background; foreground does the fetch; kill spinner after.
      (
        while :; do
          printf '\r%s Fetching from origin... ' "$(pp_brand_loading)" >&2
          sleep 1
        done
      ) &
      _pp_spinner_pid=$!
      trap 'kill "$_pp_spinner_pid" 2>/dev/null; wait "$_pp_spinner_pid" 2>/dev/null; true' EXIT
    else
      printf 'Fetching from origin...\n'
      _pp_spinner_pid=""
    fi
    if ! git -C "$PP_ROOT" fetch origin --tags --quiet 2>&1; then
      [ -n "$_pp_spinner_pid" ] && { kill "$_pp_spinner_pid" 2>/dev/null; wait "$_pp_spinner_pid" 2>/dev/null; printf '\r\033[K' >&2; }
      printf 'polymath update: git fetch failed (network? auth?)\n' >&2
      exit 1
    fi
    if [ -n "$_pp_spinner_pid" ]; then
      kill "$_pp_spinner_pid" 2>/dev/null
      wait "$_pp_spinner_pid" 2>/dev/null
      printf '\r\033[K' >&2
      trap - EXIT
    fi

    # Capture local HEAD before pull so we can diff after the pull (R4-1).
    _pp_update_pre_pull_head=$(git -C "$PP_ROOT" rev-parse HEAD 2>/dev/null)

    _pp_update_new=$(git -C "$PP_ROOT" log --oneline "HEAD..$_pp_compare_ref" 2>/dev/null)
    if [ -z "$_pp_update_new" ]; then
      printf 'Already up to date.\n'
      exit 0
    fi

    printf '\nNew commits on %s:\n' "$_pp_compare_ref"
    printf '%s\n' "$_pp_update_new" | sed 's/^/  /'
    printf '\n'

    # Review fix F9: failed `read` (non-interactive stdin EOF) used to default
    # to "Y" via `${_pp_update_ans:-Y}`, silently proceeding with pull +
    # install. Detect non-TTY explicitly and refuse to proceed without --yes,
    # and treat a failed `read` as abort, not consent.
    if [ "$_pp_update_yes" != "1" ]; then
      if ! [ -t 0 ]; then
        printf 'polymath update: non-interactive stdin without --yes — refusing to proceed.\n' >&2
        printf 'Re-run with --yes (skips installer) or in an interactive shell.\n' >&2
        exit 1
      fi
      printf 'Pull and re-run installer? [Y/n] '
      if ! read -r _pp_update_ans; then
        printf '\npolymath update: read failed (EOF?); aborting.\n' >&2
        exit 1
      fi
      case "${_pp_update_ans:-Y}" in
        [Yy]*|"") ;;
        *) printf 'Aborted.\n'; exit 0 ;;
      esac
    fi

    if ! git -C "$PP_ROOT" pull --ff-only origin "$_pp_pull_branch" 2>&1; then
      printf '\npolymath update: pull failed.\n' >&2
      printf 'Local branch may have diverged. Inspect with: cd %s && git status\n' "$PP_ROOT" >&2
      exit 1
    fi

    # Review fix F4 + Round-4 R4-1: install.sh has multiple interactive `read`
    # calls, so --yes must NOT invoke it. But the previous --yes path just
    # said "re-run manually if needed", which was unhelpful — the user has no
    # way to know whether the pull actually changed anything installer-
    # affecting. Now we diff the actual changeset and either confirm the
    # install is still idempotent, or warn loudly with the file list and
    # the exact command to re-run.
    if [ "$_pp_update_yes" = "1" ]; then
      installer_changed=$(git -C "$PP_ROOT" diff --name-only "$_pp_update_pre_pull_head" HEAD 2>/dev/null \
        | grep -E '^(bin/install\.sh|hooks/|config/default\.env)' || true)
      if [ -z "$installer_changed" ]; then
        printf '\n[--yes] Pull complete. No installer-affecting files changed; install was idempotent.\n'
      else
        printf '\n[--yes] Pull complete. WARNING: installer-affecting files changed:\n' >&2
        printf '%s\n' "$installer_changed" | sed 's/^/  /' >&2
        printf '\n[--yes] Re-run interactively to update hooks/config/dependencies:\n' >&2
        printf '          bash %s/bin/install.sh\n' "$PP_ROOT" >&2
        # Don't exit nonzero — the pull itself succeeded. Just warn loudly.
      fi
    else
      printf '\nRe-running installer (idempotent — preserves your settings.json + user.env)...\n'
      bash "$PP_ROOT/bin/install.sh"
    fi
    ;;

  cost)
    shift
    _pp_cost_since="7d"
    _pp_cost_by_lens=0
    _pp_cost_json=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --since)
          [ -n "${2:-}" ] || { printf 'polymath cost: --since requires a value (e.g. 7d, 30d, 1d)\n' >&2; exit 2; }
          _pp_cost_since="$2"
          shift 2
          ;;
        --by-lens) _pp_cost_by_lens=1; shift ;;
        --json) _pp_cost_json=1; shift ;;
        -h|--help)
          cat <<HELP
polymath cost — show estimated USD spend from metrics.jsonl

Usage:
  polymath cost                       Last 7d, table by day
  polymath cost --since 30d           Last 30 days
  polymath cost --by-lens             Breakdown by call type
  polymath cost --json                Raw JSONL for piping to jq

Note: figures are ESTIMATES based on static avg-token assumptions and per-million
pricing in lib/metrics.sh. Real spend may vary 20-50%. v0.3 plans real --usage
parsing.
HELP
          exit 0
          ;;
        *) printf 'polymath cost: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # Validate --since (Nd format)
    case "$_pp_cost_since" in
      *d) : ;;
      *) printf 'polymath cost: --since must be like 7d, 30d (got %s)\n' "$_pp_cost_since" >&2; exit 2 ;;
    esac
    _pp_cost_days="${_pp_cost_since%d}"
    case "$_pp_cost_days" in
      ''|*[!0-9]*) printf 'polymath cost: --since days must be numeric (got %s)\n' "$_pp_cost_since" >&2; exit 2 ;;
    esac
    [ "$_pp_cost_days" -lt 1 ] && { printf 'polymath cost: --since must be >= 1d (got %s)\n' "$_pp_cost_since" >&2; exit 2; }

    _pp_metrics_file="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/metrics.jsonl"
    if [ ! -s "$_pp_metrics_file" ]; then
      printf 'polymath cost: no metrics yet (run a session to produce them).\n'
      exit 0
    fi

    # Compute cutoff timestamp (UTC) for "since N days". BSD date uses -v -Nd;
    # GNU date uses -d "-N days". Probe by trying BSD form first (macOS).
    if date -u -v "-${_pp_cost_days}d" '+%Y-%m-%dT%H:%M:%SZ' >/dev/null 2>&1; then
      _pp_cost_cutoff=$(date -u -v "-${_pp_cost_days}d" '+%Y-%m-%dT%H:%M:%SZ')
    else
      _pp_cost_cutoff=$(date -u -d "-${_pp_cost_days} days" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)
    fi
    if [ -z "$_pp_cost_cutoff" ]; then
      printf 'polymath cost: could not compute cutoff date for --since %s\n' "$_pp_cost_since" >&2
      exit 1
    fi

    if [ "$_pp_cost_json" = "1" ]; then
      # Raw JSONL filtered by cutoff
      jq -c --arg cutoff "$_pp_cost_cutoff" 'select(.ts >= $cutoff)' "$_pp_metrics_file"
      exit 0
    fi

    if [ "$_pp_cost_by_lens" = "1" ]; then
      printf '\nCost by call type (last %s):\n' "$_pp_cost_since"
      # Review fix R2-H2: previous code did `map(.by_type) | add` which in jq
      # performs key-collision merge (last-write-wins) on objects, NOT numeric
      # summation. Across multiple sessions with overlapping call-type keys
      # (always the case) only the LAST session's counts survived, silently
      # undercounting in proportion to history length. Replace with
      # flatten-group-sum and also surface the per-type USD totals from the
      # new `by_type_usd` field (added in lib/metrics.sh round-2).
      _pp_cost_bytype=$(jq -s --arg cutoff "$_pp_cost_cutoff" '
        def sum_by_key:
          [.[] // {} | to_entries[]]
          | group_by(.key)
          | map({key: .[0].key, value: (map(.value) | add)})
          | from_entries;
        map(select(.ts >= $cutoff)) as $rows
        | ($rows | map(.by_type // {}) | sum_by_key) as $counts
        | ($rows | map(.by_type_usd // {}) | sum_by_key) as $usds
        | [ $counts | to_entries[] | {key: .key, calls: .value, usd: ($usds[.key] // 0)} ]
        | sort_by(-.calls)
      ' "$_pp_metrics_file" 2>/dev/null)
      if [ -z "$_pp_cost_bytype" ] || [ "$_pp_cost_bytype" = "[]" ]; then
        printf '  (no data in window)\n\n'
        exit 0
      fi
      # 4-decimal USD display (review fix R2-M2): sub-cent sessions otherwise
      # render as $0.00 and look like the feature is broken.
      printf '%s' "$_pp_cost_bytype" \
        | jq -r '.[] | "  " + .key + ": " + (.calls | tostring) + " calls / $" + ((.usd * 10000 | round) / 10000 | tostring)'
      printf '\n'
      # Round-3 fix R3-PR10-6: surface unknown-model warnings.
      _pp_warn_file="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/metrics-warnings.log"
      if [ -s "$_pp_warn_file" ]; then
        printf '\033[33m⚠\033[0m  Unknown models seen — figures may underestimate spend:\n'
        awk -F'\t' 'NR<=5 {print "  " $0}' "$_pp_warn_file"
        printf '  See: %s\n\n' "$_pp_warn_file"
      fi
      exit 0
    fi

    # Default: table by day with date / cycles / calls / USD columns.
    # Review fix R2-M2: USD now formatted to 4 decimals (round/10000) so
    # single-call sub-cent test sessions don't display as $0.00 and look
    # like the metric is broken.
    _pp_cost_rows=$(jq -rs --arg cutoff "$_pp_cost_cutoff" '
      map(select(.ts >= $cutoff))
      | group_by(.ts[0:10])
      | map({
          date: .[0].ts[0:10],
          cycles: length,
          calls: (map(.calls) | add // 0),
          usd: (map(.usd_est) | add // 0)
        })
      | sort_by(.date)
      | .[]
      | [.date, (.cycles|tostring), (.calls|tostring), (.usd*10000|round/10000|tostring)]
      | @tsv
    ' "$_pp_metrics_file" 2>/dev/null)

    if [ -z "$_pp_cost_rows" ]; then
      printf '\nNo cycles in last %s.\n\n' "$_pp_cost_since"
      exit 0
    fi

    _pp_cost_totals=$(jq -rs --arg cutoff "$_pp_cost_cutoff" '
      map(select(.ts >= $cutoff))
      | {cycles: length, calls: (map(.calls) | add // 0), usd: (map(.usd_est) | add // 0)}
      | [(.cycles|tostring), (.calls|tostring), (.usd*10000|round/10000|tostring)]
      | @tsv
    ' "$_pp_metrics_file" 2>/dev/null)

    printf '\n'
    printf '%-12s  %7s  %7s  %10s\n' 'Date' 'Cycles' 'Calls' 'USD (est)'
    printf -- '─────────────────────────────────────────\n'
    printf '%s\n' "$_pp_cost_rows" | awk -F'\t' '{printf "%-12s  %7s  %7s  $%8s\n", $1, $2, $3, $4}'
    printf -- '─────────────────────────────────────────\n'
    printf '%s\n' "$_pp_cost_totals" | awk -F'\t' '{printf "%-12s  %7s  %7s  $%8s\n", "Total", $1, $2, $3}'
    printf '\n'
    # Round-3 fix R3-PR10-6: surface unknown-model warnings.
    _pp_warn_file="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/metrics-warnings.log"
    if [ -s "$_pp_warn_file" ]; then
      printf '\033[33m⚠\033[0m  Unknown models seen — figures may underestimate spend:\n'
      awk -F'\t' 'NR<=5 {print "  " $0}' "$_pp_warn_file"
      printf '  See: %s\n\n' "$_pp_warn_file"
    fi
    ;;

  self-test)
    shift
    _pp_st_yes=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --yes|-y) _pp_st_yes=1; shift ;;
        -h|--help)
          cat <<HELP
polymath self-test — end-to-end LLM probe (~\$0.0001)

Makes one real LLM call through the run_llm wrapper, verifies:
  - openai key is set and accepted
  - network reaches the API
  - run_llm wrapper invokes correctly (timeout + portable)
  - budget counter increments by 1
  - response is parseable + matches expected sentinel

Usage:
  polymath self-test                Interactive: confirm before spending
  polymath self-test --yes          Non-interactive: skip confirm
  polymath self-test --help         This message

Cost: ~\$0.0001 per run (single gpt-5-mini call, ~50 input tokens / ~10 output tokens).
HELP
          exit 0
          ;;
        *) printf 'polymath self-test: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # Confirm before spending (unless --yes)
    if [ "$_pp_st_yes" != "1" ]; then
      printf 'polymath self-test will make one real LLM call (~$0.0001). Proceed? [Y/n] '
      if ! [ -t 0 ]; then
        printf '\npolymath self-test: non-interactive stdin without --yes. Refusing.\n' >&2
        exit 1
      fi
      if ! read -r _pp_st_ans; then
        printf '\npolymath self-test: read failed (EOF?); aborting.\n' >&2
        exit 1
      fi
      case "${_pp_st_ans:-Y}" in
        [Yy]*|"") ;;
        *) printf 'Aborted.\n'; exit 0 ;;
      esac
    fi

    # === Dispatch the actual probe ===
    if ! command -v llm >/dev/null 2>&1; then
      printf '\033[31m✗\033[0m self-test: llm CLI not on PATH\n' >&2
      exit 1
    fi
    # R2 MED-3: env-var-configured users (OPENAI_API_KEY exported) are valid
    # too. Only WARN if the key list doesn't show openai — let the real call
    # validate. Previously this was a hard exit that rejected valid configs.
    if ! llm keys list 2>/dev/null | grep -q '^openai$'; then
      printf '\033[33m⚠\033[0m self-test: openai not in `llm keys list`; trusting env-var or plugin to provide credentials. The real call will validate.\n' >&2
    fi

    # Track whether any verification step failed. We complete the entire
    # probe (so users see all signals) and then exit non-zero at the end.
    # R2 HIGH-1: sentinel mismatch must NOT be silently swallowed.
    _pp_st_failed=0

    # Record budget before
    _pp_st_budget_before=$(budget_get)

    # Use the SAME run_llm wrapper that bin/statusline.sh uses, by extracting it.
    # For test isolation, we redeclare it here (it's portable + idempotent).
    _pp_st_run_llm() {
      local timeout_s="${1:-15}"
      shift
      if command -v timeout >/dev/null 2>&1; then
        timeout "$timeout_s" llm "$@"
      elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$timeout_s" llm "$@"
      else
        llm "$@"
      fi
    }

    printf '\033[1mself-test\033[0m: probing OpenAI via run_llm...\n'

    # Single cheap call: ask for a known sentinel. System prompt via -s flag
    # (R2 MED-4) — clearer + matches statusline.sh's wrapper conventions
    # than relying on llm's positional-after-stdin merge heuristic.
    _pp_st_out=$(printf 'Respond with EXACTLY the word: PAIRPOLYMATH_OK' | _pp_st_run_llm 15 -m gpt-5-mini -s "You are a probe responder. Output exactly the requested word, no more." 2>/dev/null)
    _pp_st_rc=$?

    if [ "$_pp_st_rc" -ne 0 ]; then
      printf '\033[31m✗\033[0m self-test: llm call failed (rc=%s). Check network + key.\n' "$_pp_st_rc" >&2
      # R2 HIGH-2: increment budget ONLY if the call succeeded. Failed calls
      # (network/auth/timeout) must not corrupt the daily counter.
      exit 1
    fi

    # Increment budget AFTER successful call (matches statusline.sh)
    budget_inc || true

    # Verify the response
    _pp_st_trimmed=$(printf '%s' "$_pp_st_out" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    case "$_pp_st_trimmed" in
      *pairpolymath_ok*)
        printf '\033[32m✓\033[0m self-test: response matched sentinel\n'
        ;;
      *)
        # R2 HIGH-1: previously this only warned and the script continued
        # to print "All passed" + exit 0. A self-test that doesn't actually
        # verify is worse than no test. Track the failure and exit non-zero.
        printf '\033[31m✗\033[0m self-test: response did NOT match sentinel "PAIRPOLYMATH_OK"\n'
        printf '          got: %s\n' "${_pp_st_out:0:200}"
        printf '          (key + network reachable, but model output unexpected)\n'
        _pp_st_failed=1
        ;;
    esac

    # Verify budget incremented
    _pp_st_budget_after=$(budget_get)
    _pp_st_delta=$((_pp_st_budget_after - _pp_st_budget_before))
    if [ "$_pp_st_delta" -ge 1 ]; then
      printf '\033[32m✓\033[0m self-test: budget incremented by %s\n' "$_pp_st_delta"
    else
      printf '\033[31m✗\033[0m self-test: budget did NOT increment (before=%s, after=%s)\n' "$_pp_st_budget_before" "$_pp_st_budget_after"
      _pp_st_failed=1
    fi

    if [ "$_pp_st_failed" = "1" ]; then
      printf '\n\033[31mself-test: one or more checks failed.\033[0m\n' >&2
      exit 1
    fi
    printf '\n\033[32mAll self-test checks passed.\033[0m\n'
    ;;

  memory)
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/schema.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/redact.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/store.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/activation.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/lock.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/patterns.sh"
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/memory/evict.sh"
    _pp_mem_cwd="${PP_MEMORY_CLI_CWD:-$PWD}"
    _pp_mem_sub="${1:-status}"
    case "$_pp_mem_sub" in
      status)
        _pp_mem_proj=$(pp_memory_project_dir "$_pp_mem_cwd")
        _pp_mem_db="$_pp_mem_proj/observations.sqlite"
        printf '\n\033[1mPair Polymath memory\033[0m\n'
        printf '  Enabled:          %s\n' "${PP_MEMORY_ENABLE:-0}"
        printf '  Memory dir:       %s\n' "$PP_MEMORY_DIR"
        printf '  Project dir:      %s\n' "$_pp_mem_proj"
        if [ -f "$_pp_mem_db" ]; then
          _pp_mem_size=$(stat -f %z "$_pp_mem_db" 2>/dev/null || stat -c %s "$_pp_mem_db" 2>/dev/null || echo 0)
          printf '  DB path:          %s\n' "$_pp_mem_db"
          printf '  Size (bytes):     %s\n' "$_pp_mem_size"
          # F13: detect schema before querying. A DB file that exists but
          # has no observations table (corrupt, half-initialized, or from a
          # future schema version) used to crash with "no such table" once
          # the SELECT ran. PRAGMA table_info returns nothing for a missing
          # table and is a free read — no schema mutation.
          _pp_mem_has_obs=$(pp_memory_sqlite "$_pp_mem_db" "PRAGMA table_info(observations);" 2>/dev/null | head -1)
          if [ -z "$_pp_mem_has_obs" ]; then
            printf '  Schema:           DB uninitialized (no observations table)\n'
          else
            _pp_mem_rows=$(pp_memory_sqlite "$_pp_mem_db" "SELECT COUNT(*) FROM observations;" 2>/dev/null)
            printf '  Observations:     %s\n' "$_pp_mem_rows"
            if [ "${_pp_mem_rows:-0}" -gt 0 ]; then
              printf '  Top-5 by activation:\n'
              pp_memory_sqlite -separator ' | ' "$_pp_mem_db" "
                SELECT printf('    [%s] %s (act=%.3f)', lens_id, hook, activation_score)
                  FROM observations
                 ORDER BY (activation_score IS NULL), activation_score DESC, obs_id ASC
                 LIMIT 5;" 2>/dev/null
            fi
          fi
        else
          printf '  DB:               (not yet initialized)\n'
        fi
        if [ -f "$_pp_mem_proj/patterns.jsonl" ]; then
          _pp_mem_plines=$(wc -l < "$_pp_mem_proj/patterns.jsonl" 2>/dev/null | tr -d ' ')
          printf '  Patterns:         %s\n' "$_pp_mem_plines"
        fi
        printf '\n'
        ;;
      recompute)
        _pp_mem_pd=$(pp_memory_project_dir "$_pp_mem_cwd")
        pp_memory_db_init "$_pp_mem_pd"
        if pp_memory_with_lock "$_pp_mem_pd" pp_memory_recompute_scores "$_pp_mem_cwd"; then
          printf 'memory: activation_score recomputed.\n'
        else
          printf 'memory: recompute failed (see stderr).\n' >&2
          exit 1
        fi
        ;;
      evict)
        if pp_memory_evict "$_pp_mem_cwd"; then
          printf 'memory: eviction sweep complete.\n'
        else
          printf 'memory: eviction did NOT complete (LLM summary required); see stderr.\n' >&2
          exit 1
        fi
        ;;
      patterns)
        out=$(pp_memory_top_patterns "$_pp_mem_cwd" 10)
        if [ -z "$out" ] || [ "$out" = "[]" ]; then
          printf '(no patterns extracted yet)\n'
        else
          printf '%s\n' "$out" | jq -r '.[] | "  • [" + (.confidence|tostring) + "] " + .title'
        fi
        ;;
      clear)
        _pp_mem_yes=0
        [ "${2:-}" = "--yes" ] && _pp_mem_yes=1
        if [ "$_pp_mem_yes" != "1" ]; then
          printf 'memory clear: refusing without --yes (this deletes ALL memory for the current project)\n' >&2
          exit 2
        fi
        _pp_mem_proj=$(pp_memory_project_dir "$_pp_mem_cwd")
        rm -rf "$_pp_mem_proj"
        printf 'memory: cleared %s\n' "$_pp_mem_proj"
        ;;
      enable)
        _pp_set_user_env_var PP_MEMORY_ENABLE 1 || exit 1
        printf 'memory: enabled (takes effect next cycle within 5min)\n'
        ;;
      disable)
        _pp_set_user_env_var PP_MEMORY_ENABLE 0 || exit 1
        printf 'memory: disabled (takes effect next cycle within 5min)\n'
        ;;
      help|-h|--help|"")
        cat <<HELP
polymath memory — Pair Polymath memory subsystem

Usage:
  polymath memory status          Show DB path, row count, size, top-5 by activation
  polymath memory recompute       Trigger activation_score recompute (under lock)
  polymath memory evict           Trigger eviction sweep (LLM summary required)
  polymath memory patterns        Show last 10 extracted patterns
  polymath memory clear --yes     Wipe all memory for the current project
  polymath memory enable          Set PP_MEMORY_ENABLE=1 in user.env
  polymath memory disable         Set PP_MEMORY_ENABLE=0 in user.env

Override the active project by exporting PP_MEMORY_CLI_CWD before the call.
HELP
        ;;
      *)
        printf 'polymath memory: unknown subcommand "%s". Try: polymath memory help\n' "$_pp_mem_sub" >&2
        exit 2
        ;;
    esac
    ;;

  auto-update)
    shift
    _sub="${1:-status}"; shift || true
    _interval="daily"
    _hhmm="03:17"   # 03:17 default — jitter off the round-number herd
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --interval) _interval="${2:-daily}"; shift 2 ;;
        --time)     _hhmm="${2:-03:17}"; shift 2 ;;
        *) printf 'polymath auto-update: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done
    case "$_interval" in
      daily|weekly) ;;
      *) printf 'polymath auto-update: --interval must be daily|weekly (got %s)\n' "$_interval" >&2; exit 2 ;;
    esac
    case "$_hhmm" in
      [0-9][0-9]:[0-9][0-9]) ;;
      *) printf 'polymath auto-update: --time must be HH:MM (got %s)\n' "$_hhmm" >&2; exit 2 ;;
    esac
    _hh="${_hhmm%:*}"; _mm="${_hhmm#*:}"
    # Strip a leading zero so arithmetic doesn't interpret 08/09 as octal,
    # then range-check. Doing it after the format check keeps the error
    # messages specific (format vs range).
    _hh_n="${_hh#0}"; _hh_n="${_hh_n:-0}"
    _mm_n="${_mm#0}"; _mm_n="${_mm_n:-0}"
    if [ "$_hh_n" -lt 0 ] 2>/dev/null || [ "$_hh_n" -gt 23 ] 2>/dev/null || \
       [ "$_mm_n" -lt 0 ] 2>/dev/null || [ "$_mm_n" -gt 59 ] 2>/dev/null; then
      printf 'polymath auto-update: --time HH must be 00-23 and MM must be 00-59 (got %s)\n' "$_hhmm" >&2
      exit 2
    fi
    _worker="$PP_ROOT/bin/auto-update.sh"
    [ -x "$_worker" ] || chmod +x "$_worker" 2>/dev/null || true

    _macos_plist="$HOME/Library/LaunchAgents/com.pair-polymath.auto-update.plist"
    _macos_label="com.pair-polymath.auto-update"
    _systemd_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    _systemd_service="$_systemd_dir/pair-polymath-auto-update.service"
    _systemd_timer="$_systemd_dir/pair-polymath-auto-update.timer"
    _cron_marker="# pair-polymath auto-update"

    # Detect available scheduler. Prefer launchd on macOS, systemd --user on
    # Linux when present, cron as the portable fallback. PP_AUTO_UPDATE_BACKEND
    # forces a choice (for tests + unusual environments).
    _backend="${PP_AUTO_UPDATE_BACKEND:-}"
    if [ -z "$_backend" ]; then
      case "$(uname -s 2>/dev/null)" in
        Darwin) _backend="launchd" ;;
        Linux)
          if command -v systemctl >/dev/null 2>&1 && systemctl --user list-units >/dev/null 2>&1; then
            _backend="systemd"
          elif command -v crontab >/dev/null 2>&1; then
            _backend="cron"
          else
            _backend="none"
          fi
          ;;
        *) command -v crontab >/dev/null 2>&1 && _backend="cron" || _backend="none" ;;
      esac
    fi

    case "$_sub" in
      enable)
        if [ "$_interval" = "weekly" ] && [ "$_backend" = "launchd" ]; then
          # launchd StartCalendarInterval supports Weekday but the simplest
          # weekly pattern is Sunday. Document and continue.
          _wd="Weekday=0"
        else
          _wd=""
        fi
        case "$_backend" in
          launchd)
            mkdir -p "$(dirname "$_macos_plist")"
            cat >"$_macos_plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$_macos_label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$_worker</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>$_hh_n</integer>
    <key>Minute</key><integer>$_mm_n</integer>
$([ -n "$_wd" ] && printf '    <key>Weekday</key><integer>0</integer>\n')  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>${PP_HOME:-$HOME/.claude/pair-polymath}/logs/auto-update.stdout.log</string>
  <key>StandardErrorPath</key><string>${PP_HOME:-$HOME/.claude/pair-polymath}/logs/auto-update.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PP_ROOT</key><string>$PP_ROOT</string>
    <key>HOME</key><string>$HOME</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
PLIST
            # Idempotent reload: unload-then-load is the well-supported path
            # across macOS 10.10 → 15.x. launchctl bootstrap exists on newer
            # macOS but its error semantics are inconsistent across point
            # releases — load/unload behaves identically and is safe to retry.
            launchctl unload "$_macos_plist" >/dev/null 2>&1 || true
            if launchctl load "$_macos_plist" 2>/dev/null; then
              printf 'auto-update enabled (launchd, %s daily at %s).\n' "$_macos_label" "$_hhmm"
              printf '  Plist: %s\n' "$_macos_plist"
              printf '  Logs:  %s/logs/auto-update.log\n' "${PP_HOME:-$HOME/.claude/pair-polymath}"
            else
              printf 'polymath auto-update: launchctl load failed; check %s manually.\n' "$_macos_plist" >&2
              exit 2
            fi
            ;;
          systemd)
            mkdir -p "$_systemd_dir"
            cat >"$_systemd_service" <<SVC
[Unit]
Description=Pair Polymath auto-update worker

[Service]
Type=oneshot
Environment=PP_ROOT=$PP_ROOT
ExecStart=/bin/bash $_worker
SVC
            _oncal="*-*-* $_hh:$_mm:00"
            [ "$_interval" = "weekly" ] && _oncal="Sun *-*-* $_hh:$_mm:00"
            cat >"$_systemd_timer" <<TMR
[Unit]
Description=Pair Polymath auto-update timer ($_interval at $_hhmm)

[Timer]
OnCalendar=$_oncal
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
TMR
            systemctl --user daemon-reload >/dev/null 2>&1 || true
            if systemctl --user enable --now pair-polymath-auto-update.timer >/dev/null 2>&1; then
              printf 'auto-update enabled (systemd --user, %s at %s).\n' "$_interval" "$_hhmm"
              printf '  Service: %s\n' "$_systemd_service"
              printf '  Timer:   %s\n' "$_systemd_timer"
            else
              printf 'polymath auto-update: systemctl --user enable failed.\n' >&2
              printf '  Hint: user lingering may be required (sudo loginctl enable-linger $USER).\n' >&2
              exit 2
            fi
            ;;
          cron)
            _spec="$_mm $_hh * * *"
            [ "$_interval" = "weekly" ] && _spec="$_mm $_hh * * 0"
            _existing=$(crontab -l 2>/dev/null | grep -v -F "$_cron_marker" || true)
            if { printf '%s\n' "$_existing"; printf '%s /bin/bash %s %s\n' "$_spec" "$_worker" "$_cron_marker"; } | crontab - 2>/dev/null; then
              printf 'auto-update enabled (cron, %s at %s).\n  Worker: %s\n' "$_interval" "$_hhmm" "$_worker"
            else
              printf 'polymath auto-update: crontab write failed.\n' >&2
              exit 2
            fi
            ;;
          none)
            printf 'polymath auto-update: no scheduler found (launchd / systemd --user / crontab).\n' >&2
            printf '  Either install cron, or run `polymath update --yes` manually.\n' >&2
            exit 2
            ;;
          *)
            printf 'polymath auto-update: unknown backend %s\n' "$_backend" >&2; exit 2 ;;
        esac
        ;;

      disable)
        _removed=0
        if [ -f "$_macos_plist" ]; then
          launchctl unload "$_macos_plist" >/dev/null 2>&1 || true
          rm -f "$_macos_plist"
          _removed=$((_removed + 1))
          printf '  removed: %s\n' "$_macos_plist"
        fi
        if [ -f "$_systemd_timer" ] || [ -f "$_systemd_service" ]; then
          systemctl --user disable --now pair-polymath-auto-update.timer >/dev/null 2>&1 || true
          rm -f "$_systemd_timer" "$_systemd_service"
          systemctl --user daemon-reload >/dev/null 2>&1 || true
          _removed=$((_removed + 1))
          printf '  removed: pair-polymath-auto-update.{service,timer}\n'
        fi
        if command -v crontab >/dev/null 2>&1; then
          _existing=$(crontab -l 2>/dev/null || true)
          if printf '%s' "$_existing" | grep -qF "$_cron_marker"; then
            printf '%s\n' "$_existing" | grep -v -F "$_cron_marker" | crontab - 2>/dev/null || true
            _removed=$((_removed + 1))
            printf '  removed: cron entry (%s)\n' "$_cron_marker"
          fi
        fi
        if [ "$_removed" -eq 0 ]; then
          printf 'auto-update is already disabled.\n'
        else
          printf 'auto-update disabled.\n'
        fi
        ;;

      status)
        _state="disabled"
        _detail=""
        if [ -f "$_macos_plist" ]; then
          _state="enabled (launchd)"
          _detail="$_macos_plist"
        elif [ -f "$_systemd_timer" ]; then
          _state="enabled (systemd --user)"
          _detail="$_systemd_timer"
        elif command -v crontab >/dev/null 2>&1 && crontab -l 2>/dev/null | grep -qF "$_cron_marker"; then
          _state="enabled (cron)"
          _detail="$(crontab -l 2>/dev/null | grep -F "$_cron_marker")"
        fi
        printf 'polymath auto-update: %s\n' "$_state"
        [ -n "$_detail" ] && printf '  %s\n' "$_detail"
        _log="${PP_HOME:-$HOME/.claude/pair-polymath}/logs/auto-update.log"
        if [ -s "$_log" ]; then
          printf '  last run:\n'
          # Last summary line (OK/FAIL/SKIP) — body lines are 4-space indented
          # so a leading-non-space filter isolates the summary cleanly.
          tail -n 200 "$_log" | grep -E '^[0-9]' | tail -n 3 | sed 's/^/    /'
          printf '  full log: %s\n' "$_log"
        else
          printf '  no runs logged yet.\n'
        fi
        printf '  detected backend: %s\n' "$_backend"
        ;;

      help|-h|--help|"")
        cat <<EOF
polymath auto-update — Scheduled background pull + idempotent re-install.

Usage:
  polymath auto-update enable [--interval daily|weekly] [--time HH:MM]
                                Default: daily at 03:17 local. Picks
                                launchd (macOS) / systemd --user (Linux) /
                                cron (fallback) automatically.
  polymath auto-update disable  Remove the scheduled job (idempotent;
                                cleans up all backends if more than one
                                was wired by hand).
  polymath auto-update status   Show current state + last 3 run summaries.

Notes:
  - The worker calls \`polymath update --yes\` and logs to
    ~/.claude/pair-polymath/logs/auto-update.log. Failures do NOT disable
    the schedule — they show up in the log + 'status' output.
  - Override the backend with PP_AUTO_UPDATE_BACKEND={launchd|systemd|cron}.
  - Override the worker log location with PP_AUTO_UPDATE_LOG.
EOF
        ;;

      *)
        printf 'polymath auto-update: unknown subcommand "%s". Try: polymath auto-update help\n' "$_sub" >&2
        exit 2
        ;;
    esac
    ;;

  dim)
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/dim.sh" 2>/dev/null || { echo "polymath dim: lib/dim.sh missing" >&2; exit 2; }
    _dim_sub="${1:-status}"; shift || true
    # Project sha8 — defaults to current cwd's project identity (best-effort).
    _dim_sha8="${PP_DIM_PROJECT_SHA8:-default}"
    if [ "$_dim_sha8" = "default" ] && [ -r "$PP_ROOT/lib/project-identity.sh" ]; then
      # shellcheck disable=SC1091
      . "$PP_ROOT/lib/project-identity.sh" 2>/dev/null || true
      if type pp_project_root_sha8 >/dev/null 2>&1; then
        _dim_sha8=$(pp_project_root_sha8 2>/dev/null || echo "default")
      fi
    fi

    case "$_dim_sub" in
      status)
        _dim_json=0
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --json) _dim_json=1; shift ;;
            *) printf 'polymath dim status: unknown flag %s\n' "$1" >&2; exit 2 ;;
          esac
        done
        _dim_state=$(pp_dim_get_current_state "$_dim_sha8")
        _dim_enabled="${PP_DIM_ENABLE:-1}"
        _dim_active="${PP_DIM_ACTIVE:-0}"
        _dim_oar="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}/oar-labeled.jsonl"
        _dim_gate=$(pp_dim_evaluate_gate "$_dim_oar" "$_dim_sha8")
        if [ "$_dim_json" = "1" ]; then
          jq -nc \
            --arg state "$_dim_state" \
            --argjson enabled "$_dim_enabled" \
            --argjson active "$_dim_active" \
            --argjson gate "$_dim_gate" \
            --arg sha8 "$_dim_sha8" \
            '{state:$state, enabled:$enabled, active:$active, project_root_sha8:$sha8, gate_progress:{lenses_qualifying:$gate.lenses_qualifying, lenses_required:3, evaluated_at:$gate.evaluated_at}, per_lens:$gate.per_lens}'
        else
          printf 'DIM (Developer Insights Module)\n'
          printf '  state:           %s\n' "$_dim_state"
          printf '  enabled:         %s\n' "$_dim_enabled"
          printf '  active:          %s\n' "$_dim_active"
          printf '  project:         %s\n' "$_dim_sha8"
          printf '\n'
          printf 'Gate progress\n'
          printf '%s\n' "$_dim_gate" | jq -r '.per_lens[]? | "  \(.lens)\t\(.n) obs, acted=\(.s), lcb=\(.lcb), qualifies=\(.qualifies)"'
          printf '\n'
          printf 'Next actions\n'
          printf '  → polymath dim force-activate   (override gate, activate immediately)\n'
          printf '  → polymath dim disable          (halt monitoring)\n'
        fi
        ;;
      help|-h|--help|"")
        cat <<EOF
polymath dim — Developer Insights Module control plane.

Usage:
  polymath dim status [--json]
  polymath dim enable
  polymath dim disable
  polymath dim force-activate
  polymath dim force-disable

States: monitoring → gated → active → quarantine (auto-recovers to monitoring).
See docs/v0.5.3-dim-spec.md for the gate parameters and design rationale.
EOF
        ;;
      *)
        printf 'polymath dim: unknown subcommand "%s". Try: polymath dim help\n' "$_dim_sub" >&2
        exit 2
        ;;
    esac
    ;;

  help|-h|--help|"")
    cat <<EOF
polymath — Pair Polymath CLI

Usage:
  polymath status      Show today's calls, lens registry, config flags
  polymath doctor      Run health checks (--network for live OpenAI probe)
  polymath onboard     Guided activation setup (roles, lenses, cost, fun mode)
  polymath enable      Enable the LLM lens cycle (set PP_EXTERNAL_LLM=1)
  polymath disable     Disable the LLM cycle / status-only mode (PP_EXTERNAL_LLM=0)
  polymath fun         Display-only session commentary (status / on / off / style)
  polymath logs        Tail recent lens observations (-n, --lens, --follow)
  polymath cost        Show estimated USD spend (--since, --by-lens, --json)
  polymath kpi         Rolling cost / retry / phase summary (--window Nd, --json)
  polymath history     OAR observation outcomes — per-lens acted% (--window, --lens, --outcome, --json)
  polymath oar         OAR bootstrap tools (bootstrap scan/report)
  polymath insights    Score advisory usefulness/noise (score --json)
  polymath oar-label   Manual catchup labeler (--all-due [--limit N])
  polymath retry-router   v0.5.1 cost-router state (status / shadow-summary / clear-flag)
  polymath lens-gates  v0.5.1.1 planner-grounding kill-switches (status / enable / disable)
  polymath prompts     Prompt contracts (list / show / lint)
  polymath memory      Memory subsystem (status / recompute / evict / patterns / clear / enable / disable)
  polymath dismiss     Suppression rules (add / list / show / disable / enable / ack)
  polymath update      Pull latest + re-run installer (--yes, --dry-run)
  polymath auto-update Scheduled background pull (enable / disable / status)
  polymath self-test   End-to-end LLM probe (~\$0.0001 per run)
  polymath version     Print version
  polymath help        This message
EOF
    ;;

  *)
    printf 'polymath: unknown command "%s". Try: polymath help\n' "$cmd" >&2
    exit 2
    ;;
esac
