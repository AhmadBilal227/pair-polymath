#!/usr/bin/env bash
# Pair Polymath CLI — lean v1: status + version subcommands only.
# v0.2 will add: doctor, cost, disable, enable, logs, update, self-test.

set -u

PP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PP_ROOT/lib/config.sh"
# shellcheck disable=SC1091
. "$PP_ROOT/lib/budget.sh"

# Detect GNU vs BSD stat ONCE, upfront (review fix F7').
# Round-1 F7 used a fallback chain `stat -f %m FILE || stat -c %Y FILE`. The
# problem: on GNU/Linux `stat -f %m FILE` does NOT fail — `-f` means
# "filesystem mode" and `%m` is the mount point string (e.g. `/`). That
# string then went to `date -r STRING` which GNU's `date -r FILE` happily
# accepts as a filename, yielding the MOUNT POINT'S mtime as every log
# entry's timestamp. Format-valid but value-wrong; tests that asserted only
# format passed. Explicit detection avoids the trap.
if stat --version 2>/dev/null | grep -qE 'GNU|coreutils'; then
  _PP_STAT_FLAVOR=gnu
else
  _PP_STAT_FLAVOR=bsd
fi

# _pp_set_user_env_var KEY VALUE
# Atomically set KEY=VALUE in $CLAUDE_DIR/pair-polymath/config/user.env,
# preserving every other line. Symlink-aware (writes through to the link
# target so dotfile-managed configs aren't replaced with regular files).
# Fails loudly on real grep / mkdir errors (review fixes H1+H2+M1+M2).
# Returns 0 on success, 1 on any error (with stderr message).
_pp_set_user_env_var() {
  local key="$1" value="$2"
  local user_env="${CLAUDE_DIR:-$HOME/.claude}/pair-polymath/config/user.env"
  local cfg_dir
  cfg_dir="$(dirname "$user_env")"

  # Fail loudly if we cannot create the config dir (review fix M2)
  if ! mkdir -p "$cfg_dir" 2>/dev/null; then
    printf 'polymath: cannot create config dir %s\n' "$cfg_dir" >&2
    return 1
  fi

  [ -f "$user_env" ] || : > "$user_env"

  # Create tmp in the SAME directory so the eventual mv stays atomic within
  # the same filesystem (review fix H2). Cross-FS mv is a copy + delete with
  # a race window.
  local tmp
  tmp=$(mktemp "${user_env}.XXXXXX") || {
    printf 'polymath: mktemp failed\n' >&2
    return 1
  }

  # Strip any existing KEY=... line. grep exit semantics with `-v`:
  #   0 = at least one line did NOT match (kept) → normal
  #   1 = no lines did NOT match (file empty after filter) → also normal
  #   2+ = real read error → must not proceed (review fix H1: previously we
  #        would silently truncate user.env to just our new line)
  local grep_rc=0
  grep -v "^${key}=" "$user_env" > "$tmp" || grep_rc=$?
  case "$grep_rc" in
    0|1) ;;
    *)
      rm -f "$tmp"
      printf 'polymath: failed to read %s (grep exit %s); user.env left intact\n' "$user_env" "$grep_rc" >&2
      return 1
      ;;
  esac

  printf '%s=%s\n' "$key" "$value" >> "$tmp"

  # Symlink-preserving write: if user_env is a symlink (e.g. dotfile manager
  # mapped it elsewhere), write THROUGH the link to the real target.
  # Otherwise atomic rename within the same filesystem (review fix M1).
  if [ -L "$user_env" ]; then
    if ! cat "$tmp" > "$user_env"; then
      rm -f "$tmp"
      printf 'polymath: could not write through symlink %s\n' "$user_env" >&2
      return 1
    fi
    rm -f "$tmp"
  else
    if ! mv "$tmp" "$user_env"; then
      rm -f "$tmp"
      printf 'polymath: could not move tmp into place at %s\n' "$user_env" >&2
      return 1
    fi
  fi
  return 0
}

cmd="${1:-status}"

case "$cmd" in
  version|-v|--version)
    cat "$PP_ROOT/VERSION"
    ;;

  status)
    today_calls=$(budget_get)
    cap="${PP_MAX_DAILY_CALLS:-3500}"
    used_pct=0
    if [ "$cap" -gt 0 ]; then
      used_pct=$((today_calls * 100 / cap))
    fi

    printf '\n\033[1mPair Polymath status\033[0m\n'
    printf '  Plugin root:     %s\n' "$PP_ROOT"
    printf '  Version:         %s\n' "$(cat "$PP_ROOT/VERSION")"
    printf '  Today (%s)\n' "$(date +%Y-%m-%d)"
    printf '    Calls:         %s / %s (%s%%)\n' "$today_calls" "$cap" "$used_pct"

    # Lens registry summary
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/lens-loader.sh"
    if pp_load_lenses 2>/dev/null; then
      printf '  Lenses loaded:   %s\n' "$PP_LENS_COUNT"
      for i in $(seq 0 $((PP_LENS_COUNT - 1))); do
        printf '    [%s] %s\n' "$((i + 1))" "${PP_LENS_IDS[$i]}"
      done
    fi

    # Prompts present?
    prompt_count=$(find "$PP_ROOT/prompts" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    printf '  Prompts:         %s built-in\n' "$prompt_count"

    # Honor $CLAUDE_DIR like install/uninstall do (review fix L1)
    user_prompts=$(find "${CLAUDE_DIR:-$HOME/.claude}/pair-polymath/prompts" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    [ "$user_prompts" -gt 0 ] && printf '    +%s user overrides\n' "$user_prompts"

    # Feature flags
    printf '  External LLM:    %s\n' "${PP_EXTERNAL_LLM:-1}"
    printf '  Escalation:      %s\n' "${PP_ENABLE_ESCALATION:-1}"

    printf '\n'
    ;;

  doctor)
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/doctor.sh"
    pp_doctor_run "$@"
    ;;

  disable)
    _pp_set_user_env_var PP_EXTERNAL_LLM 0 || exit 1
    printf 'LLM cycle disabled. Status-only mode active; new cycles take effect within 5 min.\n'
    ;;

  enable)
    _pp_set_user_env_var PP_EXTERNAL_LLM 1 || exit 1
    printf 'LLM cycle enabled. New cycles take effect within 5 min.\n'
    ;;

  logs)
    shift
    _pp_logs_n=10
    _pp_logs_lens=""
    _pp_logs_follow=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -n)
          # Review fix F3: validate value EXISTS before shift, otherwise
          # `shift 2` on a 1-arg list returns non-zero, the loop re-matches
          # $1=-n on the next iteration, and we spin forever.
          [ -n "${2:-}" ] || { printf 'polymath logs: -n requires a value\n' >&2; exit 2; }
          _pp_logs_n="$2"
          shift 2
          ;;
        --lens)
          [ -n "${2:-}" ] || { printf 'polymath logs: --lens requires a value\n' >&2; exit 2; }
          _pp_logs_lens="$2"
          shift 2
          ;;
        --follow|-f) _pp_logs_follow=1; shift ;;
        -h|--help)
          cat <<HELP
polymath logs — tail recent lens observations

Usage:
  polymath logs                Last 10 observations across all lenses
  polymath logs -n 50          Last 50 observations
  polymath logs --lens ENGINEERING
                               Filter to one lens by id
  polymath logs --follow       Stream new observations as cycles complete

Observations live in \$CLAUDE_DIR/cache/cc-monitor-\$SESSION-\$LENS.txt
HELP
          exit 0
          ;;
        *) printf 'polymath logs: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # Cap -n to a sane upper bound
    case "$_pp_logs_n" in
      ''|*[!0-9]*) printf 'polymath logs: -n requires a positive integer\n' >&2; exit 2 ;;
    esac
    [ "$_pp_logs_n" -gt 200 ] && _pp_logs_n=200

    _pp_cache_dir="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}"
    [ -d "$_pp_cache_dir" ] || { printf 'polymath logs: cache dir does not exist (%s); no observations yet\n' "$_pp_cache_dir"; exit 0; }

    # Determine session_id
    _pp_logs_session="${PP_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
    if [ -z "$_pp_logs_session" ]; then
      # Review fix F1: previous `([^-]+)` truncated multi-dash session IDs
      # (e.g. `abc-def-ghi` extracted to just `abc`). Use a greedy `(.+)` with
      # the trailing lens-id anchor `[A-Za-z0-9_]+\.txt$` as the boundary so
      # the longest possible session-id matches up to the final dash.
      # Review fix F5: also skip -verdict/-streak sidecars when sniffing the
      # session — they share the same glob but have different content.
      # SC2010: ls + grep is the cleanest expression here; mtime ordering is
      # provided by `ls -t` and filenames are constrained (no embedded
      # newlines/spaces — we author them in this same script).
      # shellcheck disable=SC2010
      _pp_logs_session=$(ls -t "$_pp_cache_dir"/cc-monitor-*-*.txt 2>/dev/null \
        | grep -v -- '-verdict\.txt$' \
        | grep -v -- '-streak\.txt$' \
        | head -1 \
        | sed -nE 's@.*/cc-monitor-(.+)-[A-Za-z0-9_]+\.txt$@\1@p')
    fi
    if [ -z "$_pp_logs_session" ]; then
      printf 'polymath logs: no observations yet (run a session to produce them)\n'
      exit 0
    fi

    # Review fix F7' (round 3): explicit flavor-driven mtime resolution. The
    # round-1 fallback chain `stat -f %m FILE || stat -c %Y FILE` silently
    # produced WRONG values on GNU/Linux because `stat -f %m FILE` doesn't
    # fail there — `-f` means "filesystem mode" and `%m` returns the mount
    # point string, which GNU `date -r FILE` then happily treats as a
    # filename. _PP_STAT_FLAVOR is detected once upfront (top of file).
    _pp_logs_get_mtime() {
      local f="$1"
      local secs
      case "$_PP_STAT_FLAVOR" in
        gnu)
          secs=$(stat -c %Y "$f" 2>/dev/null) || { printf '?'; return; }
          date -d "@$secs" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '?'
          ;;
        bsd)
          secs=$(stat -f %m "$f" 2>/dev/null) || { printf '?'; return; }
          date -r "$secs" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '?'
          ;;
        *)
          printf '?'
          ;;
      esac
    }

    _pp_logs_print_one() {
      local file="$1"
      [ -s "$file" ] || return 0
      local lens_id
      # Review fix F2: previous `([A-Z_]+)` rejected lens IDs with digits or
      # lowercase (LENS1, engineering_v2). Broaden to [A-Za-z0-9_]+.
      # Round-3 G4: --lens filtering moved OUT of this function and into the
      # file-list build step, so head -n no longer drops lens-matching files.
      lens_id=$(printf '%s' "$file" | sed -nE 's@.*-([A-Za-z0-9_]+)\.txt$@\1@p')
      local raw
      raw=$(head -1 "$file" 2>/dev/null)
      [ -z "$raw" ] && return 0
      # Parse "HAT: hook|||body" — hook is before |||, body after
      local hook body
      hook="${raw%%|||*}"
      body="${raw#*|||}"
      # Timestamp from file mtime (portable BSD/GNU; review fix F7)
      local ts
      ts=$(_pp_logs_get_mtime "$file")
      printf '%s  %s\n  %s\n  %s\n' "$ts" "$lens_id" "$hook" "$body"
      # Verdict sidecar — print only if present and contains DROP
      local verdict_file="${file%.txt}-verdict.txt"
      if [ -f "$verdict_file" ]; then
        local v
        v=$(head -1 "$verdict_file")
        case "$v" in
          *DROP*) printf '  [DROP: %s]\n' "$v" ;;
        esac
      fi
      printf '\n'
    }

    if [ "$_pp_logs_follow" = "1" ]; then
      # Review fix G3 (round 3): --follow was previously tailing the newest
      # single cache file regardless of --lens, diverging from non-follow
      # mode's filter behavior. When --lens is set, tail ONLY that lens's
      # specific cache file. Refuse gracefully if no file yet exists.
      if [ -n "$_pp_logs_lens" ]; then
        target="$_pp_cache_dir/cc-monitor-$_pp_logs_session-$_pp_logs_lens.txt"
        if [ ! -f "$target" ]; then
          printf 'polymath logs --follow: no cache file yet for lens %s (session %s)\n' \
            "$_pp_logs_lens" "$_pp_logs_session"
          exit 0
        fi
        printf '--follow on lens %s (Ctrl-C to exit)\n\n' "$_pp_logs_lens"
        tail -F "$target" 2>/dev/null
        exit 0
      fi
      printf 'polymath logs --follow: waiting for new observations (Ctrl-C to exit)\n\n'
      # tail -F the most recent cc-monitor file for this session (newest only —
      # following all 7 simultaneously is more complex; v0.3 may improve).
      # Review fix F5: filter -verdict/-streak sidecars so tail -F doesn't
      # latch onto a verdict file (different format, not observations).
      # shellcheck disable=SC2010
      latest=$(ls -t "$_pp_cache_dir"/cc-monitor-"$_pp_logs_session"-*.txt 2>/dev/null \
        | grep -v -- '-verdict\.txt$' \
        | grep -v -- '-streak\.txt$' \
        | head -1)
      [ -z "$latest" ] && { printf 'no observations yet for session %s\n' "$_pp_logs_session"; exit 0; }
      tail -F "$latest" 2>/dev/null
      exit 0
    fi

    # Default mode: collect candidate files, filter --lens FIRST, then head -n.
    # Review fix G4 (round 3): previously `head -n` ran BEFORE the --lens
    # filter, so `polymath logs --lens X -n N` could yield zero results if
    # X's cache files weren't among the newest N. Now filter then head.
    # Review fix F5: also strip -verdict.txt / -streak.txt sidecars — the
    # glob matches them but they have different content shape and would
    # render as garbled "observations".
    _pp_logs_tmp=$(mktemp)
    # shellcheck disable=SC2010
    ls -t "$_pp_cache_dir"/cc-monitor-"$_pp_logs_session"-*.txt 2>/dev/null \
      | grep -v -- '-verdict\.txt$' \
      | grep -v -- '-streak\.txt$' \
      > "$_pp_logs_tmp"

    # Pre-filter by --lens before applying head -n (G4).
    if [ -n "$_pp_logs_lens" ]; then
      _pp_logs_tmp2=$(mktemp)
      grep -F -- "-$_pp_logs_lens.txt" < "$_pp_logs_tmp" > "$_pp_logs_tmp2" || true
      mv "$_pp_logs_tmp2" "$_pp_logs_tmp"
    fi

    # Now cap to -n.
    _pp_logs_tmp3=$(mktemp)
    head -n "$_pp_logs_n" < "$_pp_logs_tmp" > "$_pp_logs_tmp3"
    mv "$_pp_logs_tmp3" "$_pp_logs_tmp"

    if [ ! -s "$_pp_logs_tmp" ]; then
      if [ -n "$_pp_logs_lens" ]; then
        printf 'polymath logs: no observations for lens %s in session %s\n' \
          "$_pp_logs_lens" "$_pp_logs_session"
      else
        printf 'polymath logs: no observations for session %s yet\n' "$_pp_logs_session"
      fi
      rm -f "$_pp_logs_tmp"
      exit 0
    fi
    while IFS= read -r f; do
      _pp_logs_print_one "$f"
    done < "$_pp_logs_tmp"
    rm -f "$_pp_logs_tmp"
    ;;

  update)
    shift
    _pp_update_yes=0
    _pp_update_dry=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --yes|-y) _pp_update_yes=1; shift ;;
        --dry-run) _pp_update_dry=1; shift ;;
        -h|--help)
          cat <<HELP
polymath update — Pull latest + re-run installer (idempotent)

Usage:
  polymath update              Interactive: shows diff, asks confirm
  polymath update --yes        Non-interactive: pull + re-install if any new commits
  polymath update --dry-run    Show what would happen; make no changes

Refuses on local divergence (use 'git pull --rebase' manually if needed).
HELP
          exit 0
          ;;
        *) printf 'polymath update: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    if [ ! -d "$PP_ROOT/.git" ]; then
      printf 'polymath update: PP_ROOT (%s) is not a git checkout — manual update needed\n' "$PP_ROOT" >&2
      exit 1
    fi

    # Review fix F6: detect the upstream default branch instead of hardcoding
    # `main`. Forks / branch-tracking installs were silently broken.
    _pp_default_branch=$(git -C "$PP_ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
    _pp_default_branch="${_pp_default_branch:-main}"

    # Review fix F8: dry-run must NOT mutate `.git/` state. `git fetch` writes
    # FETCH_HEAD and updates remote-tracking refs, which breaks the "no
    # changes" contract. Use `git ls-remote` (read-only) instead.
    if [ "$_pp_update_dry" = "1" ]; then
      _pp_update_remote_head=$(git -C "$PP_ROOT" ls-remote --heads origin "$_pp_default_branch" 2>/dev/null | awk '{print $1}')
      if [ -z "$_pp_update_remote_head" ]; then
        printf '[dry-run] Could not query origin/%s (network? auth?). No changes made.\n' "$_pp_default_branch"
        exit 0
      fi
      _pp_update_local_head=$(git -C "$PP_ROOT" rev-parse HEAD 2>/dev/null)
      if [ "$_pp_update_remote_head" = "$_pp_update_local_head" ]; then
        printf '[dry-run] Already up to date.\n'
        exit 0
      fi
      printf '[dry-run] Would: git pull --ff-only origin %s && (re-run installer if not --yes)\n' "$_pp_default_branch"
      printf '[dry-run] origin/%s HEAD: %s\n[dry-run] local HEAD:        %s\n' \
        "$_pp_default_branch" "$_pp_update_remote_head" "$_pp_update_local_head"
      exit 0
    fi

    # Real path — fetch + diff + (maybe) prompt + pull + install
    printf 'Fetching from origin...\n'
    if ! git -C "$PP_ROOT" fetch origin --tags --quiet 2>&1; then
      printf 'polymath update: git fetch failed (network? auth?)\n' >&2
      exit 1
    fi

    _pp_update_new=$(git -C "$PP_ROOT" log --oneline "HEAD..origin/$_pp_default_branch" 2>/dev/null)
    if [ -z "$_pp_update_new" ]; then
      printf 'Already up to date.\n'
      exit 0
    fi

    printf '\nNew commits on origin/%s:\n' "$_pp_default_branch"
    printf '%s\n' "$_pp_update_new" | sed 's/^/  /'
    printf '\n'

    # Review fix F9: failed `read` (non-interactive stdin EOF) used to default
    # to "Y" via `${_pp_update_ans:-Y}`, silently proceeding with pull +
    # install. Detect non-TTY explicitly and refuse to proceed without --yes,
    # and treat a failed `read` as abort, not consent.
    if [ "$_pp_update_yes" != "1" ]; then
      if ! [ -t 0 ]; then
        printf 'polymath update: non-interactive stdin without --yes — refusing to proceed.\n' >&2
        printf 'Re-run with --yes (skips installer) or in an interactive shell.\n' >&2
        exit 1
      fi
      printf 'Pull and re-run installer? [Y/n] '
      if ! read -r _pp_update_ans; then
        printf '\npolymath update: read failed (EOF?); aborting.\n' >&2
        exit 1
      fi
      case "${_pp_update_ans:-Y}" in
        [Yy]*|"") ;;
        *) printf 'Aborted.\n'; exit 0 ;;
      esac
    fi

    if ! git -C "$PP_ROOT" pull --ff-only origin "$_pp_default_branch" 2>&1; then
      printf '\npolymath update: pull failed.\n' >&2
      printf 'Local branch may have diverged. Inspect with: cd %s && git status\n' "$PP_ROOT" >&2
      exit 1
    fi

    # Review fix F4: install.sh has multiple interactive `read` calls. Under
    # --yes (advertised as non-interactive) it would hang in CI / piped-stdin
    # contexts. Skip the installer in that mode and print clear guidance so
    # the user can re-run manually if dependencies actually changed.
    if [ "$_pp_update_yes" = "1" ]; then
      printf '\n[--yes] Pull complete. Skipping interactive installer re-run.\n'
      printf '[--yes] If new commits touched bin/install.sh, re-run manually:\n'
      printf '          bash %s/bin/install.sh\n' "$PP_ROOT"
    else
      printf '\nRe-running installer (idempotent — preserves your settings.json + user.env)...\n'
      bash "$PP_ROOT/bin/install.sh"
    fi
    ;;

  help|-h|--help|"")
    cat <<EOF
polymath — Pair Polymath CLI

Usage:
  polymath status      Show today's calls, lens registry, config flags
  polymath doctor      Run health checks (--network for live OpenAI probe)
  polymath enable      Enable the LLM lens cycle (set PP_EXTERNAL_LLM=1)
  polymath disable     Disable the LLM cycle / status-only mode (PP_EXTERNAL_LLM=0)
  polymath logs        Tail recent lens observations (-n, --lens, --follow)
  polymath update      Pull latest + re-run installer (--yes, --dry-run)
  polymath version     Print version
  polymath help        This message

v0.2 will add: cost, self-test
EOF
    ;;

  *)
    printf 'polymath: unknown command "%s". Try: polymath help\n' "$cmd" >&2
    exit 2
    ;;
esac
