#!/usr/bin/env bash
# Pair Polymath CLI — lean v1: status + version subcommands only.
# v0.2 will add: doctor, cost, disable, enable, logs, update, self-test.

set -u

PP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PP_ROOT/lib/config.sh"
# shellcheck disable=SC1091
. "$PP_ROOT/lib/budget.sh"

# _pp_set_user_env_var KEY VALUE
# Atomically set KEY=VALUE in $CLAUDE_DIR/pair-polymath/config/user.env,
# preserving every other line. Symlink-aware (writes through to the link
# target so dotfile-managed configs aren't replaced with regular files).
# Fails loudly on real grep / mkdir errors (review fixes H1+H2+M1+M2).
# Returns 0 on success, 1 on any error (with stderr message).
_pp_set_user_env_var() {
  local key="$1" value="$2"
  local user_env="${CLAUDE_DIR:-$HOME/.claude}/pair-polymath/config/user.env"
  local cfg_dir
  cfg_dir="$(dirname "$user_env")"

  # Fail loudly if we cannot create the config dir (review fix M2)
  if ! mkdir -p "$cfg_dir" 2>/dev/null; then
    printf 'polymath: cannot create config dir %s\n' "$cfg_dir" >&2
    return 1
  fi

  [ -f "$user_env" ] || : > "$user_env"

  # Create tmp in the SAME directory so the eventual mv stays atomic within
  # the same filesystem (review fix H2). Cross-FS mv is a copy + delete with
  # a race window.
  local tmp
  tmp=$(mktemp "${user_env}.XXXXXX") || {
    printf 'polymath: mktemp failed\n' >&2
    return 1
  }

  # Strip any existing KEY=... line. grep exit semantics with `-v`:
  #   0 = at least one line did NOT match (kept) → normal
  #   1 = no lines did NOT match (file empty after filter) → also normal
  #   2+ = real read error → must not proceed (review fix H1: previously we
  #        would silently truncate user.env to just our new line)
  local grep_rc=0
  grep -v "^${key}=" "$user_env" > "$tmp" || grep_rc=$?
  case "$grep_rc" in
    0|1) ;;
    *)
      rm -f "$tmp"
      printf 'polymath: failed to read %s (grep exit %s); user.env left intact\n' "$user_env" "$grep_rc" >&2
      return 1
      ;;
  esac

  printf '%s=%s\n' "$key" "$value" >> "$tmp"

  # Symlink-preserving write: if user_env is a symlink (e.g. dotfile manager
  # mapped it elsewhere), write THROUGH the link to the real target.
  # Otherwise atomic rename within the same filesystem (review fix M1).
  if [ -L "$user_env" ]; then
    if ! cat "$tmp" > "$user_env"; then
      rm -f "$tmp"
      printf 'polymath: could not write through symlink %s\n' "$user_env" >&2
      return 1
    fi
    rm -f "$tmp"
  else
    if ! mv "$tmp" "$user_env"; then
      rm -f "$tmp"
      printf 'polymath: could not move tmp into place at %s\n' "$user_env" >&2
      return 1
    fi
  fi
  return 0
}

cmd="${1:-status}"

case "$cmd" in
  version|-v|--version)
    cat "$PP_ROOT/VERSION"
    ;;

  status)
    today_calls=$(budget_get)
    cap="${PP_MAX_DAILY_CALLS:-3500}"
    used_pct=0
    if [ "$cap" -gt 0 ]; then
      used_pct=$((today_calls * 100 / cap))
    fi

    printf '\n\033[1mPair Polymath status\033[0m\n'
    printf '  Plugin root:     %s\n' "$PP_ROOT"
    printf '  Version:         %s\n' "$(cat "$PP_ROOT/VERSION")"
    printf '  Today (%s)\n' "$(date +%Y-%m-%d)"
    printf '    Calls:         %s / %s (%s%%)\n' "$today_calls" "$cap" "$used_pct"

    # Lens registry summary
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/lens-loader.sh"
    if pp_load_lenses 2>/dev/null; then
      printf '  Lenses loaded:   %s\n' "$PP_LENS_COUNT"
      for i in $(seq 0 $((PP_LENS_COUNT - 1))); do
        printf '    [%s] %s\n' "$((i + 1))" "${PP_LENS_IDS[$i]}"
      done
    fi

    # Prompts present?
    prompt_count=$(find "$PP_ROOT/prompts" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    printf '  Prompts:         %s built-in\n' "$prompt_count"

    # Honor $CLAUDE_DIR like install/uninstall do (review fix L1)
    user_prompts=$(find "${CLAUDE_DIR:-$HOME/.claude}/pair-polymath/prompts" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    [ "$user_prompts" -gt 0 ] && printf '    +%s user overrides\n' "$user_prompts"

    # Feature flags
    printf '  External LLM:    %s\n' "${PP_EXTERNAL_LLM:-1}"
    printf '  Escalation:      %s\n' "${PP_ENABLE_ESCALATION:-1}"

    printf '\n'
    ;;

  doctor)
    shift
    # shellcheck disable=SC1091
    . "$PP_ROOT/lib/doctor.sh"
    pp_doctor_run "$@"
    ;;

  disable)
    _pp_set_user_env_var PP_EXTERNAL_LLM 0 || exit 1
    printf 'LLM cycle disabled. Status-only mode active; new cycles take effect within 5 min.\n'
    ;;

  enable)
    _pp_set_user_env_var PP_EXTERNAL_LLM 1 || exit 1
    printf 'LLM cycle enabled. New cycles take effect within 5 min.\n'
    ;;

  logs)
    shift
    _pp_logs_n=10
    _pp_logs_lens=""
    _pp_logs_follow=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -n) _pp_logs_n="${2:-10}"; shift 2 ;;
        --lens) _pp_logs_lens="$2"; shift 2 ;;
        --follow|-f) _pp_logs_follow=1; shift ;;
        -h|--help)
          cat <<HELP
polymath logs — tail recent lens observations

Usage:
  polymath logs                Last 10 observations across all lenses
  polymath logs -n 50          Last 50 observations
  polymath logs --lens ENGINEERING
                               Filter to one lens by id
  polymath logs --follow       Stream new observations as cycles complete

Observations live in \$CLAUDE_DIR/cache/cc-monitor-\$SESSION-\$LENS.txt
HELP
          exit 0
          ;;
        *) printf 'polymath logs: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    # Cap -n to a sane upper bound
    case "$_pp_logs_n" in
      ''|*[!0-9]*) printf 'polymath logs: -n requires a positive integer\n' >&2; exit 2 ;;
    esac
    [ "$_pp_logs_n" -gt 200 ] && _pp_logs_n=200

    _pp_cache_dir="${PP_CACHE_DIR:-${CLAUDE_DIR:-$HOME/.claude}/cache}"
    [ -d "$_pp_cache_dir" ] || { printf 'polymath logs: cache dir does not exist (%s); no observations yet\n' "$_pp_cache_dir"; exit 0; }

    # Determine session_id
    _pp_logs_session="${PP_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
    if [ -z "$_pp_logs_session" ]; then
      _pp_logs_session=$(ls -t "$_pp_cache_dir"/cc-monitor-*-*.txt 2>/dev/null \
        | head -1 \
        | sed -nE 's@.*/cc-monitor-([^-]+)-.*\.txt$@\1@p')
    fi
    if [ -z "$_pp_logs_session" ]; then
      printf 'polymath logs: no observations yet (run a session to produce them)\n'
      exit 0
    fi

    _pp_logs_print_one() {
      local file="$1"
      [ -s "$file" ] || return 0
      local lens_id
      lens_id=$(printf '%s' "$file" | sed -nE 's@.*-([A-Z_]+)\.txt$@\1@p')
      [ -n "$_pp_logs_lens" ] && [ "$lens_id" != "$_pp_logs_lens" ] && return 0
      local raw
      raw=$(head -1 "$file" 2>/dev/null)
      [ -z "$raw" ] && return 0
      # Parse "HAT: hook|||body" — hook is before |||, body after
      local hook body
      hook="${raw%%|||*}"
      body="${raw#*|||}"
      # Timestamp from file mtime (portable: stat varies macOS vs Linux)
      local ts
      ts=$(date -r "$file" '+%Y-%m-%d %H:%M:%S' 2>/dev/null \
        || stat -c '%y' "$file" 2>/dev/null | cut -c1-19 \
        || echo '?')
      printf '%s  %s\n  %s\n  %s\n' "$ts" "$lens_id" "$hook" "$body"
      # Verdict sidecar — print only if present and contains DROP
      local verdict_file="${file%.txt}-verdict.txt"
      if [ -f "$verdict_file" ]; then
        local v
        v=$(head -1 "$verdict_file")
        case "$v" in
          *DROP*) printf '  [DROP: %s]\n' "$v" ;;
        esac
      fi
      printf '\n'
    }

    if [ "$_pp_logs_follow" = "1" ]; then
      printf 'polymath logs --follow: waiting for new observations (Ctrl-C to exit)\n\n'
      # tail -F the most recent cc-monitor file for this session (newest only —
      # following all 7 simultaneously is more complex; v0.3 may improve)
      latest=$(ls -t "$_pp_cache_dir"/cc-monitor-"$_pp_logs_session"-*.txt 2>/dev/null | head -1)
      [ -z "$latest" ] && { printf 'no observations yet for session %s\n' "$_pp_logs_session"; exit 0; }
      tail -F "$latest" 2>/dev/null
      exit 0
    fi

    # Default mode: collect, sort by mtime desc, print top N (filtered if --lens)
    _pp_logs_tmp=$(mktemp)
    ls -t "$_pp_cache_dir"/cc-monitor-"$_pp_logs_session"-*.txt 2>/dev/null | head -"$_pp_logs_n" > "$_pp_logs_tmp"
    if [ ! -s "$_pp_logs_tmp" ]; then
      printf 'polymath logs: no observations for session %s yet\n' "$_pp_logs_session"
      rm -f "$_pp_logs_tmp"
      exit 0
    fi
    while IFS= read -r f; do
      _pp_logs_print_one "$f"
    done < "$_pp_logs_tmp"
    rm -f "$_pp_logs_tmp"
    ;;

  update)
    shift
    _pp_update_yes=0
    _pp_update_dry=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --yes|-y) _pp_update_yes=1; shift ;;
        --dry-run) _pp_update_dry=1; shift ;;
        -h|--help)
          cat <<HELP
polymath update — Pull latest + re-run installer (idempotent)

Usage:
  polymath update              Interactive: shows diff, asks confirm
  polymath update --yes        Non-interactive: pull + re-install if any new commits
  polymath update --dry-run    Show what would happen; make no changes

Refuses on local divergence (use 'git pull --rebase' manually if needed).
HELP
          exit 0
          ;;
        *) printf 'polymath update: unknown flag %s\n' "$1" >&2; exit 2 ;;
      esac
    done

    if [ ! -d "$PP_ROOT/.git" ]; then
      printf 'polymath update: PP_ROOT (%s) is not a git checkout — manual update needed\n' "$PP_ROOT" >&2
      exit 1
    fi

    printf 'Fetching from origin...\n'
    if ! git -C "$PP_ROOT" fetch origin --tags --quiet 2>&1; then
      printf 'polymath update: git fetch failed (network? auth?)\n' >&2
      exit 1
    fi

    _pp_update_new=$(git -C "$PP_ROOT" log --oneline HEAD..origin/main 2>/dev/null)
    if [ -z "$_pp_update_new" ]; then
      printf 'Already up to date.\n'
      exit 0
    fi

    printf '\nNew commits on origin/main:\n'
    printf '%s\n' "$_pp_update_new" | sed 's/^/  /'
    printf '\n'

    if [ "$_pp_update_dry" = "1" ]; then
      printf '[dry-run] Would: git pull --ff-only && ./bin/install.sh\n'
      exit 0
    fi

    if [ "$_pp_update_yes" != "1" ]; then
      printf 'Pull and re-run installer? [Y/n] '
      read -r _pp_update_ans
      case "${_pp_update_ans:-Y}" in
        [Yy]*|"") ;;
        *) printf 'Aborted.\n'; exit 0 ;;
      esac
    fi

    if ! git -C "$PP_ROOT" pull --ff-only origin main 2>&1; then
      printf '\npolymath update: pull failed.\n' >&2
      printf 'Local branch may have diverged. Inspect with: cd %s && git status\n' "$PP_ROOT" >&2
      exit 1
    fi

    printf '\nRe-running installer (idempotent — preserves your settings.json + user.env)...\n'
    # --yes lands in P2.3; until then this is interactive
    bash "$PP_ROOT/bin/install.sh"
    ;;

  help|-h|--help|"")
    cat <<EOF
polymath — Pair Polymath CLI

Usage:
  polymath status      Show today's calls, lens registry, config flags
  polymath doctor      Run health checks (--network for live OpenAI probe)
  polymath enable      Enable the LLM lens cycle (set PP_EXTERNAL_LLM=1)
  polymath disable     Disable the LLM cycle / status-only mode (PP_EXTERNAL_LLM=0)
  polymath logs        Tail recent lens observations (-n, --lens, --follow)
  polymath update      Pull latest + re-run installer (--yes, --dry-run)
  polymath version     Print version
  polymath help        This message

v0.2 will add: cost, self-test
EOF
    ;;

  *)
    printf 'polymath: unknown command "%s". Try: polymath help\n' "$cmd" >&2
    exit 2
    ;;
esac
