# Pair Polymath — default configuration.
# To override, copy any of these to ~/.claude/pair-polymath/config/user.env.

# === Model selection (gpt-5 family) ===
PP_MODEL="gpt-5-mini"                 # default per-lens analyst
PP_MODEL_DEEP="gpt-5.5"               # escalation / rotating deep slot
PP_MODEL_CRITIQUE="gpt-5"             # self-critique pass

# === Timing ===
PP_PARALLEL_INTERVAL_S=300            # min seconds between full cycles (300 = 5 min)
PP_IDLE_THRESHOLD_S=1800              # >this many idle seconds → passive mode (no LLM calls)

# === Cost cap ===
PP_MAX_DAILY_CALLS=10000              # hard cap; worst-case 23 reserved per cycle.
                                       # Bumped from 3500 (v0.2 single-session default) to
                                       # 10000 in v0.4 — multi-session users were hitting the
                                       # cap mid-day. 3 concurrent sessions × ~30 calls/cycle ×
                                       # 12 cycles/hr ≈ 1080 calls/hr; 10000 ≈ 9h heavy use.

# === Budget pressure thresholds (v0.4.1) ===
# Drive the line-1 pip glyph (⚡ amber / ⚠ red), the line-2 idle fallback
# wording, and the `polymath doctor` "budget pressure" check. Both must be
# in [1, 100] with WARN < RED; misconfigurations are clamped to defaults
# and surfaced via a yellow doctor diagnostic.
#PP_BUDGET_WARN_PCT=80                # % USED at which amber pip appears
#PP_BUDGET_RED_PCT=95                 # % USED at which red pip + "paused" message appear

# === Paths (computed at runtime; do not override unless you know what you're doing) ===
# PP_CACHE_DIR defaults to ~/.claude/cache
# PP_STATE_DIR defaults to ~/.claude/pair-polymath

# === Feature flags ===
PP_EXTERNAL_LLM=1                     # set 0 to disable all LLM calls (status-only mode)
PP_ENABLE_ESCALATION=1                # set 0 to disable deep-investigation escalation

# === Secret-file denylist (containment helper) ===
# Files matching these patterns are rejected by pp_contain_path even when
# they're legitimately inside cwd, to prevent the LLM planner from picking
# secret-bearing files as grounding context. Three independent checks:
#   1. Basename glob (case-insensitive) — e.g. .env, *.pem, id_rsa*
#   2. Any path component matches a secret-DIRECTORY glob — e.g. secrets/,
#      .ssh/, .aws/. Catches secrets/config.json (innocuous basename).
#   3. The cwd itself: if the base directory's deepest component matches a
#      secret-dir pattern (e.g. you run polymath from inside ~/.ssh), every
#      file inside it is rejected.
# Defaults are conservative: common credential / private-key / token files
# and the directories that conventionally hold them. Full list is the source
# of truth in lib/grounding.sh.
#
# User-supplied glob patterns are lowercased before matching, so
# PP_SECRET_FILE_PATTERNS_EXTRA="*.PEM" matches "server.pem".
#
# To ADD file-basename patterns: set PP_SECRET_FILE_PATTERNS_EXTRA in user.env
# To REPLACE file defaults (escape hatch): set PP_SECRET_FILE_PATTERNS
# To ADD directory-name patterns: set PP_SECRET_DIR_PATTERNS_EXTRA
# To REPLACE directory defaults (escape hatch): set PP_SECRET_DIR_PATTERNS
# Setting either REPLACE var to '' (explicit empty) disables that check
# entirely — and ALSO ignores the matching _EXTRA, so empty-string is a
# true "off" switch (you can't accidentally leave one half on).
# Whitespace-only is treated as user error → defaults + stderr warning.
#PP_SECRET_FILE_PATTERNS_EXTRA="*.myorg-secret"
#PP_SECRET_DIR_PATTERNS_EXTRA="vault keystore"

# === USD telemetry overrides (P3.1) ===
# Used by lib/metrics.sh to estimate per-cycle USD spend from call counts.
# These are MAINTAINER-tunable — most users should not edit them. Defaults
# track public gpt-5 family pricing snapshots as of v0.2 ship time and will
# drift; copy any line into user.env to override.
#
# Lean v1 approach: each cycle is rolled up at end-of-cycle as
#   USD = sum_over_calls( (avg_tok_in/1M)*price_in + (avg_tok_out/1M)*price_out )
# v0.3 plans to replace the avg-token assumption with real per-call usage
# from `llm --usage`.
#
# Prices per 1M tokens (input | output):
#PP_PRICE_GPT_5_MINI_IN_PER_M="0.25"
#PP_PRICE_GPT_5_MINI_OUT_PER_M="2.00"
#PP_PRICE_GPT_5_IN_PER_M="1.25"
#PP_PRICE_GPT_5_OUT_PER_M="10.00"
#PP_PRICE_GPT_5_5_IN_PER_M="2.50"
#PP_PRICE_GPT_5_5_OUT_PER_M="15.00"
#
# Avg tokens per call type (in | out). Tune to match your actual prompt sizes
# if the default estimates diverge from real spend by >20%:
#PP_AVG_TOK_PLANNER_IN="800";    PP_AVG_TOK_PLANNER_OUT="50"
#PP_AVG_TOK_ANALYST_IN="2200";   PP_AVG_TOK_ANALYST_OUT="180"
#PP_AVG_TOK_CRITIQUE_IN="3500";  PP_AVG_TOK_CRITIQUE_OUT="500"
#PP_AVG_TOK_INV_IN="1500";       PP_AVG_TOK_INV_OUT="100"
#PP_AVG_TOK_RETRY_IN="2500";     PP_AVG_TOK_RETRY_OUT="180"

# === Prompt-template security boundary ===
# Names that custom prompt templates (in $HOME/.claude/pair-polymath/prompts/*.md
# or lens system_prompt_addition fields) are allowed to substitute. Anything
# outside this set renders empty + emits a "not in allowlist" warning to stderr.
# This is a SECURITY boundary — it prevents a user-contributed template from
# resolving arbitrary environment variables by name (e.g. ${OPENAI_API_KEY},
# ${HOME}, ${PATH}). To extend, append to the list rather than replacing it.
#PP_PROMPT_VAR_ALLOWLIST="lens_group lens_focus lens_hats relevance_directive grounded prev_observations recent_user_messages activity_tail file_contents git_status git_log git_diff_stat git_recent_files gh_prs gh_ci candidate_file inv_grep drop_reason rlens_group rlens_hats rlens_focus project_ctx recent_commits stories arxiv_titles cwd cwd_ls test_state recent_tools PP_LENS_COUNT"

# === Memory subsystem (Phase 2.3) ===
# Disabled by default until the eval gate passes (see docs/memory-architecture.md).
# When enabled, the statusline cycle retrieves top-K observations from a
# per-project SQLite store, injects them into the analyst prompt, then
# post-cycle tags reinforcement signals + (periodically) runs maintenance:
# activation recompute, eviction, pattern extraction. Maintenance is gated
# on a cycle counter (default once per hour at 5-min cycles).
# F9: parameter expansion ${VAR:-default} honors a parent-shell-exported
# PP_MEMORY_ENABLE (so `PP_MEMORY_ENABLE=1 polymath …` works for one-shot
# debugging). Bare `PP_MEMORY_ENABLE=0` would clobber the exported value
# when config/default.env is sourced. For persistent enable use
# `polymath memory enable` (writes to user.env).
PP_MEMORY_ENABLE="${PP_MEMORY_ENABLE:-0}"   # master toggle for the entire memory subsystem
#PP_MEMORY_DIR=                        # override storage root (default $CLAUDE_DIR/pair-polymath/memory)
PP_MEMORY_REDACT=1                     # apply secret-pattern redaction at store + inject time
PP_MEMORY_ACTIVATION_K=15              # top-K rows pulled per cycle
PP_MEMORY_INJECT_BODY_CHARS=240        # truncate each injected obs body to this many chars
PP_MEMORY_RETRIEVAL_ALPHA=1.0          # hybrid weight: activation + alpha * normalized_bm25
PP_MEMORY_DECAY_PER_DAY=0.5            # base-level decay (k * days_old in activation formula)
PP_MEMORY_MAX_BYTES=104857600          # eviction threshold = 100MB
PP_MEMORY_EVICT_BATCH_SIZE=50          # rows deleted per eviction sweep
PP_MEMORY_PATTERN_BATCH_SIZE=200       # recent obs fed to pattern extractor
PP_MEMORY_PATTERNS_MAX=1000            # cap on patterns.jsonl line count
PP_MEMORY_PATTERN_INJECT_K=5           # extracted patterns injected into MEMORY_BLOCK
PP_MEMORY_MAINTENANCE_EVERY_N=12       # cycles per maintenance run (12 * 5min = 1h)
#PP_MEMORY_LLM_BIN=                    # override LLM binary for patterns/eviction (testing)
#PP_MEMORY_LLM_MODEL=gpt-5-mini        # model for patterns/eviction summaries
#PP_MEMORY_LLM_TIMEOUT_S=60            # timeout for memory LLM calls
#PP_MEMORY_LOCK_TIMEOUT_S=30           # wait time for maintenance lock acquisition
#PP_MEMORY_LOCK_STALE_S=300            # stale-lock takeover threshold

# === Dismiss subsystem (v0.5 Phase 3) ===
# Auto-suppress fires when the SAME observation hash recurs across at least
# this many sessions within this window. Excluded from counting if a prior
# `polymath dismiss ack <hash-prefix>` was recorded.
#PP_DISMISS_AUTO_THRESHOLD=10
#PP_DISMISS_AUTO_WINDOW_DAYS=30
# Sliding TTL: each match extends auto-suppress rule's expiry by N days, up
# to a hard cap. At cap, rule promotes to auto_suppress_persisted (permanent
# until disabled).
#PP_DISMISS_TTL_EXTEND_DAYS=3
#PP_DISMISS_TTL_CAP_DAYS=30
# Rendered constraint-block byte cap before tail-truncation.
#PP_DISMISS_RENDERED_MAX_BYTES=2048

# === Retry model override ===
# By default the analyst retry uses the same model as the primary analyst
# ($PP_MODEL, gpt-5-mini). Set this to escalate retry to a stronger model on
# critique-flagged drops. Pairs with the R2 retry-feedback-injection — a
# stronger retry model produces measurably better recoveries when given the
# failed observation + drop reason as context.
#PP_RETRY_MODEL="gpt-5"
